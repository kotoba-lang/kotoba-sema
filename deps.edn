{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.reader {:mvn/version "1.5.2"}
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         :git/sha "86d88bd58299cf575e9dfa2ab4789a0baa166614"}
        io.github.kotoba-lang/kotoba-hir
        {:git/url "https://github.com/kotoba-lang/kotoba-hir.git"
         :git/sha "ac8e70514ee3c9b87ae71324e6e714447acc971c"}
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         ;; b021a0d1: the five collection primitives the friendly heads in
         ;; this repository had nothing to lower to -- `vector-take` and
         ;; `vector-f64-take` (the rear truncation `pop` needs; `vector-drop`
         ;; drops from the FRONT), `typed-list-nth` (the `[:list T]` accessor
         ;; `keys`/`vals` need, since their projection IS a list), and
         ;; `typed-map-keys` / `typed-map-vals`. Without this pin `peek`,
         ;; `pop`, `keys` and `vals` trap `:unknown-function` at execution
         ;; even though they are admitted.
         :git/sha "b021a0d179fb983e8ad7da702252cfa764cd2fc2"}}
 :aliases {:test
           {:extra-paths ["test"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1"
                          :git/sha "dfb30dd"}}
            :main-opts ["-m" "cognitect.test-runner"]}}}
