{:paths ["src" "resources"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         :git/sha "86d88bd58299cf575e9dfa2ab4789a0baa166614"}
        io.github.kotoba-lang/kotoba-hir
        {:git/url "https://github.com/kotoba-lang/kotoba-hir.git"
         :git/sha "ac8e70514ee3c9b87ae71324e6e714447acc971c"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         ;; b021a0d1: the five collection primitives the friendly heads in
         ;; this repository had nothing to lower to -- `vector-take` and
         ;; `vector-f64-take` (the rear truncation `pop` needs; `vector-drop`
         ;; drops from the FRONT), `typed-list-nth` (the `[:list T]` accessor
         ;; `keys`/`vals` need, since their projection IS a list), and
         ;; `typed-map-keys` / `typed-map-vals`. Without this pin `peek`,
         ;; `pop`, `keys` and `vals` trap `:unknown-function` at execution
         ;; even though they are admitted.
         ;; Advanced 2026-09-16, b021a0d1 -> 1863a8de (osaho main, forward only), to
         ;; the `arena-scope` head (its #90, superproject ADR-2609160044): the
         ;; interpreter this frontend's tests execute through must know the
         ;; head it admits. Carries osaho's string value bound 4096 -> 65536
         ;; (22789c7), which computed_constant_fold_test now measures.
         :git/sha "85ed11be624d72f1974dbff8a175941662b6a6d6"}}
 :aliases {:test
           {:extra-paths ["test"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1"
                          :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
            :main-opts ["-m" "cognitect.test-runner"]}}}
