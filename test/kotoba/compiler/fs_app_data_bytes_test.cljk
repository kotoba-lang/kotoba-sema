(ns kotoba.compiler.fs-app-data-bytes-test
  "`fs/app-data-bytes` is the `:bytes` payload of wire 35: the same wire and the
  same authority as `fs/app-data`, so a grant of one is a grant of the other.
  The compiler reads and publishes binary files (wasm, kexe, the loader), which
  are not UTF-8 and so cannot be a Kotoba string. And `(ex-info msg data cause)`
  keeps the cause as the data's `:cause` (another error is a document here)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.compiler.frontend :as frontend]))

(defn- kir-run [defs]
  (kir/execute (kir/lower (sema/analyze (str "(ns m.probe)\n" defs))) 'main [] {}))

(deftest the-bytes-capability-shares-the-wire-and-the-authority
  (is (= 35 (get frontend/capability-registry :fs/app-data)))
  (is (= 35 (get frontend/capability-registry :fs/app-data-bytes)))
  (is (= :fs/app-data (get frontend/capability-id->name 35))
      "the inverse names the primary capability, not its payload variant"))

(deftest a-bytes-read-and-write-are-named-operations
  (let [hir (sema/analyze
             "(ns m.probe {:kotoba/export [rd wr]})
(defn rd [path :string] :bytes (fs/app-data-bytes path))
(defn wr [request :bytes] :bytes (fs/app-data-bytes request))")]
    (is (some? hir))))

(deftest ex-info-keeps-its-cause
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [f]})
(defn inner [x :i64] :i64 (if (< x 0) (throw (ex-info \"inner\" {:x x})) x))
(defn f [x :i64] :i64
  (try (inner x) (catch e (throw (ex-info \"outer\" {:phase :outer} e)))))"))))

(deftest catch-default-is-an-untyped-catch
  ;; `(catch :default e ...)` is the dual-runtime spelling of a catch-all (the
  ;; ClojureScript form the .cljk sources already write); it must read as
  ;; `(catch e ...)`, not as the error TYPE `:default`.
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [f]})
(defn inner [x :i64] :i64 (if (< x 0) (throw (ex-info \"inner\" {:x x})) x))
(defn f [x :i64] :i64 (try (inner x) (catch :default e 0)))"))))

(deftest a-write-is-one-framed-bytes-request
  ;; nbb's host layer takes `(fs/app-data-bytes request content)`; the wire
  ;; carries ONE request, so the frame is the request text then the content.
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [w]})
(defn w [path :string data :bytes] :bytes
  (fs/app-data-bytes (str path \"WRITE_SEP\") data))"))))

(deftest a-statement-position-app-data-call-needs-no-result-context
  ;; Its result is fixed by its NAME (text / bytes), so a `do` statement and a
  ;; `try` body can make one.
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [f]})
(defn f [p :string] :string
  (do (fs/app-data (str p \"FSYNC_SEP\"))
      (fs/app-data-bytes (str p \"WRITE_SEP\") (bytes-empty))
      p))"))))

(deftest a-record-field-may-carry-bytes
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [k]})
(defrecord Entry [path :string data :bytes])
(defn k [e [:record :m.probe/Entry [[:path :string] [:data :bytes]]]] :bytes (:data e))"))))

(deftest a-record-field-read-inside-try-resolves-its-descriptor
  ;; The abort passes run before `rewrite-record-projections`; a descriptor-less
  ;; `(:k e)` in a try body used to reach them as a value in the type slot.
  (is (some? (sema/analyze
              "(ns m.probe {:kotoba/export [s]})
(defrecord Entry [path :string kind :i64])
(defn boom [x :i64] :i64 (if (< x 0) (throw (ex-info \"neg\" {:x x})) x))
(defn s [e [:record :m.probe/Entry [[:path :string] [:kind :i64]]]] :i64
  (try (boom (:kind e)) (catch :default err 0)))"))))

(deftest str-prints-an-integer-part-as-decimal-digits
  (is (= "a-7-b" (let [v (kir-run "(defn main [] :string (str \"a-\" 7 \"-b\"))")] v)))
  (is (= "n=4" (kir-run "(defn main [] :string (let [n 3] (str \"n=\" (+ n 1))))"))))

(deftest rem-truncates-and-mod-floors
  (is (= [1 -1 1 -1] (mapv #(#?(:clj long :cljs js/Number) (kir-run (str "(defn main [] :i64 " % ")")))
                           ["(rem 7 3)" "(rem -7 3)" "(rem 7 -3)" "(rem -7 -3)"])))
  (is (= [1 2 -2 -1] (mapv #(#?(:clj long :cljs js/Number) (kir-run (str "(defn main [] :i64 " % ")")))
                           ["(mod 7 3)" "(mod -7 3)" "(mod 7 -3)" "(mod -7 -3)"]))))

(deftest str-prints-a-loop-binding-that-started-as-an-integer
  (is (= "0,1,2," (kir-run "(defn main [] :string (loop [i 0 acc \"\"] (if (< i 3) (recur (inc i) (str acc i \",\")) acc)))"))))
