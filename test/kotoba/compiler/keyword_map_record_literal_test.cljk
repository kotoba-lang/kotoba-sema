(ns kotoba.compiler.keyword-map-record-literal-test
  "A keyword-keyed map literal whose values are not all i64 lowers to a
  closed record (adr-2609111900, the selfhost ceiling loop; compiler-side
  wall measured 2026-09-11 at amu a406845e: 10 of the compiler's own 210
  sources were refused `map literal with keyword keys carries i64 values`,
  every one an ordinary config literal such as
  `{:runtime :nbb :compiler \"amu\" :ok? true}`).

  CLASSIFICATION, written before the change: IMPLEMENTATION STATE. Nothing in
  the language authority says a keyword-keyed literal with mixed values must
  not exist -- `lang/surface-status.edn :map-literal` carried the refusal as
  `:disposition :implemented-partial` / `:keyword-keys :not-inferred`, and
  `lang/guest-grammar.edn`'s reason closed on what `map-get` was written
  against, not on a property. `lang/value-codec.edn` admits a heterogeneous
  `:map`. The record layer underneath already carried every one of these
  field types: measured on the KIR interpreter before writing a line,
  `(:compiler (record-new [:record :m/lit [[:compiler :string] [:ok? :bool]
  [:runtime :keyword]]] \"amu\" true :nbb))` runs to `\"amu\"`, and `:f64`,
  `:map` and `:document` fields construct and project the same way.

  THE LOWERING CHOSEN is (a), an anonymous closed record type read off the
  literal, because it keeps the field's STATIC type: `(:compiler m)`, `get`
  and `{:keys [..]}` destructuring already resolve against a record
  descriptor, exactly as a `defrecord` constructor's do. (b), promotion to a
  `:document`, was rejected by the same probe: `(:compiler (document
  {:compiler \"amu\" :ok? true}))` is refused `record-get without a type
  descriptor requires a record value; got :document`, `(get doc :compiler)`
  is refused `expected map, got document`, and `document-get` answers
  `[:option :document]` -- the field's type is erased, so a function reading a
  field would not type-check as the field's type.

  The type id is `:kotoba.map-literal/<keys joined by +>` -- a FIXED
  namespace, because the descriptor is the type (`record-equal` and
  `bounded-typed-value!` compare it whole) and the same literal shape must
  name the same type from every module.

  Pinned here:

  1. positives, run to a VALUE on the KIR interpreter, not merely admitted:
     a mixed literal, a field read by keyword accessor and by `get`, a
     nested literal (record in record; legacy pair map in record; vector in
     record), an f64 field, and an unspelled value taking `:i64`;
  2. the exact descriptor the literal lowers to, including the total order
     of its fields and the namespaced-key segment folding;
  3. the CID-stability control: an all-i64 keyword literal and an
     all-unknown keyword literal lower to `map-new`, character for
     character what they lowered to before (the typed-map suite pins the
     same on its own fixture);
  4. the refusals BY NAME: a nil value, a field count past the type-node
     budget (the same count a `defrecord` is refused at) and past
     `max-record-fields`, a mixed key kind, and nesting past the type depth
     limit."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            #?(:cljs [kotoba.kir.cljs-i64 :as i64])))

(defn- unit [result body]
  (str "(ns m.probe)\n(defn main [] " result " " body ")\n"))

(defn- run [result body]
  (kir/execute (kir/lower (sema/analyze (unit result body))) 'main [] {}))

(defn- run-i64 [body]
  (let [v (run ":i64" body)]
    #?(:clj (long v) :cljs (js/Number v))))

(defn- refusal [result body]
  (try (do (sema/analyze (unit result body)) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :code (:kotoba.error/code (ex-data e))})))

(defn- norm
  "Host-independent rendering; `pr-str` writes a `.kotoba` integer as `42n`
  under nbb."
  [form]
  (cond
    (map? form) (str "{" (apply str (map (fn [[k v]] (str (norm k) " " (norm v) " "))
                                         (sort-by (comp pr-str key) form))) "}")
    (vector? form) (str "[" (apply str (interpose " " (map norm form))) "]")
    (set? form) (str "#{" (apply str (interpose " " (sort (map norm form)))) "}")
    (seq? form) (str "(" (apply str (interpose " " (map norm form))) ")")
    (string? form) (pr-str form)
    (keyword? form) (str form)
    (symbol? form) (str form)
    (nil? form) "nil"
    (boolean? form) (str form)
    #?(:clj (integer? form) :cljs (or (number? form) (i64/bigint-value? form)))
    (str form)
    :else (pr-str form)))

(defn- lowered-body [result body]
  (norm (mapv :body (:functions (sema/analyze (unit result body))))))

(def ^:private config-literal "{:runtime :nbb :compiler \"amu\" :ok? true}")

;; --- 1. positives, run to a value -----------------------------------------

(deftest a-mixed-keyword-literal-is-admitted-and-its-fields-read-back
  (testing "a string field, by the keyword accessor"
    (is (= "amu" (run ":string" (str "(:compiler " config-literal ")")))))
  (testing "a keyword field compared, and a bool field branched on"
    (is (= 7 (run-i64 (str "(let [m " config-literal "]"
                           " (if (and (:ok? m) (= :nbb (:runtime m))) 7 8))")))))
  (testing "by get"
    (is (= "amu" (run ":string" (str "(get " config-literal " :compiler)")))))
  (testing "a function that takes the literal's type and reads a field type-checks"
    (is (= 3 (run-i64 (str "(let [m {:name \"abc\" :n 4}] (string-length (:name m)))"))))))

(deftest an-i64-field-among-mixed-values-is-still-an-i64
  (is (= 4 (run-i64 "(let [m {:runtime :nbb :n 3 :ok? true}] (+ (:n m) 1))")))
  (testing "a value that spells no type takes :i64, as :not-spelled :i64 always has"
    (is (= 4 (run-i64 "(let [m {:runtime :nbb :n (+ 1 2) :ok? true}] (+ (:n m) 1))")))))

(deftest nested-literals-lower-to-nested-records
  (testing "a record inside a record"
    (is (= "y" (run ":string" "(let [m {:a \"x\" :b {:c \"y\" :d 1}}] (:c (:b m)))"))))
  (testing "an all-i64 keyword literal inside a record stays the legacy pair map"
    (is (= 5 (run-i64 "(let [m {:a \"x\" :b {:c 5 :d 1}}] (get (:b m) :c 0))"))))
  (testing "a vector literal inside a record"
    (is (= 3 (run-i64 "(let [m {:a \"x\" :v [1 2 3]}] (count (:v m)))")))))

(deftest a-floating-value-is-a-record-field-not-an-ABI-refusal
  ;; The typed map's value slot has no floating encoding; a record field does.
  (is (= 1.5 (run ":f64" "(:x {:x 1.5 :s \"a\"})"))))

;; --- 2. the descriptor -------------------------------------------------------

(deftest the-literal-lowers-to-a-closed-record-with-fields-in-key-order
  (is (= (str "[(let [m (record-new [:record :kotoba.map-literal/compiler+ok?+runtime"
              " [[:compiler :string] [:ok? :bool] [:runtime :keyword]]]"
              " \"amu\" true :nbb)] 0)]")
         (lowered-body ":i64" (str "(let [m " config-literal "] 0)"))))
  (testing "a namespaced key folds its namespace into the id with a dot"
    (is (= (str "[(let [m (record-new [:record"
                " :kotoba.map-literal/capability.allowed?+containment.status"
                " [[:capability/allowed? :bool] [:containment/status :keyword]]]"
                " true :contained)] 0)]")
           (lowered-body ":i64" "(let [m {:containment/status :contained :capability/allowed? true}] 0)"))))
  (testing "the same shape from two literals is one type"
    (is (= 1 (run-i64 (str "(let [a {:s \"x\" :n 1} b {:n 2 :s \"y\"}]"
                           " (if (record-equal"
                           " [:record :kotoba.map-literal/n+s [[:n :i64] [:s :string]]]"
                           " a b) 0 1))"))))))

;; --- 3. the CID-stability control --------------------------------------------

(deftest an-all-i64-keyword-literal-lowers-to-exactly-what-it-lowered-to-before
  (is (= "[(map-get (map-new :a 1 :b 2) :b 0)]"
         (lowered-body ":i64" "(get {:b 2 :a 1} :b 0)")))
  (testing "and so does an all-unknown-valued one"
    (is (= "[(map-get (map-new :a (+ 1 1) :b (* 2 3)) :b 0)]"
           (lowered-body ":i64" "(get {:a (+ 1 1) :b (* 2 3)} :b 0)"))))
  (testing "and the empty literal"
    (is (= "[(map-get (map-new) :a 0)]"
           (lowered-body ":i64" "(get {} :a 0)")))))

;; --- 4. refusals by name -----------------------------------------------------

(deftest a-nil-value-is-refused-by-name
  ;; ADR 0353 floor :absence: nil makes the field an absent [:option T]; with
  ;; no record type in context nothing says T, and that is the refusal.
  (is (= {:message (str "map literal value at key :b is nil, which makes the "
                        "field an absent [:option T], and nothing here says T: "
                        "give the literal a record type from context (a "
                        "declared record result, or a record field) or write "
                        "(option-none-of [:option T])")
          :code :kotoba.error/map-literal-value}
         (refusal ":i64" "(:a {:a \"x\" :b nil})"))))

(deftest the-field-count-is-bounded-the-way-a-defrecord-is
  ;; The record descriptor is a value type and pays `max-type-nodes` (512):
  ;; 3 + 3F for F scalar fields. `max-record-fields` (32) is the tighter bound
  ;; now -- 99 nodes at 32 fields -- so the literal refuses by the field-limit's
  ;; own name before the node budget is reached. (Under the old 64-node bound
  ;; 20 fields admitted and 21 were refused by the node limit; ADR 0355 raised
  ;; the budget.)
  (let [literal (fn [n] (str "(:k0 {:a \"x\""
                             (apply str (map #(str " :k" % " " %) (range n)))
                             "})"))]
    (testing "32 fields admit"
      (is (= 0 (run-i64 (literal 31)))))
    (testing "more than max-record-fields is refused by name"
      (is (= {:message (str "map literal with keyword keys and a non-i64 value "
                            "lowers to a closed record and exceeds the record "
                            "field limit: 33 entries, at most 32")
              :code :kotoba.error/map-literal-value}
             (refusal ":i64" (literal 32)))))))

(deftest a-mixed-key-kind-is-refused-by-the-key-refusal
  (is (= {:message "map literal keys must all be one kind; this literal mixes i64 and keyword"
          :code :kotoba.error/map-literal-key}
         (refusal ":i64" "(:a {:a \"x\" 1 2})"))))

(deftest nesting-past-the-type-depth-limit-is-refused-by-name
  ;; `max-type-depth` is 64 (amu ADR 0355; 12 from 2026-09-24, 8 before). A
  ;; keyword-map record costs about five descriptor nodes per level, so a
  ;; 65-deep literal (~325 nodes) stays under the 512-node bound and is refused
  ;; by the depth limit's own name.
  (let [nest (fn [n] (str "(let [m " (apply str (repeat n "{:a \"x\" :b "))
                          "\"deep\"" (apply str (repeat n "}")) "] 1)"))]
    (is (= :kotoba.error/value-type-depth-limit
           (:code (refusal ":i64" (nest 65))))))
  ;; The depth bound itself, on a type thin enough to reach it: 64 admitted,
  ;; 65 refused by the depth limit's name.
  (let [thin (fn [n] (nth (iterate (fn [t] [:option t]) :i64) n))
        check #(try (do (#'kotoba.compiler.frontend/validate-value-type! (thin %)) :ok)
                    (catch #?(:clj Throwable :cljs :default) e
                      (:kotoba.error/code (ex-data e))))]
    (is (= :ok (check 64)))
    (is (= :kotoba.error/value-type-depth-limit (check 65)))))
