(ns kotoba.sema
  "Stable public entry points for Kotoba source semantic analysis."
  {:kotoba/export [analyze capability-id->name capability-registry forbidden-heads schema-identities max-bindings max-expression-nodes max-function-docstring-chars max-functions max-list-items max-namespace-capabilities max-namespace-docstring-chars read-forms source-operation-registry validate-schema-table!]}
  (:require [kotoba.compiler.frontend :as frontend]
            ;; the admission limits live in the frontend pass modules that read them;
            ;; the facade holds a snapshot, so a rebinding must reach the owner
            [kotoba.compiler.frontend.analyze :as fe-analyze]
            [kotoba.compiler.frontend.expand :as fe-expand]
            [kotoba.compiler.frontend.namespace-defs :as fe-namespace-defs]
            [kotoba.compiler.frontend.validate :as fe-validate]
            [kotoba.compiler.schema :as schema])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                 [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                        :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                        :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]})))

#?(:kotoba nil :default
(def read-forms
  "Read Kotoba source using the admitted reader profile."
  frontend/read-forms))

#?(:kotoba nil :default
(def validate-schema-table!
  "Validate a named schema table and return it."
  schema/validate-table!))

#?(:kotoba nil :default
(def schema-identities
  "Return stable nominal content identities for a schema table."
  schema/identities))

#?(:kotoba nil :default
(def capability-registry frontend/capability-registry))
#?(:kotoba nil :default
(def source-operation-registry frontend/source-operation-registry))
#?(:kotoba nil :default
(def capability-id->name frontend/capability-id->name))
#?(:kotoba nil :default
(def forbidden-heads frontend/forbidden-heads))
#?(:kotoba nil :default
(def max-functions frontend/max-functions))
#?(:kotoba nil :default
(def max-expression-nodes frontend/max-expression-nodes))
#?(:kotoba nil :default
(def max-lowered-nodes frontend/max-lowered-nodes))
#?(:kotoba nil :default
(def max-bindings frontend/max-bindings))
#?(:kotoba nil :default
(def max-list-items frontend/max-list-items))
#?(:kotoba nil :default
(def max-namespace-capabilities frontend/max-namespace-capabilities))
#?(:kotoba nil :default
(def max-namespace-docstring-chars frontend/max-namespace-docstring-chars))
#?(:kotoba nil :default
(def max-function-docstring-chars frontend/max-function-docstring-chars))
#?(:kotoba nil :default
(def kernel-region-report frontend/kernel-region-report))

#?(:kotoba nil :default
(def namespace-attr-map-keys
  "The namespace header's attr-map spelling: key -> the clause head it stands
  for (`{:kotoba/export [...]}` is `(:export [...])`). Public because the
  amu project linker parses the same header and must admit the same keys;
  see `namespace-attr-map->clauses`."
  frontend/namespace-attr-map-keys))

#?(:kotoba nil :default
(def namespace-attr-map->clauses
  "Rewrite a namespace ATTR-MAP into the clauses it stands for, refusing an
  unknown key by name and a key whose clause is also spelled explicitly
  (declared twice). `(namespace-attr-map->clauses attr-map explicit-clauses
  reject-fn)`; reject-fn takes (message data code). Values are NOT validated
  here -- the caller's clause loop is the one path that does."
  frontend/namespace-attr-map->clauses))

#?(:kotoba nil :default
(def kernel-operation-heads
  "Every kernel head this frontend admits as a builtin: the byte-indexed and
  element-indexed memory operations, the CARRIED slice family, and the
  privileged machine operations. A set of symbols.

  Public because kotoba-lang's `lang/guest-grammar.edn` `:admitted-builtins`
  claims to name exactly these, four repositories carry a byte copy of that
  file, and a consumer therefore has to be able to CHECK the claim rather than
  restate it as a number. amu's `guest-grammar-vendor-test` compares the
  grammar it reads against this set across its `deps.edn` pin; before this
  existed it pinned the count as a literal, which went stale one authority
  edit later and reported staleness as drift.

  A set rather than the three tables, because the tables' arities are this
  repository's business and a consumer that read them would be depending on
  the implementation -- which is what `kotoba.compiler.namespace-reachability`
  refuses, correctly."
  (into #{}
        (mapcat keys)
        [frontend/kernel-memory-operations
         frontend/slice-value-operations
         frontend/kernel-privileged-operations])))

#?(:kotoba nil :default
(defn- default-controls? []
  (= [max-functions max-expression-nodes max-lowered-nodes max-bindings
      max-list-items max-namespace-capabilities
      max-namespace-docstring-chars max-function-docstring-chars]
     [frontend/max-functions frontend/max-expression-nodes
      frontend/max-lowered-nodes frontend/max-bindings
      frontend/max-list-items frontend/max-namespace-capabilities
      frontend/max-namespace-docstring-chars
      frontend/max-function-docstring-chars])))

#?(:kotoba nil :default
(defn- analyze-with-controls [source opts]
  (if (default-controls?)
    (frontend/analyze source opts)
    ;; Rebinding is only entered when a caller explicitly overrides the public
    ;; facade controls (principally bounded tests). Normal concurrent analysis
    ;; stays on the direct, mutation-free path above.
    (with-redefs [fe-namespace-defs/max-functions max-functions
                  fe-validate/max-expression-nodes max-expression-nodes
                  fe-analyze/max-lowered-nodes max-lowered-nodes
                  fe-validate/max-bindings max-bindings
                  fe-validate/max-list-items max-list-items
                  fe-namespace-defs/max-namespace-capabilities max-namespace-capabilities
                  fe-namespace-defs/max-namespace-docstring-chars max-namespace-docstring-chars
                  fe-expand/max-function-docstring-chars max-function-docstring-chars]
      (frontend/analyze source opts)))))

#?(:kotoba nil :default
(def lint
  "Analyze Kotoba source as `analyze` does, then return a vector of non-fatal
  findings -- `:code`, `:severity :warning`, `:message`, `:span` when known --
  empty when there is nothing to say. A refusal propagates unchanged. The
  first finding is `:kotoba.lint/zero-multiply-sequencing`: a call sequenced
  as `(* 0 (call))`, kept for its effect with its value dropped."
  frontend/lint))

#?(:kotoba nil :default
(defn analyze
  "Analyze Kotoba source and return a validated HIR envelope. Public admission
  controls are authoritative when explicitly overridden."
  ([source] (analyze-with-controls source nil))
  ([source opts] (analyze-with-controls source opts))))


;; ---- the Kotoba reading: the facade as forwarding functions (a def may alias a constant, not a function), over the
;; frontend facade's Kotoba exports. The host's admission-control overrides (`with-redefs`) have no Kotoba reading: the
;; limits are the frontend's own. Not in this reading (no Kotoba export behind them yet): lint, kernel-region-report,
;; kernel-operation-heads, max-lowered-nodes, namespace-attr-map-keys, namespace-attr-map->clauses.
#?(:kotoba (defn read-forms [source :string] [:list [:ref :form/r]] (frontend/read-forms source)))
#?(:kotoba (defn analyze [source :string opts [:ref :form/r]] [:ref :ana/ir] (frontend/analyze source opts)))
#?(:kotoba (defn validate-schema-table! [table :document] :document (schema/validate-table! table)))
#?(:kotoba (defn schema-identities [table :document] :document (schema/identities table)))
#?(:kotoba (defn capability-registry [] [:ref :form/r] (frontend/capability-registry)))
#?(:kotoba (defn source-operation-registry [] [:ref :form/r] (frontend/source-operation-registry)))
#?(:kotoba (defn capability-id->name [] [:ref :form/r] (frontend/capability-id->name)))
#?(:kotoba (defn forbidden-heads [] [:ref :form/r] (frontend/forbidden-heads)))
#?(:kotoba (defn max-functions [] :i64 (frontend/max-functions)))
#?(:kotoba (defn max-expression-nodes [] :i64 (frontend/max-expression-nodes)))
#?(:kotoba (defn max-bindings [] :i64 (frontend/max-bindings)))
#?(:kotoba (defn max-list-items [] :i64 (frontend/max-list-items)))
#?(:kotoba (defn max-namespace-capabilities [] :i64 (frontend/max-namespace-capabilities)))
#?(:kotoba (defn max-namespace-docstring-chars [] :i64 (frontend/max-namespace-docstring-chars)))
#?(:kotoba (defn max-function-docstring-chars [] :i64 (frontend/max-function-docstring-chars)))
