(ns kotoba.compiler.frontend
  {:kotoba/export [analyze capability-id->name capability-registry forbidden-heads grammar-declared-heads internal-failure! max-bindings max-expression-nodes max-function-docstring-chars max-functions max-list-items max-namespace-capabilities max-namespace-docstring-chars max-parameters max-record-fields max-symbol-chars max-typed-set-items read-forms reserved-function-names source-operation-registry validate-expr]}
  (:require [kotoba.compiler.frontend.base :as base]
            [kotoba.compiler.frontend.kernel-region :as kernel-region]
            [kotoba.compiler.frontend.closure-types :as closure-types]
            [kotoba.compiler.frontend.expand :as expand]
            [kotoba.compiler.frontend.namespace-defs :as namespace-defs]
            [kotoba.compiler.frontend.validate :as validate]
            [kotoba.compiler.frontend.infer :as infer]
            [kotoba.compiler.frontend.record-projection :as record-projection]
            [kotoba.compiler.frontend.desugar :as desugar]
            [kotoba.compiler.frontend.row :as row]
            [kotoba.compiler.frontend.state-ability :as state-ability]
            [kotoba.compiler.frontend.analyze :as analyze])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]
                                 ;; `analyze`'s result (kotoba.compiler.frontend.analyze)
                                 :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]})))

;; Facade over the split modules (amu refactor split). Each name is re-exported as a value;
;; a ^:dynamic var is a SNAPSHOT here: rebind it through its owning module (see the split report).
#?(:kotoba nil :default (def ^:private first-truthy base/first-truthy))
#?(:kotoba nil :default (def ^:private load-catalog-forbidden namespace-defs/load-catalog-forbidden))
#?(:kotoba nil :default (def ^:private load-grammar-declared-heads namespace-defs/load-grammar-declared-heads))
#?(:kotoba (defn grammar-declared-heads [] [:ref :form/r] (namespace-defs/grammar-declared-heads))
   :default (def grammar-declared-heads namespace-defs/grammar-declared-heads))
#?(:kotoba (defn forbidden-heads [] [:ref :form/r] (namespace-defs/forbidden-heads))
   :default (def forbidden-heads namespace-defs/forbidden-heads))
#?(:kotoba nil :default (def ^:private capability-registry-cljs-fallback base/capability-registry-cljs-fallback))
