#?(:kotoba nil :default (def capability-catalog base/capability-catalog))
#?(:kotoba (defn capability-registry [] [:ref :form/r] (base/capability-registry))
   :default (def capability-registry base/capability-registry))
#?(:kotoba (defn source-operation-registry [] [:ref :form/r] (base/source-operation-registry))
   :default (def source-operation-registry base/source-operation-registry))
#?(:kotoba nil :default (def named-operation-default-results infer/named-operation-default-results))
#?(:kotoba (defn capability-id->name [] [:ref :form/r] (base/capability-id->name))
   :default (def capability-id->name base/capability-id->name))
