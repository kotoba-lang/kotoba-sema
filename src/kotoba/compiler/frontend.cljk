(ns kotoba.compiler.frontend
  {:kotoba/export [*abort-error-types* *abort-lexical-context* *abort-throw-types* *contextual-closure-result-type* *expected-callable-contract* *function-arities* *function-callable-result-contracts* *lambda-counter* *lexical-bindings* *lexical-callable-contracts* *lifting-lazy-thunk?* *local-option-types* *local-state-ids* *local-state-used* *local-types* *loop-counter* *loop-helper-names* *loop-helper-recorder* *loop-helper-shapes* *loop-known-types* *loop-result-type* *numeric-resolution-final* *pending-lambdas* *pending-loop-helpers* *pure-definition-names* *record-protocol-dispatch* *required-closure-dispatchers* *schemas* *synthetic-counter* *used-capability-keywords* *uses-apply?* *uses-lazy?* alloc-region-bytes alloc-region-maximum-pages analyze arithmetic bytes-operations canonical-list-operations canonical-typed-map-operations capability-catalog capability-id->name capability-registry collection-count-operations compact-graph-operations comparisons compiler-rejection? dataspace-assert-type dataspace-observe-type dataspace-request-type dataspace-result-type dataspace-retract-type decimal-operations definition-heads document-fixed-operations document-variadic-operations f32-operations f64-operations forbidden-heads generic-option-operations grammar-declared-heads heap-operations heterogeneous-vector-operations i32-operations i64-operations image-scratch-bytes image-symbol-operations internal-failure! interrupt-entry-prefix interrupt-entry-signature interrupt-entry-vector interrupt-entry-vector-limit kernel-base-argument-positions kernel-base-positions kernel-memory-operations kernel-privileged-operations kernel-region-report kgraph-operations lazy-sequence-operations lint list-operations logical-operations map-operations map-presence-operations map-projection-operations max-arity-clauses max-bindings max-desugar-expansions max-desugar-template-nodes max-desugar-template-parameters max-desugar-templates max-expression-nodes max-function-docstring-chars max-functions max-heterogeneous-vector-items max-list-items max-lowered-nodes max-match-arms max-match-pattern-keys max-namespace-capabilities max-namespace-docstring-chars max-parameters max-reader-depth max-record-fields max-symbol-chars max-type-depth max-type-nodes max-typed-map-entries max-typed-set-items max-variant-cases namespace-attr-map->clauses namespace-attr-map-keys namespace-refused-clauses parametric-result-operations predicate-operations protocol-declaration-heads pure-product-disallowed-heads read-forms record-operations region-operations reserved-function-names rodata-literal-content? rodata-literal-encodings rodata-literal-operations sequencing-operations set-operations slice-value-operations source-operation-registry string-operations typed-f64-vector-operations typed-map-operations typed-safe-value-operations typed-set-operations typed-vector-operations validate-expr value-types variant-operations vector-end-operations xml-operations]}
  (:require [kotoba.compiler.frontend.base :as base]
            [kotoba.compiler.frontend.kernel-region :as kernel-region]
            [kotoba.compiler.frontend.closure-types :as closure-types]
            [kotoba.compiler.frontend.expand :as expand]
