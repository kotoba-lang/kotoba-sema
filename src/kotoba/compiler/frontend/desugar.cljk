(ns kotoba.compiler.frontend.desugar
  "Module `desugar` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (287 forms, 5768 lines). Depends on: base, kernel-region, closure-types, expand, namespace-defs, validate, infer, record-projection."
  (:require [kotoba.lang.coll :as set]
            [kotoba.lang.text :as str]
            [kotoba.compiler.frontend-tables :as tables]
            [kotoba.kir.value :as value]
            #?@(:kotoba [[kotoba.form :as form]])
            [kotoba.compiler.frontend.base :refer [capability-registry capability-wire-id effect-capability-id first-truthy form-span if-parts refuse-reader-tagged-host-literal! reject! reject-operation-arity! synthetic try-clause-parts #?@(:kotoba [dr])]]
            [kotoba.compiler.frontend.kernel-region :refer [absence-marker? map-literal-key-order map-literal-record-type #?@(:kotoba [head-is? sym-is?])]]
            [kotoba.compiler.frontend.closure-types :refer [callable-clauses callable-type? canonical-closure-result-type canonical-list-type? canonical-typed-map-type? closure-result-type? generic-option-type? heterogeneous-vector-type? i64-parameter-types? invoke-dispatcher-name max-record-fields parametric-result-type? record-type? structured-type? typed-set-type? validate-value-type! variant-type? #?@(:kotoba [env-schemas kw-text])]]
            [kotoba.compiler.frontend.expand :refer [all-distinct? binding-symbols implicit-do-body kotoba-integer? max-parameters specialize-variadic-clause valid-name?]]
            [kotoba.compiler.frontend.namespace-defs :refer [internal-failure! #?@(:kotoba [] :default [typed-vector-operations])]]
            [kotoba.compiler.frontend.validate :refer [document-reader-f64-form? holds-symbol? max-list-items max-typed-map-entries quote-form? quoted-symbol-datum-kind reject-quoted-symbol-datum!]]
            [kotoba.compiler.frontend.infer :refer [record-field-type #?@(:kotoba [kw-head?])]]
            [kotoba.compiler.frontend.record-projection :refer [doc-nth-helper-name f32-literal-bits! match-has-marker]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]})))

;; forward references inside this module (the cut keeps the original form order)
(declare desugar-result-expr desugar-expr chain-temp desugar-cond-value desugar-bool-expr desugar-cond-rest absence-marker-form thread-form desugar-tail-expressions desugar-comparison-chain desugar-head str-part sequenced-body args-from some-thread-temp all-literal? desugar-or top-level-function-symbol? desugar-ordinary-call guess-document-form? document-head-target desugar-and desugar-thread desugar-as-thread desugar-some-thread desugar-cond desugar-condp desugar-cond-thread desugar-case desugar-binding-some desugar-binding-if desugar-typed-op desugar-list-arm desugar-item-ctor desugar-hetero-ctor desugar-typed-map-new desugar-record-ctor desugar-record-get desugar-record-assoc desugar-hetero-assoc desugar-variant-new desugar-match-variant desugar-variant-match desugar-match-result desugar-result-match-of desugar-option-match desugar-match-option desugar-throw desugar-try desugar-catch-arm desugar-vector-i64-arm desugar-vector-f64-arm desugar-xorshift32 desugar-assoc-arm desugar-select-keys-arm desugar-merge-arm desugar-named-op args-from-loop desugar-expected-value desugar-validate-error-type closed-vector-literal-type desugar-each-from ev-each-types all-keywords? note-used-capability desugar-do ^:dynamic *local-types* ^:dynamic *local-option-types* form-free-symbols desugar-list string-from-i64-helper-name map-literal-lowered-type desugar-expr*)


;; Dataspace v1 is a language-owned typed capability contract. These
;; descriptors intentionally match capability-kits/dataspace-v1.edn. Keeping
;; the source sugar here means HIR/KIR/backends only see ordinary closed
;; record/variant construction plus typed-cap-call; there is no second runtime
;; or authority path for coordination forms.
(def dataspace-assert-type
  [:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]])
(def dataspace-retract-type
  [:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]])
(def dataspace-observe-type
  [:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]])
(def dataspace-request-type
  [:variant :kotoba.dataspace/request
   [[:assert dataspace-assert-type]
    [:retract dataspace-retract-type]
    [:observe dataspace-observe-type]
    [:facet-enter :bool]
    [:facet-leave :i64]]])
(def dataspace-result-type
  [:variant :kotoba.dataspace/result
   [[:asserted [:record :kotoba.dataspace/asserted
                [[:count :i64] [:notices :document]]]]
    [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
    [:matches [:record :kotoba.dataspace/matches
               [[:bindings :document] [:notices :document]]]]
    [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
    [:error [:record :kotoba.dataspace/error
             [[:code :keyword] [:message :string]]]]]])

#?(:kotoba
   (defn env-result [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :result))
   :default nil)

#?(:kotoba
   (defn env-none? [env [:ref :fe/env]] :bool (record-get [:ref :fe/env] env :none))
   :default nil)

#?(:kotoba
   (defn env-arities [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :arities))
   :default nil)

#?(:kotoba
   (defn env-lexical [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :lexical))
   :default nil)

#?(:kotoba
   (defn env-types [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :types))
   :default nil)

#?(:kotoba
   (defn env-docfns [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :docfns))
   :default nil)

#?(:kotoba
   (defn env-loop-counter [env [:ref :fe/env]] :i64 (record-get [:ref :fe/env] env :loop-counter))
   :default nil)

#?(:kotoba
   (defn with-lexical [env [:ref :fe/env] s [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :lexical s))
   :default nil)

#?(:kotoba
   (defn with-loop-counter [env [:ref :fe/env] n :i64] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :loop-counter n))
   :default nil)

#?(:kotoba
   (defn with-result [env [:ref :fe/env] r [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :result r))
   :default nil)

#?(:kotoba
   (defn dr-env [r [:ref :fe/dr]] [:ref :fe/env] (record-get [:ref :fe/dr] r :env))
   :default nil)

#?(:kotoba
   (defn dr-form [r [:ref :fe/dr]] [:ref :form/r] (record-get [:ref :fe/dr] r :form))
   :default nil)

#?(:kotoba
   (defn drs [env [:ref :fe/env] fs [:list [:ref :form/r]]] [:ref :fe/drs]
     (record-new [:ref :fe/drs] env fs))
   :default nil)

#?(:kotoba
   (defn drs-env [r [:ref :fe/drs]] [:ref :fe/env] (record-get [:ref :fe/drs] r :env))
   :default nil)

#?(:kotoba
   (defn drs-forms [r [:ref :fe/drs]] [:list [:ref :form/r]] (record-get [:ref :fe/drs] r :forms))
   :default nil)

;; a refusal with a stable code (the host `reject!`'s :kotoba.error/code, spelled as its text)
#?(:kotoba
   (defn fe-reject [msg :string code :string form [:ref :form/r]] [:ref :fe/err]
     (record-new [:ref :fe/err] msg code form "subset"))
   :default nil)

;; `(when-not ok (reject! msg form code))` as an aborting function: bind it in a `let`
#?(:kotoba
   (defn require-k [ok :bool msg :string code :string form [:ref :form/r]] :i64
     (if ok 0 (throw (fe-reject msg code form))))
   :default nil)

;; the Kotoba route has not ported this shape yet: the differential counts these, it does not compare them
#?(:kotoba
   (defn fe-unported [what :string form [:ref :form/r]] [:ref :fe/err]
     (record-new [:ref :fe/err] (string-concat "unported desugar form: " what) "kotoba.fe/unported" form "desugar"))
   :default nil)

;; `(simple-symbol? f)`: a symbol with no namespace (the lone `/` is one)
#?(:kotoba
   (defn simple-symbol-form? [f [:ref :form/r]] :bool
     (and (form/is-symbol? f)
          (or (< (string-find-byte (form/symbol-value f) 47 0) 0)
              (string=? (form/symbol-value f) "/"))))
   :default nil)

#?(:kotoba
   (defn document-ctx? [t [:ref :form/r]] :bool
     (and (form/is-keyword? t) (string=? (kw-text t) ":document")))
   :default nil)

#?(:kotoba
   (defn argc [form [:ref :form/r]] :i64 (- (form/count-of form) 1))
   :default nil)

#?(:kotoba
   (defn arg [form [:ref :form/r] k :i64] [:ref :form/r] (form/nth-of form (+ k 1)))
   :default nil)

;; the constant tables the dispatch reads, parsed ONCE per env (a Kotoba table accessor re-reads its EDN on every call)
#?(:kotoba
   (defn put2 [acc [:list [:ref :form/r]] k [:ref :form/r] v [:ref :form/r]] [:list [:ref :form/r]]
     (form/append-form (form/append-form acc k) v))
   :default nil)

#?(:kotoba
   (defn env-table [env [:ref :fe/env] k :keyword] [:ref :form/r]
     (form/form-get (record-get [:ref :fe/env] env :tbl) (form/keyword-form k)))
   :default nil)

;; the form at index I of FORM: under RESULT-TYPE when it is the last form and there is one
#?(:kotoba
   (defn desugar-tail-one [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (if (and (not (form/is-nil? result-type)) (= i (- (form/count-of form) 1)))
       (desugar-result-expr env result-type (form/nth-of form i))
       (desugar-expr env (form/nth-of form i))))
   :default nil)

;; the chain from the remaining operands [j, n) of FORM, LEFT the bound temp of the previous operand
#?(:kotoba
   (defn comparison-chain-rest [env [:ref :fe/env] op [:ref :form/r] left [:ref :form/r] form [:ref :form/r] j :i64] [:ref :fe/dr]
     (let [remaining (- (form/count-of form) j)]
       (if (= remaining 0)
         (dr env (form/bool-form true))
         (let [right (chain-temp "cmp" remaining)
               a (desugar-expr env (form/nth-of form j))
               b (comparison-chain-rest (dr-env a) op right form (+ j 1))]
           (dr (dr-env b)
               (form/call2 "let" (form/vec2 right (dr-form a))
                           (form/call3 "if" (form/call2 (form/symbol-value op) left right)
                                       (dr-form b) (form/bool-form false))))))))
   :default nil)

;; CLAUSES are the forms of FORM from index I (test/result pairs)
#?(:kotoba
   (defn desugar-cond-lower [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (if (= n 0)
         (dr env (form/int-form 0))
         (let [test (form/nth-of form i)
               result (form/nth-of form (+ i 1))
               remaining (- n 2)]
           (if (form/eq test (form/keyword-form :else))
             (let [_ (require-k (= remaining 0) "cond :else clause must be last" "kotoba.error/subset-reject" form)]
               (desugar-cond-value env result))
             (let [t (desugar-bool-expr env test)
                   v (desugar-cond-value (dr-env t) result)
                   e (desugar-cond-rest (dr-env v) form (+ i 2) remaining)]
               (dr (dr-env e) (form/call3 "if" (dr-form t) (dr-form v) (dr-form e)))))))))
   :default nil)

;; what follows a cond clause: the remaining clauses, or the absence marker
#?(:kotoba
   (defn desugar-cond-rest [env [:ref :fe/env] form [:ref :form/r] i :i64 remaining :i64] [:ref :fe/dr]
     (if (> remaining 0)
       (desugar-cond-lower env form i)
       (dr env (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn desugar-cond-value [env [:ref :fe/env] x [:ref :form/r]] [:ref :fe/dr]
     (if (form/is-nil? x)
       (dr env (form/call1 "__kotoba_absent" (form/keyword-form :nil)))
       (desugar-expr env x)))
   :default nil)

;; reduce thread-form over the steps of FORM from index I
#?(:kotoba
   (defn thread-steps [value [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :form/r]
     (if (>= i (form/count-of form))
       value
       (thread-steps (thread-form value (form/nth-of form i) last?) form (+ i 1) last?)))
   :default nil)

#?(:kotoba
   (defn as-thread-steps [value [:ref :form/r] name [:ref :form/r] form [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of form))
       value
       (as-thread-steps (form/call2 "let" (form/vec2 name value) (form/nth-of form i)) name form (+ i 1))))
   :default nil)

;; VALUE is the already desugared accumulator; the test/step pairs of FORM start at index I
#?(:kotoba
   (defn cond-thread-steps [env [:ref :fe/env] value [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env value)
       (let [test (form/nth-of form i)
             step (form/nth-of form (+ i 1))
             _ (require-k (and (form/is-seq? step) (> (form/count-of step) 0) (form/is-symbol? (form/nth-of step 0)))
                          (string-concat (if last? "cond->>" "cond->") " update must be a non-empty call form")
                          "kotoba.error/subset-reject" step)
             t (synthetic env "cond-thread")
             tmp (dr-form t)
             threaded (thread-form tmp step last?)
             a (desugar-bool-expr (dr-env t) test)
             b (desugar-expr (dr-env a) threaded)]
         (cond-thread-steps (dr-env b)
                            (form/call2 "let" (form/vec2 tmp value)
                                        (form/call3 "if" (dr-form a) (dr-form b) tmp))
                            form (+ i 2) last?))))
   :default nil)

;; the pairs of FORM from index I (up to END, exclusive), folded from the last to the first over FALLBACK
#?(:kotoba
   (defn condp-fold [env [:ref :fe/env] predicate [:ref :form/r] tmp [:ref :form/r] form [:ref :form/r]
                      i :i64 end :i64 fallback [:ref :form/r]] [:ref :fe/dr]
     (if (< i end)
       (let [j (- end 2)
             test (form/nth-of form j)
             result (form/nth-of form (+ j 1))
             a (desugar-expr env test)
             c (desugar-bool-expr (dr-env a) (form/call2 (form/symbol-value predicate) (dr-form a) tmp))
             d (desugar-expr (dr-env c) result)]
         (condp-fold (dr-env d) predicate tmp form i j (form/call3 "if" (dr-form c) (dr-form d) fallback)))
       (dr env fallback)))
   :default nil)

#?(:kotoba
   (defn condp-default-form [form [:ref :form/r] default? :bool] [:ref :form/r]
     (if default?
       (form/nth-of form (- (form/count-of form) 1))
       (form/call2 "quot" (form/int-form 1) (form/int-form 0))))
   :default nil)

#?(:kotoba
   (defn condp-has-arrow? [form [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of form))
       false
       (if (form/eq (form/nth-of form i) (form/keyword-form :>>))
         true
         (condp-has-arrow? form (+ i 1)))))
   :default nil)

;; the forms of FORM from index I, each desugared, in order
#?(:kotoba
   (defn desugar-each [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of form i))]
         (desugar-each (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; (HEAD ,@forms)
#?(:kotoba
   (defn head-call [head [:ref :form/r] forms [:list [:ref :form/r]]] [:ref :form/r]
     (form/form-seq (form/cons-onto head forms)))
   :default nil)

;; (NAME (desugar arg))-shaped heads: the arity is checked first
#?(:kotoba
   (defn desugar-operand [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) msg "kotoba.error/subset-reject" form)]
       (desugar-expr env (arg form 0))))
   :default nil)

#?(:kotoba
   (defn desugar-if-branch [env [:ref :fe/env] ctx [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (cond
       (form/is-nil? x) (dr env (form/call1 "__kotoba_absent" (form/keyword-form :nil)))
       (not (form/is-nil? ctx)) (desugar-result-expr env ctx x)
       :else (desugar-expr env x)))
   :default nil)

#?(:kotoba
   (defn desugar-if [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form))
                        (string-concat "if requires test, then, else; got " (string-concat (string-from-i64 (argc form)) " arguments"))
                        "kotoba.error/if-arity" form)
           t (desugar-bool-expr env (arg form 0))
           a (desugar-if-branch (dr-env t) ctx (arg form 1))
           b (desugar-if-branch (dr-env a) ctx (arg form 2))]
       (dr (dr-env b) (form/call3 "if" (dr-form t) (dr-form a) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-do-arm [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "do requires at least one expression" "kotoba.error/do-empty" form)]
       (if (= 1 (argc form))
         (if (form/is-nil? ctx)
           (desugar-expr env (arg form 0))
           (desugar-result-expr env ctx (arg form 0)))
         (let [r (desugar-tail-expressions env ctx form 1 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "do") (drs-forms r)))))))
   :default nil)

;; (= a b) and the ordered comparisons: two operands stay a call, any other count is a chain
#?(:kotoba
   (defn desugar-binary-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 2 (argc form))
       (let [a (desugar-expr env (arg form 0))
             b (desugar-expr (dr-env a) (arg form 1))]
         (dr (dr-env b) (form/call2 (form/symbol-value op) (dr-form a) (dr-form b))))
       (desugar-comparison-chain env op form 1)))
   :default nil)

#?(:kotoba
   (defn desugar-not= [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 2 (argc form))
       (let [a (desugar-expr env (arg form 0))
             b (desugar-expr (dr-env a) (arg form 1))]
         (dr (dr-env b) (form/call3 "if" (form/call2 "=" (dr-form a) (dr-form b)) (form/bool-form false) (form/bool-form true))))
       (let [c (desugar-comparison-chain env (form/symbol-form "=") form 1)]
         (dr (dr-env c) (form/call3 "if" (dr-form c) (form/bool-form false) (form/bool-form true))))))
   :default nil)

#?(:kotoba
   (defn desugar-when-body [env [:ref :fe/env] form [:ref :form/r] single-only :bool] [:ref :fe/dr]
     ;; the body of when / when-not, forms from index 2: one form is itself, several a `do`, none 0 (when-not) or (do)
     (let [n (- (form/count-of form) 2)]
       (cond
         (= n 1) (desugar-expr env (form/nth-of form 2))
         (and (= n 0) (not single-only)) (dr env (form/int-form 0))
         :else (let [r (desugar-each env form 2 (form/no-forms))]
                 (dr (drs-env r) (head-call (form/symbol-form "do") (drs-forms r)))))))
   :default nil)

#?(:kotoba
   (defn desugar-when [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "when requires a test expression" "kotoba.error/subset-reject" form)
           then (desugar-when-body env form true)
           t (desugar-bool-expr (dr-env then) (arg form 0))]
       (dr (dr-env t) (form/call3 "if" (dr-form t) (dr-form then) (absence-marker-form (dr-env t))))))
   :default nil)

#?(:kotoba
   (defn desugar-when-not [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "when-not requires a test expression" "kotoba.error/subset-reject" form)
           then (desugar-when-body env form false)
           t (desugar-bool-expr (dr-env then) (arg form 0))]
       (dr (dr-env t) (form/call3 "if" (dr-form t) (absence-marker-form (dr-env t)) (dr-form then)))))
   :default nil)

#?(:kotoba
   (defn desugar-if-not-else [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 3 (argc form))
       (desugar-cond-value env (arg form 2))
       (dr env (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn desugar-if-not [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 3)) "if-not requires then and optional else expressions"
                        "kotoba.error/subset-reject" form)
           t (desugar-bool-expr env (arg form 0))
           e (desugar-if-not-else (dr-env t) form)
           th (desugar-cond-value (dr-env e) (arg form 1))]
       (dr (dr-env th) (form/call3 "if" (dr-form t) (dr-form e) (dr-form th)))))
   :default nil)

;; (NAME ,@(map desugar-expr args)) with an arity check; `(get ...)`-style heads keep the authored head
#?(:kotoba
   (defn desugar-keep-head [env [:ref :fe/env] form [:ref :form/r] ok :bool msg :string] [:ref :fe/dr]
     (let [_ (require-k ok msg "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/nth-of form 0) (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-some-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form))
                        (if (= 2 (argc form))
                          "some with two arguments is clojure.core/some (a predicate over a collection); in this language `some` is the option constructor and takes one i64 operand -- search with filter / first, or write the loop"
                          "some requires one i64 operand")
                        "kotoba.error/subset-reject" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/call1 "option-some" (dr-form a)))))
   :default nil)

;; (OUTER (desugar arg)) with the one-operand check
#?(:kotoba
   (defn desugar-wrap1 [env [:ref :fe/env] form [:ref :form/r] msg :string outer :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call1 outer (dr-form a)))))
   :default nil)

;; (OUTER (desugar arg) CONST) for zero? pos? neg? empty?
#?(:kotoba
   (defn desugar-against-zero [env [:ref :fe/env] form [:ref :form/r] msg :string outer :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call2 outer (dr-form a) (form/int-form 0)))))
   :default nil)

;; ((fn ...) args): bound to a synthetic callee and called by name; the contextual result type rides along
#?(:kotoba
   (defn desugar-beta [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [c (synthetic env "app_callee")
           callee (dr-form c)
           call (form/form-seq (form/cons-onto callee (form/rest-list form)))]
       (desugar-expr (with-result (dr-env c) ctx) (form/call2 "let" (form/vec2 callee (form/nth-of form 0)) call))))
   :default nil)

#?(:kotoba
   (defn desugar-wrap1-if [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call3 "if" (dr-form a) (form/bool-form false) (form/bool-form true)))))
   :default nil)

#?(:kotoba
   (defn desugar-second [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "second requires one operand")]
       (dr (dr-env a) (form/call1 "pair-first" (form/call1 "pair-second" (dr-form a))))))
   :default nil)

#?(:kotoba
   (defn desugar-cons [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "cons requires two operands" "kotoba.error/subset-reject" form)
           a (desugar-expr env (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))]
       (dr (dr-env b) (form/call2 "pair" (dr-form a) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-nil? [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "nil? requires one option operand")]
       (dr (dr-env a) (form/call1 "bool-not" (form/call1 "option-some?" (dr-form a))))))
   :default nil)

#?(:kotoba
   (defn desugar-call [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (if (= 0 (form/count-of form))
       (throw (fe-unported "empty list" form))
       (let [op (form/nth-of form 0)]
         (cond
           (form/is-keyword? op)
           (cond
             (= 2 (form/count-of form))
             (let [a (desugar-expr env (form/nth-of form 1))]
               (dr (dr-env a) (form/call2 "record-get" (dr-form a) op)))
             (= 3 (form/count-of form))
             (desugar-expr env (form/call3 "get" (form/nth-of form 1) op (form/nth-of form 2)))
             :else (throw (fe-unported "keyword head" form)))
           (form/is-seq? op) (desugar-beta env form ctx)
           (form/is-symbol? op) (desugar-head env op form ctx)
           :else (throw (fe-unported "operator" form))))))
   :default nil)

#?(:kotoba
   (defn unported-head? [env [:ref :fe/env] name :string] :bool
     (tables/table-has? (env-table env :unported) (form/symbol-form name)))
   :default nil)

;; `lexical-call-form?`: the head is a local bound by an enclosing let/fn and is not a non-shadowable special head
#?(:kotoba
   (defn lexical-call? [env [:ref :fe/env] op [:ref :form/r]] :bool
     (and (tables/table-has? (env-lexical env) op)
          (not (tables/table-has? (env-table env :non-shadowable) op))))
   :default nil)

;; whether SOURCE form F is a :document as far as desugaring can tell without types
#?(:kotoba
   (defn guess-document-src [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (or (sym-is? op "map") (sym-is? op "mapv") (sym-is? op "filter") (sym-is? op "filterv") (sym-is? op "remove"))
       (form/nth-of form 2)
       (form/nth-of form 1)))
   :default nil)

;; the parts of FORM from index I, each as a :string operand
#?(:kotoba
   (defn str-parts [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [p (str-part env (form/nth-of form i))]
         (str-parts (dr-env p) form (+ i 1) (form/append-form acc (dr-form p))))))
   :default nil)

#?(:kotoba
   (defn concat-parts [acc [:ref :form/r] parts [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count parts))
       acc
       (concat-parts (form/call2 "string-concat" acc (typed-list-nth [:list [:ref :form/r]] parts i)) parts (+ i 1))))
   :default nil)

#?(:kotoba
   (defn desugar-str [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "str requires at least one argument" "kotoba.error/subset-reject" form)]
       (if (= 1 (argc form))
         (desugar-expr env (arg form 0))
         (let [first-part (str-part env (arg form 0))
               rest-parts (str-parts (dr-env first-part) form 2 (form/no-forms))]
           (dr (drs-env rest-parts) (concat-parts (dr-form first-part) (drs-forms rest-parts) 0))))))
   :default nil)

#?(:kotoba
   (defn desugar-string-length [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "string-length requires one string" "kotoba.error/subset-reject" form)
           a (desugar-result-expr env (form/keyword-form :string) (arg form 0))]
       (dr (dr-env a) (form/call1 "string-byte-length" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn desugar-string-from-i64 [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "string-from-i64 requires one i64")]
       (dr (dr-env a) (form/call1 "__kotoba_string_from_i64" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn desugar-inc-dec [env [:ref :fe/env] form [:ref :form/r] msg :string op :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call2 op (dr-form a) (form/int-form 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-rem [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "rem requires two i64 operands" "kotoba.error/subset-reject" form)
           sa (synthetic env "rem_a")
           sb (synthetic (dr-env sa) "rem_b")
           a (desugar-expr (dr-env sb) (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))
           ta (dr-form sa)
           tb (dr-form sb)]
       (dr (dr-env b)
           (form/call2 "let" (form/vec4 ta (dr-form a) tb (dr-form b))
                       (form/call2 "-" ta (form/call2 "*" (form/call2 "quot" ta tb) tb))))))
   :default nil)

#?(:kotoba
   (defn desugar-mod [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "mod requires two i64 operands" "kotoba.error/subset-reject" form)
           sa (synthetic env "mod_a")
           sb (synthetic (dr-env sa) "mod_b")
           sr (synthetic (dr-env sb) "mod_r")
           a (desugar-expr (dr-env sr) (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))
           ta (dr-form sa)
           tb (dr-form sb)
           tr (dr-form sr)
           zero (form/int-form 0)
           rv (form/call2 "-" ta (form/call2 "*" (form/call2 "quot" ta tb) tb))]
       (dr (dr-env b)
           (form/call2 "let" (form/vec6 ta (dr-form a) tb (dr-form b) tr rv)
                       (form/call3 "if" (form/call2 "=" tr zero) tr
                                   (form/call3 "if" (form/call2 "<" tr zero)
                                               (form/call3 "if" (form/call2 "<" tb zero) tr (form/call2 "+" tr tb))
                                               (form/call3 "if" (form/call2 "<" tb zero) (form/call2 "+" tr tb) tr)))))))
   :default nil)

#?(:kotoba
   (defn desugar-assert [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "assert requires exactly one condition; messages are not supported"
                        "kotoba.error/subset-reject" form)
           a (desugar-bool-expr env (arg form 0))]
       (dr (dr-env a) (form/call3 "if" (dr-form a) (form/int-form 0) (form/call2 "quot" (form/int-form 1) (form/int-form 0))))))
   :default nil)

#?(:kotoba
   (defn desugar-bytes-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 0 (argc form)) "bytes currently constructs only the canonical empty value"
                        "kotoba.error/subset-reject" form)]
       (dr env (form/call0 "bytes-empty"))))
   :default nil)

;; symbol patterns only: a destructuring pattern is `destructure-binding`'s business (not ported yet)
#?(:kotoba
   (defn lower-let-bindings [env [:ref :fe/env] bindings [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of bindings))
       (drs env acc)
       (let [pattern (form/nth-of bindings i)
             _ (require-k (form/is-symbol? pattern) "unported desugar form: let destructuring" "kotoba.fe/unported" pattern)
             v (desugar-expr env (form/nth-of bindings (+ i 1)))
             env2 (with-lexical (dr-env v) (form/form-set (form/append-form (form/kids-of (env-lexical env)) pattern)))]
         (lower-let-bindings env2 bindings (+ i 2) (form/append-form (form/append-form acc pattern) (dr-form v))))))
   :default nil)

#?(:kotoba
   (defn desugar-let [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [bindings (arg form 0)]
       (if (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)))
         (let [saved (env-lexical env)
               lowered (lower-let-bindings env bindings 0 (form/no-forms))
               body (desugar-tail-expressions (drs-env lowered) ctx form 2 (form/no-forms))
               sb (sequenced-body (drs-forms body) form "let")]
           (dr (with-lexical (drs-env body) saved)
               (form/call2 "let" (form/form-vec (drs-forms lowered)) sb)))
         (let [r (desugar-each env form 2 (form/no-forms))]
           (dr (drs-env r) (form/form-seq (form/cons-onto (form/symbol-form "let") (form/cons-onto bindings (drs-forms r)))))))))
   :default nil)

#?(:kotoba
   (defn binding-if-else [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :form/r]
     (if when?
       (absence-marker-form env)
       (if (= 4 (form/count-of form))
         (form/nth-of form 3)
         (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn binding-if-then [form [:ref :form/r] when? :bool] [:ref :form/r]
     ;; bodies are the forms of FORM from index 2
     (if when?
       (if (= 1 (- (form/count-of form) 2))
         (form/nth-of form 2)
         (form/form-seq (form/cons-onto (form/symbol-form "do") (args-from form 2))))
       (form/nth-of form 2)))
   :default nil)

#?(:kotoba
   (defn some-thread-lower [env [:ref :fe/env] value-form [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (let [a (desugar-expr env value-form)]
         (dr (dr-env a) (form/call1 "__kotoba_some_last" (dr-form a))))
       (let [t (some-thread-temp env)
             tmp (dr-form t)
             threaded (thread-form (form/call1 "__kotoba_present" tmp) (form/nth-of form i) last?)
             a (desugar-expr (dr-env t) value-form)
             b (some-thread-lower (dr-env a) threaded form (+ i 1) last?)]
         (dr (dr-env b)
             (form/call2 "let" (form/vec2 tmp (dr-form a))
                         (form/call2 "__kotoba_some_bind" tmp (dr-form b)))))))
   :default nil)

;; the temp of one `some->` step: numbered by the loop counter when the analysis has one, else by the synthetic counter
#?(:kotoba
   (defn some-thread-temp [env [:ref :fe/env]] [:ref :fe/dr]
     (if (>= (env-loop-counter env) 0)
       (let [n (+ (env-loop-counter env) 1)]
         (dr (with-loop-counter env n) (form/symbol-form (string-concat "some-thread__" (string-from-i64 n)))))
       (synthetic env "some-thread")))
   :default nil)

#?(:kotoba
   (defn case-literal? [x [:ref :form/r]] :bool
     (or (form/is-int? x) (form/is-keyword? x) (form/is-bool? x) (form/is-string? x)))
   :default nil)

;; every constant of the clause groups (a list group contributes its members) is a literal
#?(:kotoba
   (defn case-constants-ok? [form [:ref :form/r] i :i64 end :i64] :bool
     (if (>= i end)
       true
       (let [g (form/nth-of form i)]
         (and (if (form/is-seq? g) (all-literal? (form/kids-of g) 0) (case-literal? g))
              (case-constants-ok? form (+ i 2) end)))))
   :default nil)

#?(:kotoba
   (defn all-literal? [kids [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count kids))
       true
       (and (case-literal? (typed-list-nth [:list [:ref :form/r]] kids i)) (all-literal? kids (+ i 1)))))
   :default nil)

;; the constants of the groups of FORM from index I to END (step 2), as one flat list
#?(:kotoba
   (defn case-constants [form [:ref :form/r] i :i64 end :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i end)
       acc
       (let [g (form/nth-of form i)]
         (case-constants form (+ i 2) end
                         (if (form/is-seq? g) (form/append-many acc (form/kids-of g)) (form/append-form acc g))))))
   :default nil)

;; the tests of one clause group: (= tmp X') for each member, desugared in order
#?(:kotoba
   (defn case-member-tests [env [:ref :fe/env] tmp [:ref :form/r] members [:list [:ref :form/r]] i :i64
                             acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count members))
       (drs env acc)
       (let [a (desugar-expr env (typed-list-nth [:list [:ref :form/r]] members i))]
         (case-member-tests (dr-env a) tmp members (+ i 1) (form/append-form acc (form/call2 "=" tmp (dr-form a)))))))
   :default nil)

#?(:kotoba
   (defn case-group-test [env [:ref :fe/env] tmp [:ref :form/r] group [:ref :form/r]] [:ref :fe/dr]
     (let [members (if (form/is-seq? group) (form/kids-of group) (form/one-form group))
           tests (case-member-tests env tmp members 0 (form/no-forms))]
       (if (= 1 (vector-count members))
         (dr (drs-env tests) (typed-list-nth [:list [:ref :form/r]] (drs-forms tests) 0))
         (desugar-or (drs-env tests) (form/form-seq (form/cons-onto (form/symbol-form "or") (drs-forms tests))) 1))))
   :default nil)

;; the pairs [i, end) of FORM folded from the last over FALLBACK
#?(:kotoba
   (defn case-fold [env [:ref :fe/env] tmp [:ref :form/r] form [:ref :form/r] i :i64 end :i64 fallback [:ref :form/r]] [:ref :fe/dr]
     (if (< i end)
       (let [j (- end 2)
             test (case-group-test env tmp (form/nth-of form j))
             r (desugar-expr (dr-env test) (form/nth-of form (+ j 1)))]
         (case-fold (dr-env r) tmp form i j (form/call3 "if" (dr-form test) (dr-form r) fallback)))
       (dr env fallback)))
   :default nil)

;; X under RTYPE when there is one (not nil), else as it stands
#?(:kotoba
   (defn desugar-under [env [:ref :fe/env] rtype [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (if (form/is-nil? rtype)
       (desugar-expr env x)
       (desugar-result-expr env rtype x)))
   :default nil)

;; (OP ,@args) with the args at the indexes in IDX desugared under RTYPE (idx a Form set; nil-form: none)
#?(:kotoba
   (defn desugar-indexed [env [:ref :fe/env] form [:ref :form/r] idx [:ref :form/r] rtype [:ref :form/r]
                           i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-under env (if (tables/table-has? idx (form/int-form (- i 1))) rtype (form/nil-form))
                              (form/nth-of form i))]
         (desugar-indexed (dr-env r) form idx rtype (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-indexed-call [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] idx [:ref :form/r] rtype [:ref :form/r]] [:ref :fe/dr]
     (let [r (desugar-indexed env form idx rtype 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default nil)

;; every argument under one result type
#?(:kotoba
   (defn desugar-all-under [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] rtype [:ref :form/r] i :i64
                             acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [r (desugar-result-expr env rtype (form/nth-of form i))]
         (desugar-all-under (dr-env r) op form rtype (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; document-map: the odd-indexed arguments (value positions) are :document
#?(:kotoba
   (defn desugar-document-map [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [r (desugar-under env (if (= 1 (rem (- i 1) 2)) (form/keyword-form :document) (form/nil-form))
                              (form/nth-of form i))]
         (desugar-document-map (dr-env r) op form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; contextual-vector-f64-argument-types: index -> expected type
#?(:kotoba
   (defn desugar-typed-indexed [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] expected [:ref :form/r] i :i64
                                 acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [want (form/form-get expected (form/int-form (- i 1)))
             r (desugar-under env want (form/nth-of form i))]
         (desugar-typed-indexed (dr-env r) op form expected (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; typed-vector-operations: first operand a :vector-i64
#?(:kotoba
   (defn desugar-typed-vector-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [arity (tables/table-get (env-table env :typed-vec) op)
           _ (require-k (= (form/int-value arity) (argc form))
                        (string-concat "typed vector operation arity mismatch: "
                          (string-concat (form/symbol-value op)
                            (string-concat " takes "
                              (string-concat (string-from-i64 (form/int-value arity))
                                (string-concat (if (= 1 (form/int-value arity)) " argument" " arguments")
                                  (string-concat "; got " (string-from-i64 (argc form))))))))
                        "kotoba.error/call-arity" form)]
       (desugar-indexed-call env op form (form/form-set (form/one-form (form/int-form 0))) (form/keyword-form :vector-i64))))
   :default nil)

;; a call whose operator is a symbol, in the order of the host's cond chain and then its `case op`
#?(:kotoba
   (defn desugar-head [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [name (form/symbol-value op)]
       (cond
         (lexical-call? env op) (throw (fe-unported "lexical call" form))
         (tables/table-has? (env-table env :string-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :string-idx) op) (form/keyword-form :string))
         (tables/table-has? (env-table env :document-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :document-idx) op) (form/keyword-form :document))
         (or (string=? name "document-vector") (string=? name "document-list") (string=? name "document-set"))
         (desugar-all-under env op form (form/keyword-form :document) 1 (form/no-forms))
         (string=? name "document-map") (desugar-document-map env op form 1 (form/no-forms))
         (tables/table-has? (env-table env :f64-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :f64-idx) op) (form/keyword-form :f64))
         (tables/table-has? (env-table env :f32-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :f32-idx) op) (form/keyword-form :f32))
         (tables/table-has? (env-table env :vec-f64) op)
         (desugar-typed-indexed env op form (tables/table-get (env-table env :vec-f64) op) 1 (form/no-forms))
         (string=? name "vector-f64-new") (desugar-all-under env op form (form/keyword-form :f64) 1 (form/no-forms))
         (tables/table-has? (env-table env :typed-vec) op) (desugar-typed-vector-op env op form)
         (and (or (string=? name "mapv") (string=? name "filterv") (string=? name "remove"))
              (top-level-function-symbol? env op))
         (desugar-ordinary-call env op form)
         (and (or (string=? name "map") (string=? name "mapv") (string=? name "filter") (string=? name "filterv") (string=? name "remove"))
              (= 2 (argc form))
              (not (tables/table-has? (env-lexical env) op))
              (guess-document-form? env (arg form 1)))
         (throw (fe-unported "document collection lowering" form))
         (and (tables/table-has? (env-table env :doc-heads) op)
              (not (tables/table-has? (env-lexical env) op))
              (not (top-level-function-symbol? env op))
              (> (argc form) 0)
              (guess-document-form? env (document-head-target op form)))
         (throw (fe-unported "document head lowering" form))
         (string=? name "if") (desugar-if env form ctx)
         (string=? name "do") (desugar-do-arm env form ctx)
         (string=? name "and") (desugar-and env form 1)
         (string=? name "or") (desugar-or env form 1)
         (string=? name "not") (desugar-wrap1-if env form "not requires one operand")
         (string=? name "not=") (desugar-not= env form)
         (string=? name "zero?") (desugar-against-zero env form "zero? requires one operand" "=")
         (string=? name "pos?") (desugar-against-zero env form "pos? requires one operand" ">")
         (string=? name "neg?") (desugar-against-zero env form "neg? requires one operand" "<")
         (string=? name "empty?") (desugar-against-zero env form "empty? requires one operand" "=")
         (string=? name "=") (desugar-binary-op env op form)
         (string=? name "<") (desugar-binary-op env op form)
         (string=? name ">") (desugar-binary-op env op form)
         (string=? name "<=") (desugar-binary-op env op form)
         (string=? name ">=") (desugar-binary-op env op form)
         (string=? name "->") (desugar-thread env form false)
         (string=? name "->>") (desugar-thread env form true)
         (string=? name "as->") (desugar-as-thread env form)
         (string=? name "some->") (desugar-some-thread env form false)
         (string=? name "some->>") (desugar-some-thread env form true)
         (string=? name "cond") (desugar-cond env form)
         (string=? name "condp") (desugar-condp env form)
         (string=? name "cond->") (desugar-cond-thread env form false)
         (string=? name "cond->>") (desugar-cond-thread env form true)
         (string=? name "assert") (desugar-assert env form)
         (string=? name "case") (desugar-case env form)
         (string=? name "if-some") (desugar-binding-some env form false)
         (string=? name "when-some") (desugar-binding-some env form true)
         (string=? name "if-let") (desugar-binding-if env form false)
         (string=? name "when-let") (desugar-binding-if env form true)
         (string=? name "if-not") (desugar-if-not env form)
         (string=? name "when-not") (desugar-when-not env form)
         (string=? name "when") (desugar-when env form)
         (string=? name "let") (desugar-let env form ctx)
         (string=? name "first") (desugar-wrap1 env form "first requires one operand" "pair-first")
         (string=? name "rest") (desugar-wrap1 env form "rest requires one operand" "pair-second")
         (string=? name "second") (desugar-second env form)
         (string=? name "cons") (desugar-cons env form)
         (string=? name "some") (desugar-some-arm env form)
         (string=? name "some?") (desugar-wrap1 env form "some? requires one option operand" "option-some?")
         (string=? name "nil?") (desugar-nil? env form)
         (string=? name "bytes") (desugar-bytes-arm env form)
         (string=? name "str") (desugar-str env form)
         (string=? name "string-length") (desugar-string-length env form)
         (string=? name "string-from-i64") (desugar-string-from-i64 env form)
         (string=? name "inc") (desugar-inc-dec env form "inc requires one i64" "+")
         (string=? name "dec") (desugar-inc-dec env form "dec requires one i64" "-")
         (string=? name "rem") (desugar-rem env form)
         (string=? name "mod") (desugar-mod env form)
         (string=? name "get")
         (desugar-keep-head env form (and (<= 2 (argc form)) (<= (argc form) 3))
                            "get requires a value, a key, and an optional default")
         (string=? name "contains?")
         (desugar-keep-head env form (= 2 (argc form)) "contains? requires a map and one key")
         (string=? name "dissoc")
         (desugar-keep-head env form (>= (argc form) 2) "dissoc requires a map and at least one key")
         (tables/table-has? (env-table env :typed-ops) op)
         (desugar-typed-op env op form (tables/table-get (env-table env :typed-ops) op))
         (string=? name "list") (desugar-list-arm env form ctx)
         (string=? name "typed-list-new") (desugar-item-ctor env form "typed-list-new" "typed-list-new requires a type descriptor" false)
         (string=? name "typed-set") (desugar-item-ctor env form "typed-set-new" "typed-set requires a type descriptor" true)
         (string=? name "typed-set-new") (desugar-item-ctor env form "typed-set-new" "typed-set-new requires a type descriptor" true)
         (string=? name "hetero-vector") (desugar-hetero-ctor env form "hetero-vector requires a type descriptor")
         (string=? name "hetero-vector-new") (desugar-hetero-ctor env form "hetero-vector-new requires a type descriptor")
         (string=? name "typed-map-new") (desugar-typed-map-new env form)
         (string=? name "record") (desugar-record-ctor env form "record requires a type descriptor")
         (string=? name "record-new") (desugar-record-ctor env form "record-new requires a type descriptor")
         (string=? name "record-get") (desugar-record-get env form)
         (string=? name "record-assoc") (desugar-record-assoc env form)
         (string=? name "hetero-vector-assoc") (desugar-hetero-assoc env form)
         (string=? name "variant-new") (desugar-variant-new env form)
         (string=? name "match-variant") (desugar-match-variant env form)
         (string=? name "variant-match") (desugar-variant-match env form)
         (string=? name "match-result") (desugar-match-result env form)
         (string=? name "result-match-of") (desugar-result-match-of env form)
         (string=? name "option-match") (desugar-option-match env form)
         (string=? name "match-option") (desugar-match-option env form)
         (string=? name "throw") (desugar-throw env form)
         (string=? name "try") (desugar-try env form)
         (string=? name "catch") (throw (desugar-catch-arm form))
         (string=? name "vector-i64") (desugar-vector-i64-arm env form)
         (string=? name "vector-f64") (desugar-vector-f64-arm env form)
         (string=? name "xorshift32") (desugar-xorshift32 env form)
         (string=? name "assoc") (desugar-assoc-arm env form)
         (string=? name "select-keys") (desugar-select-keys-arm env form)
         (string=? name "merge") (desugar-merge-arm env form)
         (unported-head? env name) (throw (fe-unported name form))
         (not (< (string-find-byte name 47 0) 0)) (desugar-named-op env op form)
         :else (desugar-ordinary-call env op form))))
   :default nil)

;; the forms of FORM from index I as a list
#?(:kotoba
   (defn args-from [form [:ref :form/r] i :i64] [:list [:ref :form/r]]
     (args-from-loop form i (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn args-from-loop [form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of form))
       acc
       (args-from-loop form (+ i 1) (form/append-form acc (form/nth-of form i)))))
   :default nil)

;; the component of the descriptor T a typed operation's operand is expected to have (nil-form when T is not that kind)
#?(:kotoba
   (defn component-type [k :string t [:ref :form/r]] [:ref :form/r]
     (cond
       (string=? k ":list-item") (if (canonical-list-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":set-item") (if (typed-set-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":key") (if (canonical-typed-map-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":val") (if (canonical-typed-map-type? t) (form/nth-of t 2) (form/nil-form))
       (string=? k ":ok") (if (parametric-result-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":err") (if (parametric-result-type? t) (form/nth-of t 2) (form/nil-form))
       (string=? k ":payload") (if (generic-option-type? t) (form/nth-of t 1) (form/nil-form))
       :else (form/nil-form)))
   :default nil)

;; one operand of a table-driven typed operation, by its kind
#?(:kotoba
   (defn typed-op-arg [env [:ref :fe/env] kind [:ref :form/r] t [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (let [k (kw-text kind)]
       (cond
         (string=? k ":raw") (dr env x)
         (string=? k ":ct") (dr env (canonical-closure-result-type env x))
         (string=? k ":expr") (desugar-expr env x)
         (string=? k ":value") (desugar-expected-value env t x)
         :else (desugar-expected-value env (component-type k t) x))))
   :default nil)

;; operands [i, n) of FORM by the KINDS vector (index i-1), T the first operand
#?(:kotoba
   (defn typed-op-args [env [:ref :fe/env] kinds [:ref :form/r] t [:ref :form/r] form [:ref :form/r] i :i64
                         acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (typed-op-arg env (form/nth-of kinds (- i 1)) t (form/nth-of form i))]
         (typed-op-args (dr-env r) kinds t form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; SPEC is [arity message kinds]: one kind per operand (:raw verbatim, :ct canonical type, :expr plain, :value expected
;; under the first operand, or a component kind). The head is OP.
#?(:kotoba
   (defn desugar-typed-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] spec [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= (form/int-value (form/nth-of spec 0)) (argc form)) (form/string-value (form/nth-of spec 1))
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           r (typed-op-args env (form/nth-of spec 2) t form 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default nil)

;; each operand from index I of FORM expected as ITEM-TYPE (nil-form: plain)
#?(:kotoba
   (defn ev-each [env [:ref :fe/env] item-type [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env item-type (form/nth-of form i))]
         (ev-each (dr-env r) item-type form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; typed-list-new / typed-set / typed-set-new: (HEAD type item ...) items expected as the descriptor's item type
#?(:kotoba
   (defn desugar-item-ctor [env [:ref :fe/env] form [:ref :form/r] head :string msg :string set? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           t (arg form 0)
           item (if (if set? (typed-set-type? t) (canonical-list-type? t)) (form/nth-of t 1) (form/nil-form))
           r (ev-each env item form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form head) (form/cons-onto t (drs-forms r))))))
   :default nil)

;; each operand from index I expected as the matching item type of the Form vector TYPES (index i-2)
#?(:kotoba
   (defn ev-each-indexed [env [:ref :fe/env] types [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env (form/nth-of types (- i 2)) (form/nth-of form i))]
         (ev-each-indexed (dr-env r) types form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn ctor-tail [env [:ref :fe/env] types [:ref :form/r] form [:ref :form/r]] [:ref :fe/drs]
     (if (= (form/count-of types) (- (argc form) 1))
       (ev-each-indexed env types form 2 (form/no-forms))
       (desugar-each env form 2 (form/no-forms))))
   :default nil)

;; hetero-vector / hetero-vector-new
#?(:kotoba
   (defn desugar-hetero-ctor [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           t (arg form 0)
           types (if (heterogeneous-vector-type? t) (form/nth-of t 1) (form/form-vec (form/no-forms)))
           r (ctor-tail env types form)]
       (dr (drs-env r) (head-call (form/symbol-form "hetero-vector-new") (form/cons-onto t (drs-forms r))))))
   :default nil)

;; typed-map-new: (typed-map-new type key value ...) keys and values expected as the descriptor's
#?(:kotoba
   (defn map-pairs [env [:ref :fe/env] key-type [:ref :form/r] value-type [:ref :form/r] form [:ref :form/r] i :i64
                     acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= (+ i 1) (form/count-of form))
       (drs env acc)
       (let [k (desugar-expected-value env key-type (form/nth-of form i))
             v (desugar-expected-value (dr-env k) value-type (form/nth-of form (+ i 1)))]
         (map-pairs (dr-env v) key-type value-type form (+ i 2)
                    (form/append-form (form/append-form acc (dr-form k)) (dr-form v))))))
   :default nil)

#?(:kotoba
   (defn desugar-typed-map-new [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (> (argc form) 0) (= 1 (rem (argc form) 2))) "typed-map-new requires type and key/value pairs"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           ok? (canonical-typed-map-type? t)
           r (map-pairs env (if ok? (form/nth-of t 1) (form/nil-form)) (if ok? (form/nth-of t 2) (form/nil-form)) form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "typed-map-new") (form/cons-onto t (drs-forms r))))))
   :default nil)

;; record / record-new: field values expected as the declared field types
#?(:kotoba
   (defn record-field-type-at [fields [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form/count-of fields)))
       (form/nth-of (form/nth-of fields i) 1)
       (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn record-values [env [:ref :fe/env] ct [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [ft (if (record-type? ct) (record-field-type-at (form/nth-of ct 2) (- i 2)) (form/nil-form))
             r (desugar-expected-value env ft (form/nth-of form i))]
         (record-values (dr-env r) ct form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-record-ctor [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           ct (canonical-closure-result-type env (arg form 0))
           r (record-values env ct form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "record-new") (form/cons-onto ct (drs-forms r))))))
   :default nil)

#?(:kotoba
   (defn desugar-record-get [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (or (= 2 (argc form)) (= 3 (argc form))) "record-get requires (value field) or (type value field)"
                        "kotoba.error/subset-reject" form)]
       (if (= 2 (argc form))
         (let [a (desugar-expr env (arg form 0))]
           (dr (dr-env a) (form/call2 "record-get" (dr-form a) (arg form 1))))
         (let [ct (canonical-closure-result-type env (arg form 0))
               a (desugar-expected-value env ct (arg form 1))]
           (dr (dr-env a) (form/call3 "record-get" ct (dr-form a) (arg form 2)))))))
   :default nil)

;; the type of FIELD in the record descriptor CT's fields (nil-form when CT is not a record or has no such field)
#?(:kotoba
   (defn field-type-of [fields [:ref :form/r] field [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of fields))
       (form/nil-form)
       (if (form/eq (form/nth-of (form/nth-of fields i) 0) field)
         (form/nth-of (form/nth-of fields i) 1)
         (field-type-of fields field (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-record-assoc [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "record-assoc requires type, value, literal field, and replacement"
                        "kotoba.error/subset-reject" form)
           ct (canonical-closure-result-type env (arg form 0))
           ft (if (record-type? ct) (field-type-of (form/nth-of ct 2) (arg form 2) 0) (form/nil-form))
           a (desugar-expected-value env ct (arg form 1))
           b (desugar-expected-value (dr-env a) ft (arg form 3))]
       (dr (dr-env b) (form/call4 "record-assoc" ct (dr-form a) (arg form 2) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-hetero-assoc [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "hetero-vector-assoc requires type, value, literal index, and item"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           index (arg form 2)
           it (if (and (heterogeneous-vector-type? t) (form/is-int? index) (<= 0 (form/int-value index))
                       (< (form/int-value index) (form/count-of (form/nth-of t 1))))
                (form/nth-of (form/nth-of t 1) (form/int-value index))
                (form/nil-form))
           a (desugar-expected-value env t (arg form 1))
           b (desugar-expected-value (dr-env a) it (arg form 3))]
       (dr (dr-env b) (form/call4 "hetero-vector-assoc" t (dr-form a) index (dr-form b)))))
   :default nil)

;; the payload type of case TAG in the variant descriptor's cases vector
#?(:kotoba
   (defn variant-payload-type [cases [:ref :form/r] tag [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of cases))
       (form/nil-form)
       (if (form/eq (form/nth-of (form/nth-of cases i) 0) tag)
         (form/nth-of (form/nth-of cases i) 1)
         (variant-payload-type cases tag (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-variant-new [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form)) "variant-new requires type, case tag, and payload" "kotoba.error/subset-reject" form)
           t (arg form 0)
           ct (canonical-closure-result-type env t)
           pt (if (variant-type? ct) (variant-payload-type (form/nth-of ct 2) (arg form 1) 0) (form/nil-form))
           a (desugar-expected-value env pt (arg form 2))]
       (dr (dr-env a) (form/call3 "variant-new" t (arg form 1) (dr-form a)))))
   :default nil)

;; branches [tag binder body] as a vector of vectors with the bodies desugared; BRANCH-AT reads branch k of FORM
#?(:kotoba
   (defn variant-branches [env [:ref :fe/env] branches [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of branches))
       (drs env acc)
       (let [b (form/nth-of branches i)
             body (desugar-expr env (form/nth-of b 2))]
         (variant-branches (dr-env body) branches (+ i 1)
                           (form/append-form acc (form/vec3 (form/nth-of b 0) (form/nth-of b 1) (dr-form body)))))))
   :default nil)

#?(:kotoba
   (defn variant-branch-ok? [b [:ref :form/r] seq? :bool] :bool
     (and (if seq? (form/is-seq? b) (form/is-vec? b)) (= 3 (form/count-of b))
          (form/is-keyword? (form/nth-of b 0)) (form/is-symbol? (form/nth-of b 1))))
   :default nil)

#?(:kotoba
   (defn all-variant-branches-ok? [branches [:ref :form/r] i :i64 seq? :bool] :bool
     (if (>= i (form/count-of branches))
       true
       (and (variant-branch-ok? (form/nth-of branches i) seq?) (all-variant-branches-ok? branches (+ i 1) seq?))))
   :default nil)

;; a Form vector of the forms of FORM from index I
#?(:kotoba
   (defn vec-from [form [:ref :form/r] i :i64] [:ref :form/r]
     (form/form-vec (args-from form i)))
   :default nil)

#?(:kotoba
   (defn desugar-match-variant [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 3) "match-variant requires value, type, and exhaustive branches"
                        "kotoba.error/subset-reject" form)
           branches (vec-from form 3)
           _ (require-k (all-variant-branches-ok? branches 0 true) "match-variant branches require (:case binder body)"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           bs (variant-branches (dr-env v) branches 0 (form/no-forms))]
       (dr (drs-env bs) (form/call3 "variant-match" t (dr-form v) (form/form-vec (drs-forms bs))))))
   :default nil)

#?(:kotoba
   (defn desugar-variant-match [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form)) "variant-match requires type, value, and lowered branches"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           branches (arg form 2)
           _ (require-k (and (form/is-vec? branches) (all-variant-branches-ok? branches 0 false))
                        "variant-match lowered branches are invalid" "kotoba.error/subset-reject" form)
           v (desugar-expected-value env t (arg form 1))
           bs (variant-branches (dr-env v) branches 0 (form/no-forms))]
       (dr (drs-env bs) (form/call3 "variant-match" t (dr-form v) (form/form-vec (drs-forms bs))))))
   :default nil)

;; (ok binder body) / (err binder body) / (some binder body) branch shape: a 3-element seq headed by HEAD with a symbol binder
#?(:kotoba
   (defn branch3? [b [:ref :form/r] head :string] :bool
     (and (form/is-seq? b) (= 3 (form/count-of b)) (sym-is? (form/nth-of b 0) head) (form/is-symbol? (form/nth-of b 1))))
   :default nil)

#?(:kotoba
   (defn desugar-match-result [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "match-result requires value, type, ok branch, and err branch"
                        "kotoba.error/subset-reject" form)
           okb (arg form 2)
           errb (arg form 3)
           _ (require-k (branch3? okb "ok") "match-result requires exactly one (ok binder body) branch"
                        "kotoba.error/subset-reject" form)
           _ (require-k (branch3? errb "err") "match-result requires exactly one (err binder body) branch"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           ob (desugar-expr (dr-env v) (form/nth-of okb 2))
           eb (desugar-expr (dr-env ob) (form/nth-of errb 2))]
       (dr (dr-env eb)
           (form/call6 "result-match-of" t (dr-form v) (form/nth-of okb 1) (dr-form ob) (form/nth-of errb 1) (dr-form eb)))))
   :default nil)

#?(:kotoba
   (defn desugar-result-match-of [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 6 (argc form)) "result-match-of requires type, value, and two bound branches"
                        "kotoba.error/subset-reject" form)
           _ (require-k (and (form/is-symbol? (arg form 2)) (form/is-symbol? (arg form 4)))
                        "result-match-of requires symbol binders" "kotoba.error/subset-reject" form)
           t (arg form 0)
           v (desugar-expected-value env t (arg form 1))
           ob (desugar-expr (dr-env v) (arg form 3))
           eb (desugar-expr (dr-env ob) (arg form 5))]
       (dr (dr-env eb) (form/call6 "result-match-of" t (dr-form v) (arg form 2) (dr-form ob) (arg form 4) (dr-form eb)))))
   :default nil)

#?(:kotoba
   (defn desugar-option-match [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 5 (argc form)) "option-match requires type, value, none body, binder, and some body"
                        "kotoba.error/subset-reject" form)
           _ (require-k (form/is-symbol? (arg form 3)) "option-match requires a symbol binder" "kotoba.error/subset-reject" form)
           t (arg form 0)
           v (desugar-expected-value env t (arg form 1))
           nb (desugar-expr (dr-env v) (arg form 2))
           sb (desugar-expr (dr-env nb) (arg form 4))]
       (dr (dr-env sb) (form/call5 "option-match" t (dr-form v) (dr-form nb) (arg form 3) (dr-form sb)))))
   :default nil)

#?(:kotoba
   (defn desugar-match-option [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "match-option requires value, type, none branch, and some branch"
                        "kotoba.error/subset-reject" form)
           nb (arg form 2)
           sb (arg form 3)
           _ (require-k (and (form/is-seq? nb) (= 2 (form/count-of nb)) (sym-is? (form/nth-of nb 0) "none"))
                        "match-option requires exactly one (none body) branch" "kotoba.error/subset-reject" form)
           _ (require-k (branch3? sb "some") "match-option requires exactly one (some binder body) branch"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           n (desugar-expr (dr-env v) (form/nth-of nb 1))
           s (desugar-expr (dr-env n) (form/nth-of sb 2))]
       (dr (dr-env s) (form/call5 "option-match" t (dr-form v) (dr-form n) (form/nth-of sb 1) (dr-form s)))))
   :default nil)

;; ---- abort ability: throw / try / catch ----
;; the description of the lexical context that refuses `throw`, or "" (`abort-lexical-context`)
#?(:kotoba
   (defn abort-context-text [env [:ref :fe/env]] :string
     (cond
       (record-get [:ref :fe/env] env :lazy) "a lazy thunk"
       (string=? (record-get [:ref :fe/env] env :abort-ctx) "fn") "a fn literal"
       :else ""))
   :default nil)

#?(:kotoba
   (defn desugar-throw [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "throw requires exactly one error value" "kotoba.error/abort-shape" form)
           context (abort-context-text env)
           _ (require-k (string=? context "")
                        (string-concat "throw inside "
                          (string-concat context " is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met"))
                        "kotoba.error/abort-precondition" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/call1 "throw" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn types-assoc [types [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (if (form/is-map? types)
       (form/assoc-form types k v)
       (form/form-map (form/two-forms k v))))
   :default nil)

#?(:kotoba
   (defn desugar-try [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "try requires exactly one body expression and one catch clause"
                        "kotoba.error/abort-shape" form)
           body (arg form 0)
           clause (arg form 1)
           _ (require-k (and (form/is-seq? clause) (sym-is? (form/nth-of clause 0) "catch"))
                        "try requires a (catch [error-type] binder handler) clause" "kotoba.error/abort-shape" form)
           parts (- (form/count-of clause) 1)
           _ (require-k (or (= 2 parts) (= 3 parts))
                        "catch requires an optional error type, one binder, and one handler expression"
                        "kotoba.error/abort-shape" form)
           binder (form/nth-of clause (if (= 2 parts) 1 2))
           handler (form/nth-of clause (if (= 2 parts) 2 3))
           raw-type (if (= 2 parts) (form/nil-form) (form/nth-of clause 1))
           error-type (if (form/eq raw-type (form/keyword-form :default)) (form/nil-form) raw-type)
           _ (require-k (simple-symbol-form? binder) "catch binder must be an unqualified symbol" "kotoba.error/abort-shape" form)
           _ (require-k (<= (string-byte-length (form/symbol-value binder)) 128)
                        "catch binder must be a bounded unqualified symbol" "kotoba.error/abort-shape" form)
           _ (desugar-validate-error-type error-type)
           saved-lexical (env-lexical env)
           saved-types (env-types env)
           henv (record-assoc [:ref :fe/env] (with-lexical env (form/form-set (form/append-form (form/kids-of saved-lexical) binder)))
                              :types (if (form/is-nil? error-type) saved-types (types-assoc saved-types binder error-type)))
           h (desugar-expr henv handler)
           renv (record-assoc [:ref :fe/env] (with-lexical (dr-env h) saved-lexical) :types saved-types)
           b (desugar-expr renv body)]
       (dr (dr-env b)
           (form/call2 "try" (dr-form b)
                       (if (form/is-nil? error-type)
                         (form/call2 "catch" binder (dr-form h))
                         (form/call3 "catch" error-type binder (dr-form h)))))))
   :default nil)

;; `(when (some? error-type) (validate-value-type! error-type))`
#?(:kotoba
   (defn desugar-validate-error-type [error-type [:ref :form/r]] :i64
     (if (form/is-nil? error-type)
       0
       (validate-value-type! error-type)))
   :default nil)

#?(:kotoba
   (defn desugar-catch-arm [form [:ref :form/r]] [:ref :fe/err]
     (fe-reject "catch is admitted only as the clause of a try" "kotoba.error/abort-shape" form))
   :default nil)

;; ---- vector literals ----
;; `closed-vector-literal-type`: the descriptor a closed literal determines, nil-form when it is not closed
#?(:kotoba
   (defn all-item-types-are? [types [:list [:ref :form/r]] want [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count types))
       true
       (and (form/eq (typed-list-nth [:list [:ref :form/r]] types i) want) (all-item-types-are? types want (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn all-item-types-some? [types [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count types))
       true
       (and (not (form/is-nil? (typed-list-nth [:list [:ref :form/r]] types i))) (all-item-types-some? types (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn closed-vector-item-types [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (closed-vector-item-types f (+ i 1) (form/append-form acc (closed-vector-literal-type (form/nth-of f i))))))
   :default nil)

#?(:kotoba
   (defn desugar-vector-literal [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (form/count-of form) 128) "vector literal exceeds item limit" "kotoba.error/subset-reject" form)
           types (closed-vector-item-types form 0 (form/no-forms))]
       (cond
         (or (= 0 (vector-count types)) (all-item-types-are? types (form/keyword-form :i64) 0))
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r))))
         (all-item-types-are? types (form/keyword-form :f64) 0)
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-f64-new") (drs-forms r))))
         (all-item-types-some? types 0)
         (let [t (form/vec2 (form/keyword-form :vector) (form/form-vec types))
               r (ev-each-types env types form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "hetero-vector-new") (form/cons-onto t (drs-forms r)))))
         :else
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r)))))))
   :default nil)

;; each kid of FORM from index I desugared (a literal's items start at 0; a call's operands at 1)
#?(:kotoba
   (defn desugar-each-from [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of form i))]
         (desugar-each-from (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; item k of the literal FORM expected as TYPES[k]
#?(:kotoba
   (defn ev-each-types [env [:ref :fe/env] types [:list [:ref :form/r]] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env (typed-list-nth [:list [:ref :form/r]] types i) (form/nth-of form i))]
         (ev-each-types (dr-env r) types form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; ---- small arms ----
#?(:kotoba
   (defn desugar-vector-i64-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "vector-i64 exceeds item limit" "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-vector-f64-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "vector-f64 exceeds item limit" "kotoba.error/subset-reject" form)]
       (desugar-all-under env (form/symbol-form "vector-f64-new") form (form/keyword-form :f64) 1 (form/no-forms))))
   :default nil)

#?(:kotoba
   (defn desugar-xorshift32 [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "xorshift32 requires one state value" "kotoba.error/subset-reject" form)
           s0 (synthetic env "xorshift32_0")
           s1 (synthetic (dr-env s0) "xorshift32_1")
           s2 (synthetic (dr-env s1) "xorshift32_2")
           s3 (synthetic (dr-env s2) "xorshift32_3")
           x0 (dr-form s0)
           x1 (dr-form s1)
           x2 (dr-form s2)
           x3 (dr-form s3)
           a (desugar-expr (dr-env s3) (arg form 0))
           b0 (form/call1 "u32-wrap" (dr-form a))
           b1 (form/call1 "u32-wrap" (form/call2 "i32-xor" x0 (form/call2 "i32-shift-left" x0 (form/int-form 13))))
           b2 (form/call1 "u32-wrap" (form/call2 "i32-xor" x1 (form/call2 "u32-shift-right" x1 (form/int-form 17))))
           b3 (form/call1 "u32-wrap" (form/call2 "i32-xor" x2 (form/call2 "i32-shift-left" x2 (form/int-form 5))))]
       (dr (dr-env a)
           (form/call2 "let" (form/form-vec (put2 (put2 (put2 (put2 (form/no-forms) x0 b0) x1 b1) x2 b2) x3 b3)) x3))))
   :default nil)

#?(:kotoba
   (defn desugar-assoc-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (>= (argc form) 3) (= 1 (rem (argc form) 2)))
                        "assoc requires a map followed by one or more key/value pairs" "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "map-assoc") (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-select-keys-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [ks (arg form 1)
           _ (require-k (and (= 2 (argc form)) (form/is-vec? ks) (all-keywords? ks 0))
                        "select-keys requires a record and a literal vector of keyword fields: a record's fields are static, so the fields it keeps are written, not computed"
                        "kotoba.error/row-operation-shape" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/form-seq (form/cons-onto (form/symbol-form "select-keys") (form/cons-onto (dr-form a) (form/kids-of ks)))))))
   :default nil)

#?(:kotoba
   (defn all-keywords? [v [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of v))
       true
       (and (form/is-keyword? (form/nth-of v i)) (all-keywords? v (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-merge-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 2)
                        "merge requires a record and at least one record or map literal to merge onto it"
                        "kotoba.error/row-operation-shape" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "merge") (drs-forms r)))))
   :default nil)

;; ---- list ----
;; `(list a b c)`: the pair chain built from the last item (items are desugared last to first, as the host's reverse/reduce)
#?(:kotoba
   (defn list-pairs [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :fe/dr]
     (if (< i 1)
       (dr env acc)
       (let [a (desugar-expr env (form/nth-of form i))]
         (list-pairs (dr-env a) form (- i 1) (form/call2 "pair" (dr-form a) acc)))))
   :default nil)

#?(:kotoba
   (defn desugar-list-arm [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "list item count exceeds admission limit" "kotoba.error/subset-reject" form)]
       (if (canonical-list-type? ctx)
         (let [r (ev-each env (form/nth-of ctx 1) form 1 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "typed-list-new") (form/cons-onto ctx (drs-forms r)))))
         (list-pairs env form (argc form) (form/int-form 0)))))
   :default nil)

;; ---- named operations: a namespaced head ----
#?(:kotoba
   (defn reader-tagged-refusal [name :string form [:ref :form/r]] [:ref :fe/err]
     (cond
       (string=? name "kotoba.reader/regex")
       (fe-reject "host regex literal #\"...\" is not admitted; pass the pattern as a string to kotoba.lang.bounded-regex"
                  "kotoba.error/host-regex-literal" form)
       (string=? name "kotoba.reader/js")
       (fe-reject "#js literal is host interop; keep it inside a :cljs reader-conditional branch"
                  "kotoba.error/host-js-literal" form)
       (or (string=? name "kotoba.reader/set") (string=? name "kotoba.reader/bigint") (string=? name "kotoba.reader/bigdec"))
       (fe-reject (string-concat "host literal "
                    (string-concat (string-substring name 14 (string-byte-length name))
                      " is not admitted (Kotoba admits keyword-set data and i64 / f64 literals); keep it inside a :clj / :cljs reader-conditional branch"))
                  "kotoba.error/host-literal" form)
       (string=? name "kotoba.reader/char")
       (fe-reject "character literal \\c is host data; Kotoba text is UTF-8 bytes -- spell the byte as an integer (byte-at / string-byte-at) or use a one-character string"
                  "kotoba.error/host-char-literal" form)
       :else (fe-reject (string-concat "named operation " (string-concat name " is not a registered capability"))
                        "kotoba.error/subset-reject" form)))
   :default nil)

;; the operation was written with a namespace: a registered capability (one request value), clojure.core/X
;; (the bare head), else a refusal by name
#?(:kotoba
   (defn desugar-named-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [name (form/symbol-value op)
           slash (string-find-byte name 47 0)
           kw (form/edn-form (string-concat ":" name))]
       (cond
         (tables/table-has? (env-table env :cap-registry) kw)
         (let [_ (require-k (= 1 (argc form)) (string-concat "named operation " (string-concat name " requires exactly one request value"))
                            "kotoba.error/subset-reject" form)
               a (desugar-expr (note-used-capability env kw) (arg form 0))]
           (dr (dr-env a) (form/call1 name (dr-form a))))
         (string=? (string-substring name 0 slash) "clojure.core")
         (desugar-expr env (form/form-seq (form/cons-onto (form/symbol-form (string-substring name (+ slash 1) (string-byte-length name)))
                                                          (form/rest-list form))))
         :else (throw (reader-tagged-refusal name form)))))
   :default nil)

;; `*used-capability-keywords*` when bound: a Form set the analysis reads back; nil-form when unbound
#?(:kotoba
   (defn note-used-capability [env [:ref :fe/env] kw [:ref :form/r]] [:ref :fe/env]
     (let [used (record-get [:ref :fe/env] env :used-caps)]
       (record-assoc [:ref :fe/env] env :used-caps
                     (if (form/is-set? used) (form/form-set (form/append-form (form/kids-of used) kw)) used))))
   :default nil)

;; ---- if-some / when-some ----
;; `resolve-option-type`: the option type of a value form as far as sugar lowering can tell without inference
;; (nil-form: a symbol with no recorded option type); [:option :i64] is the legacy fallback
#?(:kotoba
   (defn option-descriptor? [t [:ref :form/r]] :bool
     (and (form/is-vec? t) (kw-head? t "option")))
   :default nil)

#?(:kotoba
   (defn binding-some-then [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (if when?
       (if (= 1 (- (form/count-of form) 2))
         (dr env (form/nth-of form 2))
         (desugar-do env form 2))
       (dr env (form/nth-of form 2))))
   :default nil)

#?(:kotoba
   (defn all-symbols? [v [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of v))
       true
       (and (form/is-symbol? (form/nth-of v i)) (all-symbols? v (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn symbol-literal-forms [v [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of v))
       acc
       (symbol-literal-forms v (+ i 1) (form/append-form acc (form/call1 "symbol" (form/string-form (form/symbol-value (form/nth-of v i))))))))
   :default nil)

#?(:kotoba
   (defn symbol-type-list [n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (<= n 0) acc (symbol-type-list (- n 1) (form/append-form acc (form/keyword-form :symbol)))))
   :default nil)
#?(:kotoba nil :default (def contextual-string-argument-indexes tables/contextual-string-argument-indexes))
#?(:kotoba nil :default (def contextual-document-argument-indexes tables/contextual-document-argument-indexes))
#?(:kotoba nil :default (def contextual-f64-argument-indexes tables/contextual-f64-argument-indexes))
#?(:kotoba nil :default (def contextual-f32-argument-indexes tables/contextual-f32-argument-indexes))
#?(:kotoba nil :default (def contextual-vector-f64-argument-types tables/contextual-vector-f64-argument-types))

;; ADR-2607150000: bound (via `binding`) around each top-level defn's
;; desugaring pass in `analyze`, to an atom `loop`'s desugar-expr case
;; conjoins synthesized helper-function definitions onto -- the same
;; "collect synthesized functions on the side, inject them into `parsed`
;; afterward" pattern `map-get-helper`/`uses-map-get?` already established,
;; generalized to support MULTIPLE, uniquely-named helpers per defn (one
;; per `loop` occurrence) rather than one fixed shared name.
(def ^:dynamic *pending-loop-helpers* nil)

;; ADR 0027: helper name -> {:bindings n :declared-result t-or-nil} for every
;; synthesized loop-helper, bound ONCE per `analyze` beside `*loop-counter*`.
;; It is a SIDE table on purpose. The obvious place for these two facts is the
;; helper's own function map, and putting them there changed the emitted HIR:
;; the map crossed the eight-entry array-map threshold and printed its keys in
;; a different order, so every loop-using module's HIR text moved without one
;; value in it changing. Byte-identical output for an unchanged program is the
;; measurement this pass had to keep, so what the passes need travels here and
;; the function map is left exactly as it was.
(def ^:dynamic *loop-helper-shapes* nil)

;; Optional override for the synthesized loop-helper's return type.
;;
;; nil -- the ordinary case -- means "read it from the loop's own exits", which
;; `infer-loop-helper-results` does once the helper's parameter types are known.
;; It used to default to `:i64`, which made the helper's result a CONSTANT with
;; two hard-coded values: every loop returned an i64 unless it was one of the
;; two T4.5 desugarings below, so `(loop [i 0 acc 0.0] ... acc)` was refused
;; with "expected f64, got i64" at the loop's own call site (ADR 0027).
;;
;; T4.5 map/filter still bind it, and the binding is now a redundancy check
;; rather than the only source of the answer: inference derives `:vector-i64`
;; for those two loops on its own (their accumulator is initialised to
;; `(vector-i64)` and their sole exit is that accumulator), and
;; `infer-loop-helper-results` refuses a declared result its exits disagree
;; with, so the two cannot drift apart silently.
(def ^:dynamic *loop-result-type* nil)

;; Known types for a synthesized loop-helper's bindings and captured outer
;; variables. T4.5 map/filter/reduce know the source is `:vector-i64` (or a
;; packed heterogeneous vector of those) before the helper's call site can
;; say so: the collection is often an unannotated parameter, still
;; provisionally `:i64` when `resolve-loop-helper-param-types` records
;; argument types. Without this overlay the helper is typed `:i64` for
;; `__kotoba_map_source_*` and `vector-count` / `vector-at` refuse the
;; binding the author never wrote -- the stdlib-core-oracle cascade.
(def ^:dynamic *loop-known-types* nil)

;; ADR-2607150000: loop-helper names are NOT `gensym` -- unlike and/or's
;; gensym'd `let`-local temp names (erased into numeric WASM local indices,
;; never appearing in the compiled bytes -- confirmed by repeated-compile
;; byte comparison), a loop-helper becomes a real EXPORTED top-level
;; function ("every function is exported by current backends," see
;; analyze's :effects comment below), so its NAME is literally baked into
;; the WASM export section. `gensym` uses a JVM-process-wide monotonic
;; counter, so two compiles of the IDENTICAL source in the same process
;; would get DIFFERENT loop-helper names and therefore DIFFERENT bytes --
;; confirmed empirically (compiled the same loop-using source twice in one
;; process: bytes differed). This compiler's own reproducible-build gates
;; (coverage_evidence.clj/release.clj) require byte-for-byte determinism,
;; so loop-helpers instead get a sequential name from *loop-counter*,
;; bound ONCE per `analyze` call (not per-defn) so the same source always
;; encounters `loop` forms in the same left-to-right desugaring order and
;; always assigns the same names.
(def ^:dynamic *loop-counter* nil)
(def ^:dynamic *function-arities* {})
(def ^:dynamic *document-functions*
  "Source names of the module's functions whose DECLARED result is `:document`.
  `reduce`/`map`/`filter` choose between the vector-i64 and document lowerings
  while desugaring, when a call's result type is not inferred yet; a declared
  `:document` result is what lets `(merge (base) x)` or `(vals (f))` be read as a
  document."
  #{})
(def ^:dynamic *lambda-counter* nil)
(def ^:dynamic *pending-lambdas* nil)
(def ^:dynamic *uses-apply?* nil)
(def ^:dynamic *uses-lazy?* nil)
(def ^:dynamic *lifting-lazy-thunk?* false)

;; Abort ability, slice 1 (kotoba-lang `lang/abort-ability.edn`). `throw` is
;; refused inside the lexical contexts whose unwind is not checked yet -- a
;; loop/doseq/dotimes body (which becomes a synthesized helper function), a
;; lazy thunk, a fn literal. Bound to the context's tag while its body is
;; desugared so the refusal can name it and cite the precondition it waits on.
(def ^:dynamic *abort-lexical-context* nil)

(defn abort-lexical-context
  "The description of the lexical context that refuses `throw`, or nil."
  []
  ;; A loop/doseq/dotimes body is NOT here since 2026-09-25 (superproject
  ;; adr-2609242330; kotoba-lang lang/abort-ability.edn :loop-body). Its body
  ;; becomes a loop helper that is called exactly where the loop is written,
  ;; so an abort from it reaches the enclosing function, which becomes
  ;; aborting in turn -- and `check-abort-facet-unwind!` refuses every
  ;; aborting function whose interprocedural row carries a facet operation.
  ;; That check IS the facet-unwind precondition for a lexically bounded body.
  ;; A lazy thunk and a fn literal are not lexically bounded (either can run
  ;; after, or outside, the scope that wrote it) and stay refused.
  (cond
    *lifting-lazy-thunk?* "a lazy thunk"
    (= :fn *abort-lexical-context*) "a fn literal"))
(def ^:dynamic *lexical-bindings* #{})
(def ^:dynamic *lexical-callable-contracts* {})
(def ^:dynamic *function-callable-result-contracts* {})
;; `[source-name arity]` -> `{parameter-index callable-contract}` for every
;; defn clause whose parameter vector names a `[:fn ...]` type. Read at an
;; ordinary call so a `fn` written in that argument position is lifted under
;; the contract, the way a `fn` in a contract-typed result position already
;; is (2026-09-12): its parameters take the clause's types and it joins the
;; dispatcher family of that signature. A lambda written anywhere else keeps
;; i64 parameters.
(def ^:dynamic *function-callable-param-contracts* {})
(def ^:dynamic *expected-callable-contract* nil)
(def ^:dynamic *contextual-closure-result-type* nil)
(def ^:dynamic *required-closure-dispatchers* nil)

(defn dispatcher-key
  "The key a dispatcher family is requested and built under. `[result arity]`
  for the all-`:i64` parameter shape -- every key that existed before typed
  parameters is unchanged -- and `[result arity parameter-types]` otherwise."
  [result-type arity parameter-types]
  (if (i64-parameter-types? parameter-types)
    [result-type arity]
    [result-type arity (vec parameter-types)]))

(defn request-invoke-dispatcher
  ([result-type arity] (request-invoke-dispatcher result-type arity nil))
  ([result-type arity parameter-types]
   (when *required-closure-dispatchers*
     (vswap! *required-closure-dispatchers* conj
             (dispatcher-key result-type arity parameter-types)))
   (invoke-dispatcher-name result-type arity parameter-types)))

#?(:kotoba nil :default (def non-shadowable-special-heads tables/non-shadowable-special-heads))

(defn lexical-call-form? [form]
  (and (seq? form)
       (symbol? (first form))
       (contains? *lexical-bindings* (first form))
       (not (contains? non-shadowable-special-heads (first form)))))

(defn callable-clause-for-arity [contract arity form]
  (or (first-truthy #(when (= arity (count (first %))) %) (callable-clauses contract))
      (reject! "callable contract does not admit this arity"
               form :kotoba.error/callable-arity)))

(defn expression-callable-contract [form]
  (cond
    (symbol? form) (get *lexical-callable-contracts* form)
    (seq? form) (or (get *function-callable-result-contracts*
                         [(first form) (dec (count form))])
                    (get *function-callable-result-contracts* (first form)))
    :else nil))

(defn desugar-lexical-call [result-type form]
  (let [[closure & args] form]
    (when (> (count args) 4)
      (reject! "direct closure call exceeds ABI arity four" form))
    (let [contract (get *lexical-callable-contracts* closure)
          [parameter-types contract-result]
          (when contract (callable-clause-for-arity contract (count args) form))
          result-type (or contract-result result-type)]
      ;; A contract's parameter types select the dispatcher family (one per
      ;; distinct clause signature) and give each argument its expected type
      ;; context, exactly as a typed result gives the tail expression one.
      ;; An `:i64` parameter is desugared as it always was, so a program
      ;; whose contracts are all-i64 lowers to the same HIR. The argument's
      ;; TYPE is checked where every call's is -- against the dispatcher's
      ;; signature by the ordinary checker (`expression type mismatch:
      ;; expected document, got i64`) -- not by a second table here.
      (apply list (request-invoke-dispatcher result-type (count args) parameter-types)
             closure
             (if parameter-types
               (map (fn [argument wanted]
                      (if (= :i64 wanted)
                        (desugar-expr argument)
                        (desugar-expected-value wanted argument)))
                    args parameter-types)
               (map desugar-expr args))))))

#?(:kotoba
   (defn desugar-result-expr [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [rt (canonical-closure-result-type env result-type)
           _ (require-k (closure-result-type? rt) "closure result type is outside the admitted dispatcher profile"
                        "kotoba.error/subset-reject" rt)]
       (desugar-expr (with-result env rt) form)))
   :default
(defn desugar-result-expr
  "Desugar an expression in a context with a known closure result family.
  The expectation follows value-producing tail positions, while ordinary
  operands are desugared without inheriting it."
  [result-type form]
  (let [result-type (canonical-closure-result-type result-type)]
    (when-not (closure-result-type? result-type {})
      (reject! "closure result type is outside the admitted dispatcher profile"
               result-type))
    (binding [*contextual-closure-result-type* result-type]
      (desugar-expr form)))))

#?(:kotoba
   (defn desugar-vector-i64-source [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (and (form/is-seq? form) (= 2 (form/count-of form))
              (or (head-is? form "rest") (head-is? form "pair-second")))
       (let [a (desugar-vector-i64-source env (form/nth-of form 1))]
         (dr (dr-env a) (form/call2 "vector-drop" (dr-form a) (form/int-form 1))))
       (desugar-result-expr env (form/keyword-form :vector-i64) form)))
   :default
(defn desugar-vector-i64-source
  "Desugar a T4.5 map/filter/reduce collection in the vector-i64 profile.

  `rest` and a written `pair-second` are Clojure's tail of a vector, not the
  legacy pair-chain walk: leaving them as `pair-second` types the source as
  `:i64` and the loop helper then refuses `__kotoba_map_source_*` with
  `expected vector-i64, got i64` -- or the reverse, `pair-second` requiring
  `:i64` of a source that is already a vector. `vector-drop` is the same
  tail and keeps `:vector-i64` through the binding and the captured loop
  parameter. Nested tails compose. Every other form keeps the ordinary
  vector-i64 result context."
  [form]
  (if (and (seq? form)
           (contains? '#{rest pair-second} (first form))
           (= 1 (count (rest form))))
    (list 'vector-drop (desugar-vector-i64-source (second form)) 1)
    (desugar-result-expr :vector-i64 form))))

#?(:kotoba
   (defn desugar-bool-expr [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (desugar-result-expr env (form/keyword-form :bool) form))
   :default
(defn desugar-bool-expr [form]
  (desugar-result-expr :bool form)))

#?(:kotoba
   (defn desugar-expected-value [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [rt (canonical-closure-result-type env result-type)]
       (cond
         (closure-result-type? rt) (desugar-result-expr env rt form)
         (and (callable-type? rt) (head-is? form "fn")) (throw (fe-unported "function value under a callable contract" form))
         :else (desugar-expr env form))))
   :default
(defn desugar-expected-value [result-type form]
  (let [result-type (canonical-closure-result-type result-type)]
    (cond
      (closure-result-type? result-type {})
      (desugar-result-expr result-type form)
      ;; ADR 0353 floor :function-values: a `fn` written where a `[:fn ...]`
      ;; record field is declared is lifted under that contract -- its
      ;; parameters take the clause's types and it joins that dispatcher
      ;; family, exactly as a `fn` argument in a contract-typed parameter
      ;; position does (`desugar-ordinary-call`).
      (and (callable-type? result-type) (seq? form) (= 'fn (first form)))
      (binding [*expected-callable-contract* result-type]
        (desugar-expr form))
      :else (desugar-expr form)))))

;; the forms of FORM from index I (inclusive), each desugared, the last under RESULT-TYPE when it is not nil
#?(:kotoba
   (defn desugar-tail-expressions [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r] i :i64
                                    acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-tail-one env result-type form i)]
         (desugar-tail-expressions (dr-env r) result-type form (+ i 1) (form/append-form acc (dr-form r))))))
   :default
(defn desugar-tail-expressions [result-type forms]
  (let [last-index (dec (count forms))]
    (mapv (fn [index form]
            (if (and result-type (= index last-index))
              (desugar-result-expr result-type form)
              (desugar-expr form)))
          (range (count forms)) forms))))

#?(:kotoba
   (defn sequenced-body [forms [:list [:ref :form/r]] form [:ref :form/r] head :string] [:ref :form/r]
     (cond
       (= 0 (vector-count forms)) (throw (fe-reject (string-concat head " requires at least one body expression")
                                                    "kotoba.error/let-body-empty" form))
       (= 1 (vector-count forms)) (typed-list-nth [:list [:ref :form/r]] forms 0)
       :else (form/form-seq (form/cons-onto (form/symbol-form "do") forms))))
   :default
(defn sequenced-body
  "Collapse an implicit-`do` body into the ONE expression a core head takes.

  Heads whose source body is a sequence of forms (`let` today; `when` and its
  relatives reach `do` by their own desugaring) must hand exactly one
  expression to the core form, because `let` in KIR is `(let [n v ...] body)`
  with a single body -- every consumer in this file and in kotoba-kir
  destructures it that way.

  The collapse is `do`, never a nested `let`. `do` is kept as a first-class
  head through desugaring for the reason stated at the `do` case below: a
  nested-`let` encoding of sequencing makes an earlier subexpression an unused
  binding, and an unused binding is exactly what a later pass is entitled to
  drop. A kernel store or a `cap-call` in non-final position is the thing that
  would be dropped.

  An empty body is refused rather than collapsed. `(let [x 1])` has no value to
  return, and returning `nil` from here put a literal `nil` into HIR where an
  expression belongs."
  [forms form head]
  (cond
    (empty? forms)
    (reject! (str head " requires at least one body expression") form
             :kotoba.error/let-body-empty)
    (= 1 (count forms)) (first forms)
    :else (list* 'do forms))))

#?(:kotoba
   (defn closed-vector-literal-type [f [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-int? f) (form/keyword-form :i64)
       (form/is-f64? f) (form/keyword-form :f64)
       (form/is-string? f) (form/keyword-form :string)
       (form/is-keyword? f) (form/keyword-form :keyword)
       (form/is-bool? f) (form/keyword-form :bool)
       (and (form/is-seq? f) (= 2 (form/count-of f)) (sym-is? (form/nth-of f 0) "quote") (form/is-symbol? (form/nth-of f 1)))
       (form/keyword-form :symbol)
       (form/is-vec? f)
       (let [types (closed-vector-item-types f 0 (form/no-forms))]
         (cond
           (= 0 (vector-count types)) (form/keyword-form :vector-i64)
           (all-item-types-are? types (form/keyword-form :i64) 0) (form/keyword-form :vector-i64)
           (all-item-types-are? types (form/keyword-form :f64) 0) (form/keyword-form :vector-f64)
           (all-item-types-some? types 0) (form/vec2 (form/keyword-form :vector) (form/form-vec types))
           :else (form/nil-form)))
       :else (form/nil-form)))
   :default
(defn closed-vector-literal-type
  "Infer only descriptors that are completely determined by a closed vector
  literal. Unknown expressions return nil and keep the established i64-vector
  path, where ordinary type checking reports any mismatch."
  [form]
  (cond
    (kotoba-integer? form) :i64
    (value/f64-value? form) :f64
    (string? form) :string
    (keyword? form) :keyword
    (boolean? form) :bool
    ;; `'sym` (the reader's `(quote sym)`) is a `:symbol` item, so `[1 'a]`
    ;; is a heterogeneous vector the way `[1 :a]` is (2026-09-12)
    (and (seq? form) (= 'quote (first form)) (= 2 (count form)) (symbol? (second form))) :symbol
    (vector? form)
    (let [item-types (mapv closed-vector-literal-type form)]
      (cond
        (empty? item-types) :vector-i64
        (every? #{:i64} item-types) :vector-i64
        (every? #{:f64} item-types) :vector-f64
        (every? some? item-types) [:vector item-types]
        :else nil))
    :else nil)))

(def ^:dynamic *absence-mode*
  "Which marker a missing else writes: :none in a function whose result is
  inferred (an unannotated `defn`, a `fn` literal with no declared result),
  :legacy where the author declared the result -- there a missing else beside
  an :i64 is still the 0 it always was (`absence-type`)."
  :legacy)

#?(:kotoba
   (defn absence-marker-form [env [:ref :fe/env]] [:ref :form/r]
     (if (env-none? env)
       (form/call1 "__kotoba_absent" (form/keyword-form :none))
       (form/call0 "__kotoba_absent")))
   :default
(defn absence-marker-form
  "The marker a missing else writes here."
  []
  (if (= :none *absence-mode*) '(__kotoba_absent :none) '(__kotoba_absent))))


(defn realized-lowering
  "Realize every lazy seq inside a lowered form, and answer the form.

  Desugaring builds its output with `map` / `map-indexed` under `list*` in
  many places, so part of a lowered body is a lazy seq that runs the
  desugarer when it is first walked. Walked after the `binding` it was built
  under has ended, it runs with the dynamic context gone: a `fn` literal
  stored as a map-literal value or a `record-new` field was lowered with
  `*lambda-counter*` nil and the program got `internal compiler error`
  (`vswap!` on nil) -- amu ADR 0352 point 5, `(let [m {:f (fn [x] (+ x 1))
  :n \"a\"}] ((:f m) 1))`. A lambda body realized outside its own `binding`
  would also have seen the enclosing function's lexical bindings, not its
  own. Every body is realized where it was desugared, once, here."
  [form]
  (dorun (tree-seq coll? seq form))
  form)

(defn lift-lambda [form]
  (let [expected-result *contextual-closure-result-type*
        expected-contract *expected-callable-contract*
        [_ params-or-clause & tail] form
        ;; A body of several forms is one `do` (`implicit-do-body`); an
        ;; empty one stays `nil` here so the refusal below still names it.
        raw-clauses (if (vector? params-or-clause)
                      [[params-or-clause (when (seq tail) (implicit-do-body tail))]]
                      (mapv (fn [clause]
                              (when-not (and (seq? clause) (vector? (first clause))
                                             (<= 2 (count clause)))
                                (reject! "multi-arity fn requires ([params] body) clauses" clause))
                              [(first clause) (implicit-do-body (rest clause))])
                            (cons params-or-clause tail)))
        parsed (mapv (fn [[params body :as clause]]
                       (let [amp-index (first (keep-indexed #(when (= '& %2) %1) params))]
                         (if amp-index
                           (do
                             (when-not (and (= amp-index (- (count params) 2))
                                            (<= amp-index 4)
                                            (every? valid-name? (subvec params 0 amp-index))
                                            (valid-name? (peek params)))
                               (reject! "variadic fn clause requires [fixed ... & rest]" clause))
                             {:kind :variadic :fixed (subvec params 0 amp-index)
                              :rest-name (peek params) :body body :min-arity amp-index})
                           {:kind :fixed :params params :body body :arity (count params)})))
                     raw-clauses)
        fixed (filter #(= :fixed (:kind %)) parsed)
        variadics (filter #(= :variadic (:kind %)) parsed)
        _ (when (or (> (count variadics) 1)
                    (not= (count fixed) (count (distinct (map :arity fixed)))))
            (reject! "fn requires unique fixed arities and at most one variadic clause" form))
        fixed-by-arity (into {} (map (juxt :arity identity) fixed))
        variadic (first variadics)
        arities (sort (set/union (set (keys fixed-by-arity))
                                 (if variadic (set (range (:min-arity variadic) 5)) #{})))
        contract-results
        (when expected-contract
          (into {} (map (fn [[parameter-types result-type]]
                          [(count parameter-types) result-type]))
                (callable-clauses expected-contract)))
        ;; The clause's PARAMETER types, by arity, when the contract names
        ;; any that is not `:i64` (2026-09-12). They type the lambda's own
        ;; parameters -- the helper's signature carries them, the body sees
        ;; them as locals, and the lambda joins the dispatcher family of
        ;; exactly that clause signature. An all-`:i64` clause leaves this
        ;; nil and the lambda lowers as it did before typed parameters.
        contract-params
        (when expected-contract
          (into {} (keep (fn [[parameter-types _]]
                           (when-not (i64-parameter-types? parameter-types)
                             [(count parameter-types) (vec parameter-types)])))
                (callable-clauses expected-contract)))
        _ (when (and expected-contract
                     (not= (set arities) (set (keys contract-results))))
            (reject! "fn arities do not match the declared callable result contract"
                     form :kotoba.error/callable-result-arity))
        clauses (mapv (fn [arity]
                        (if-let [{:keys [params body]} (get fixed-by-arity arity)]
                          [params body]
                          (specialize-variadic-clause variadic arity
                                                      "__kotoba_lambda_rest_arg_")))
                      arities)]
    (when-not (and (seq clauses)
                   (every? (fn [[params body]]
                             (and (some? body) (<= (count params) 4)
                                  (every? valid-name? params)
                                  (= (count params) (count (distinct params)))))
                           clauses)
                   (= (count clauses) (count (distinct (map (comp count first) clauses)))))
      (reject! "fn value requires unique arities with zero to four unique parameters" form))
    (when (and (vector? params-or-clause) (empty? tail))
      (reject! "single-arity fn value requires exactly one body" form))
    (let [lowered (mapv (fn [[params body]]
                          (let [clause-result (get contract-results (count params))
                                clause-params (get contract-params (count params))]
                          {:params params :contract-result clause-result
                           :contract-params clause-params
                           :body (binding [*lexical-bindings*
                                           (into *lexical-bindings* params)
                                           *abort-lexical-context* :fn
                                           ;; typed parameters are locals of
                                           ;; their type inside the body (a
                                           ;; record-field projection reads
                                           ;; them); the i64 clause binds
                                           ;; nothing new
                                           *local-types*
                                           (if clause-params
                                             (merge *local-types*
                                                    (zipmap params clause-params))
                                             *local-types*)
                                           *local-option-types*
                                           (if clause-params
                                             (into (or *local-option-types* {})
                                                   (keep (fn [[p t]]
                                                           (when (generic-option-type? t)
                                                             [p t])))
                                                   (map vector params clause-params))
                                             *local-option-types*)]
                                   (if-let [result (or clause-result expected-result)]
                                     (binding [*absence-mode* :legacy]
                                       (realized-lowering (desugar-result-expr result body)))
                                     ;; gap 1: a fn literal with no declared
                                     ;; result answers absence as an option
                                     (binding [*absence-mode* :none]
                                       (realized-lowering (desugar-expr body)))))}))
                        clauses)
          captures (vec (sort-by str
                                 (apply set/union #{}
                                        (map (fn [{:keys [params body]}]
                                               (form-free-symbols body (set params)))
                                             lowered))))
          id (vswap! *lambda-counter* inc)]
      (doseq [{:keys [params]} lowered]
        (when (> (+ (count captures) (count params)) max-parameters)
          (reject! "fn captures plus parameters exceed ABI-supported arity" form)))
      (when *pending-lambdas*
        (swap! *pending-lambdas* into
               (mapv (fn [{:keys [params body contract-result contract-params]}]
                       (let [arity (count params)
                             helper-name (symbol (str "__kotoba_lambda_" id "_arity" arity))]
                         (cond-> {:id id :arity arity :captures captures
                          :helper (cond-> {:name helper-name :params (into captures params)
                                           :result :i64 :result-inferred? true
                                           :effects #{} :body body
                                           :lazy-thunk? *lifting-lazy-thunk?*}
                                    ;; captures stay the i64 pair-chain words
                                    ;; they are read out of; only the clause's
                                    ;; own parameters carry the contract's types
                                    contract-params
                                    (assoc :param-types
                                           (into (vec (repeat (count captures) :i64))
                                                 contract-params)))}
                           contract-result (assoc :contract-result contract-result)
                           contract-params (assoc :parameter-types contract-params))))
                     lowered)))
      ;; Closure captures are always the internal i64 pair-chain ABI, even
      ;; when the lambda's result is a canonical `[:list T]` value.
      (list 'pair id
            (binding [*contextual-closure-result-type* nil]
              (desugar-list captures form))))))

#?(:kotoba
   (defn lazy-take-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_lazy_take"))
   :default
(def lazy-take-helper-name '__kotoba_lazy_take))
#?(:kotoba
   (defn lazy-drop-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_lazy_drop"))
   :default
(def lazy-drop-helper-name '__kotoba_lazy_drop))

;; ADR-2607182410: bound (via `binding`, once per `analyze` call, same
;; lifetime as `*loop-counter*` above -- not per-defn) to a `volatile!` set
;; that `resolve-capability-keyword!` conjoins each named capability onto as
;; `(cap-call :some/name ...)` forms are desugared. `analyze` derefs it once
;; all defns are desugared to check an optional `ns` `:capabilities`
;; declaration (declared-but-unused / used-but-undeclared) -- see
;; `check-namespace-capabilities!`. `nil` outside `analyze` (e.g. from a
;; direct unit-test call to `desugar-expr`) means "don't track," not "reject
;; every keyword": tracking is a purely additional ns-level lint, never part
;; of resolving the keyword to its id.
(def ^:dynamic *used-capability-keywords* nil)

;; Product Value ABI v1 / pure-product: local option types for if-some/when-some.
;; Bound during analyze while desugaring a typed defn body so
;; `(if-some [x opt-param] …)` can lower to option-match with the real
;; `[:option T]` instead of hardcoding `[:option :i64]` (which broke
;; `[:option :string]` and other payloads).
(def ^:dynamic *local-option-types* nil)
;; All typed params + namespace `:schemas` so
;; `(if-some [v (record-get rec :opt-field)] …)` recovers `[:option T]`
;; from the record descriptor (T5.2 option-string-in-record gap).
(def ^:dynamic *local-types* nil)

(defn resolve-capability-keyword!
  "Resolve a `cap-call` NAME argument (a namespaced keyword, e.g.
  `:identity/sign`) against `capability-registry` to its [0,255] int id, at
  desugar time -- strictly before HIR/KIR construction, so every downstream
  consumer (validate-expr's arity/range check, direct-facts'
  effect-extraction, ir.cljc, every backend, admission.cljc, verifier.clj)
  sees the same guest-i64 `cap-call` shape as a source numeric literal. On
  nbb that means JavaScript BigInt, not a compiler-host number; otherwise a
  named call's body and its inferred effect row disagree at native verifier
  time. None of the downstream consumers are aware a keyword was ever
  written. An unregistered keyword is a hard
  parse-time rejection (closed-world/deny-by-default for names, mirroring
  the existing [0,255]-range check for the integer form)."
  [kw form]
  (let [id (capability-wire-id kw form)]
    (when *used-capability-keywords*
      (vswap! *used-capability-keywords* conj kw))
    (effect-capability-id id)))

(defn capability-keyword-for-symbol
  "Map a namespaced call head `clock/now` to registered keyword `:clock/now`."
  [op]
  (when (and (symbol? op) (namespace op))
    (let [kw (keyword (namespace op) (name op))]
      (when (contains? capability-registry kw) kw))))

(defn attach-source-operation
  "Preserve reader span and the authored operation name on elaborated forms."
  [form elaborated source-operation]
  (let [location (select-keys (meta form)
                              [:line :column :end-line :end-column :offset :end-offset])
        span (form-span form)
        m (cond-> {:source-operation source-operation}
            (seq location) (merge location)
            span (assoc :span span)
            (meta form) (merge (meta form)))]
    (if (or (coll? elaborated) (symbol? elaborated))
      (with-meta elaborated (merge (meta elaborated) m))
      elaborated)))

#?(:kotoba nil :default (def str-integer-heads tables/str-integer-heads))

#?(:kotoba
   (defn str-integer-form? [env [:ref :fe/env] part [:ref :form/r]] :bool
     (or (form/is-int? part)
         (and (form/is-symbol? part) (form/is-map? (env-types env))
              (form/eq (form/form-get (env-types env) part) (form/keyword-form :i64)))
         (and (form/is-seq? part) (> (form/count-of part) 0)
              (tables/table-has? (env-table env :str-int) (form/nth-of part 0)))))
   :default
(defn str-integer-form?
  "Is PART certainly an i64 without a type inference: an integer literal, a
  parameter or `let` local known as :i64, or an arithmetic form."
  [part]
  (boolean (or (kotoba-integer? part)
               (and (symbol? part) (= :i64 (get *local-types* part)))
               (and (seq? part) (contains? str-integer-heads (first part)))))))

#?(:kotoba
   (defn str-part [env [:ref :fe/env] part [:ref :form/r]] [:ref :fe/dr]
     (if (str-integer-form? env part)
       (let [a (desugar-expr env part)]
         (dr (dr-env a) (form/call1 "__kotoba_string_from_i64" (dr-form a))))
       (desugar-result-expr env (form/keyword-form :string) part)))
   :default
(defn str-part
  "One `str` argument as a :string operand. Clojure's `str` prints an integer
  as its decimal digits, so an integer literal, a parameter typed :i64 and an
  arithmetic form are wrapped in `string-from-i64`; everything else must
  already be a string and fails closed at type check as it always did."
  [part]
  (if (str-integer-form? part)
    (list string-from-i64-helper-name (desugar-expr part))
    (desugar-result-expr :string part))))

(defn elaborate-named-operation
  "W1 safety elaboration validates an ordinary namespaced operation and keeps
  it named until parameter/result types are available. The later contextual
  elaboration pass lowers it to `typed-cap-call`; authors never write numeric
  capability IDs, type envelopes, or portable-effect envelopes."
  [form op kw args]
  (when-not (= 1 (count args))
    (reject! (str "named operation " (pr-str op)
                  " requires exactly one request value")
             form))
  (let [_ (resolve-capability-keyword! kw form)
        elaborated (list op (desugar-expr (first args)))]
    (attach-source-operation form elaborated kw)))

(defn desugar-list [args form]
  (when (> (count args) max-list-items)
    (reject! "list item count exceeds admission limit" form))
  (if (canonical-list-type? *contextual-closure-result-type*)
    (let [type *contextual-closure-result-type*
          item-type (second type)]
      (apply list 'typed-list-new type
             (map #(desugar-expected-value item-type %) args)))
    (reduce (fn [tail item] (list 'pair (desugar-expr item) tail))
            0 (reverse args))))

;; Synthesized `let` temporaries for `and` / `or` / comparison chains.
;;
;; These used to be `gensym`, which made the emitted KIR different on every
;; compile: the same source produced `and-tmp__11125` in one run and
;; `and-tmp__11129` in the next, because the counter is process-global and
;; depends on how much compiled before it. Anything that compares precompiled
;; KIR therefore could not use `and`/`or` at all -- measured in
;; kotoba-lang/murakumo, whose `infer_schedule_core.kotoba` says in a comment:
;;
;;   Nested `if` (not `and`/`or`) so the precompiled KIR is gensym-stable for
;;   the drift gate.
;;
;; That is language profile 5's headline ergonomics being unavailable in exactly
;; the code that most wants them. A deterministic name fixes it: the name is a
;; function of the chain position, so the same source always yields the same KIR.
;;
;; Capture is prevented by construction rather than by luck: the names live under
;; the reserved `__kotoba_` prefix, which `reject-reserved-binding!` now refuses
;; in any user binding or parameter position. Shadowing between nested chains is
;; harmless anyway -- a temp is read only in its own `if` test and else branch,
;; both outside any inner binding -- but relying on that alone would leave a real
;; program able to capture one by writing the name.
#?(:kotoba
   (defn chain-temp [prefix :string depth :i64] [:ref :form/r]
     (form/symbol-form (string-concat "__kotoba_" (string-concat prefix (string-concat "_" (string-from-i64 depth))))))
   :default
(defn chain-temp [prefix depth]
  (symbol (str "__kotoba_" prefix "_" depth))))

;; ARGS are the forms of FORM from index I
#?(:kotoba
   (defn desugar-and [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 1))
         (= n 1) (desugar-bool-expr env (form/nth-of form i))
         :else (let [tmp (chain-temp "and" n)
                     a (desugar-bool-expr env (form/nth-of form i))
                     b (desugar-and (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 tmp (dr-form a))
                                 (form/call3 "if" tmp (dr-form b) tmp)))))))
   :default
(defn desugar-and
  "`(and a b c ...)` -> nested `let`/`if`, ported from kotoba-lang/kotoba's
  runtime.clj `desugar-and` (verified live there, ADR-2607150000): binds
  each argument's value once (never re-evaluated) and branches on it.
  `(and)` is vacuously truthy (1); `(and a)` is just a."
  [args]
  (cond
    (empty? args) 1
    (empty? (rest args)) (desugar-bool-expr (first args))
    :else (let [tmp (chain-temp "and" (count args))]
            (list 'let [tmp (desugar-bool-expr (first args))]
                  (list 'if tmp (desugar-and (rest args)) tmp))))))

#?(:kotoba
   (defn desugar-or [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 0))
         (= n 1) (desugar-bool-expr env (form/nth-of form i))
         :else (let [tmp (chain-temp "or" n)
                     a (desugar-bool-expr env (form/nth-of form i))
                     b (desugar-or (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 tmp (dr-form a))
                                 (form/call3 "if" tmp tmp (dr-form b))))))))
   :default
(defn desugar-or
  "Mirror of desugar-and for `(or a b c ...)`. `(or)` is vacuously falsy
  (0); `(or a)` is just a."
  [args]
  (cond
    (empty? args) 0
    (empty? (rest args)) (desugar-bool-expr (first args))
    :else (let [tmp (chain-temp "or" (count args))]
            (list 'let [tmp (desugar-bool-expr (first args))]
                  (list 'if tmp tmp (desugar-or (rest args))))))))

#?(:kotoba
   (defn desugar-cond [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 0 (rem (argc form) 2)) "cond requires test/result pairs" "kotoba.error/cond-pairs" form)]
       (desugar-cond-lower env form 1)))
   :default
(defn desugar-cond
  "Lowers `(cond test value ... :else fallback)` to the already admitted
  nested `if` core. Tests retain left-to-right, at-most-once evaluation.
  `:else` is syntax here, not a runtime keyword value, and must be last so
  unreachable clauses cannot be hidden accidentally. An empty cond has the
  profile's ordinary false/nil sentinel value, 0."
  [args form]
  (when (odd? (count args))
    (reject! "cond requires test/result pairs" form :kotoba.error/cond-pairs))
  (letfn [(lower [clauses]
            (if (empty? clauses)
              0
              (let [[test result & remaining] clauses
                    value (fn [x] (if (nil? x) '(__kotoba_absent :nil) (desugar-expr x)))]
                (if (= :else test)
                  (do (when (seq remaining)
                        (reject! "cond :else clause must be last" form))
                      (value result))
                  (list 'if (desugar-bool-expr test)
                        (value result)
                        ;; no :else is absence (`absence-type`); an empty
                        ;; cond stays the 0 it always was
                        (if (seq remaining) (lower remaining) (absence-marker-form)))))))]
    (lower args))))

#?(:kotoba
   (defn desugar-condp [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 2) "condp requires a predicate and dispatch expression"
                        "kotoba.error/subset-reject" form)
           predicate (arg form 0)
           _ (require-k (simple-symbol-form? predicate) "condp predicate must be an unqualified function symbol"
                        "kotoba.error/subset-reject" form)
           _ (require-k (not (condp-has-arrow? form 3)) "condp :>> clauses are not supported by this portable profile"
                        "kotoba.error/subset-reject" form)
           clauses (- (argc form) 2)
           default? (= 1 (rem clauses 2))
           end (if default? (- (form/count-of form) 1) (form/count-of form))
           t (synthetic env "condp")
           tmp (dr-form t)
           disp (desugar-expr (dr-env t) (arg form 1))
           dflt (desugar-expr (dr-env disp) (condp-default-form form default?))
           folded (condp-fold (dr-env dflt) predicate tmp form 3 end (dr-form dflt))]
       (dr (dr-env folded) (form/call2 "let" (form/vec2 tmp (dr-form disp)) (dr-form folded)))))
   :default
(defn desugar-condp
  "Lowers the portable `(condp predicate dispatch test result ... default?)`
  subset to a single dispatch binding and left-to-right nested `if` calls.
  The predicate must be a statically resolvable, unqualified two-argument
  function symbol. Clojure's `:>>` extension is deliberately outside this
  bounded slice. With no default, a miss traps like `case`."
  [args form]
  (when (< (count args) 2)
    (reject! "condp requires a predicate and dispatch expression" form))
  (let [[predicate dispatch & clauses] args]
    (when-not (and (symbol? predicate) (nil? (namespace predicate)))
      (reject! "condp predicate must be an unqualified function symbol" form))
    (when (first-truthy #{:>>} clauses)
      (reject! "condp :>> clauses are not supported by this portable profile" form))
    (let [default? (odd? (count clauses))
          default (if default? (last clauses) '(quot 1 0))
          pairs (partition 2 (if default? (butlast clauses) clauses))
          tmp (synthetic "condp")]
      (list 'let [tmp (desugar-expr dispatch)]
            (reduce (fn [fallback [test result]]
                      (list 'if
                            (desugar-bool-expr
                             (list predicate (desugar-expr test) tmp))
                            (desugar-expr result)
                            fallback))
                    (desugar-expr default)
                    (reverse pairs)))))))

#?(:kotoba
   (defn desugar-cond-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (and (> (argc form) 0) (= 0 (rem (- (argc form) 1) 2)))
                        (string-concat (if last? "cond->>" "cond->") " requires an initial value followed by test/form pairs")
                        "kotoba.error/subset-reject" form)
           init (desugar-expr env (arg form 0))]
       (cond-thread-steps (dr-env init) (dr-form init) form 2 last?)))
   :default
(defn desugar-cond-thread [args form last?]
  (when (or (empty? args) (odd? (count (rest args))))
    (reject! (str (if last? "cond->>" "cond->")
                  " requires an initial value followed by test/form pairs") form))
  (reduce (fn [value [test step]]
            (when-not (and (seq? step) (symbol? (first step)))
              (reject! (str (if last? "cond->>" "cond->")
                            " update must be a non-empty call form") step))
            (let [tmp (synthetic "cond-thread")
                  threaded (thread-form tmp step last?)]
              (list 'let [tmp value]
                    (list 'if (desugar-bool-expr test)
                          (desugar-expr threaded)
                          tmp))))
          (desugar-expr (first args))
          (partition 2 (rest args)))))

(defn desugar-dotimes [args form]
  (let [[binding & body] args]
    (when-not (and (vector? binding) (= 2 (count binding))
                   (symbol? (first binding)) (nil? (namespace (first binding))))
      (reject! "dotimes requires [unqualified-symbol count]" form))
    (let [[index count-form] binding
          limit (synthetic "dotimes-limit")
          iteration (list* 'do (concat body [(list 'recur (list '+ index 1))]))]
      (desugar-expr
       (list 'let [limit count-form]
             (list 'loop [index 0]
                   (list 'if (list '< index limit) iteration 0)))))))

(defn desugar-doseq [args form]
  (let [[binding & body] args]
    (when-not (vector? binding)
      (reject! "doseq requires a binding vector" form))
    (letfn [(valid-item? [item]
              (and (symbol? item) (nil? (namespace item))))
            (parse-modifier [modifier modifier-value]
              (case modifier
                :let
                (do
                  (when-not (and (vector? modifier-value)
                                 (even? (count modifier-value))
                                 (every? valid-item? (take-nth 2 modifier-value))
                                 (= (count (take-nth 2 modifier-value))
                                    (count (distinct (take-nth 2 modifier-value)))))
                    (reject! "doseq :let requires unique unqualified symbol/value bindings"
                             form))
                  [:let modifier-value])
                :when [:when modifier-value]
                :while [:while modifier-value]
                (reject! "doseq supports only :let, :when, and :while modifiers"
                         form)))
            (pair-sequence-form? [collection]
              (and (seq? collection)
                   (contains? #{'list 'cons 'rest
                                '__kotoba_pair_sequence}
                              (first collection))))
            (parse-groups []
              (loop [tokens (seq binding) groups [] current nil]
                (cond
                  (nil? tokens)
                  (cond-> groups current (conj current))

                  (nil? current)
                  (let [item (first tokens)
                        collection (second tokens)]
                    (when-not (and (valid-item? item) (next tokens))
                      (reject! "doseq requires [unqualified-symbol collection] binding pairs"
                               form))
                    (recur (nnext tokens) groups
                           {:item item
                            :collection collection
                            :pair-sequence? (pair-sequence-form? collection)
                            :modifiers []}))

                  (keyword? (first tokens))
                  (do
                    (when-not (next tokens)
                      (reject! "doseq modifiers require keyword/value pairs" form))
                    (recur (nnext tokens) groups
                           (update current :modifiers conj
                                   (parse-modifier (first tokens) (second tokens)))))

                  (valid-item? (first tokens))
                  (recur tokens (conj groups current) nil)

                  :else
                  (reject! "doseq requires binding pairs separated only by :let/:when/:while modifiers"
                           form))))
            (lower-group [{:keys [item collection modifiers pair-sequence?]}
                          group-body limit]
              (let [iteration-signal
                    (reduce
                     (fn [inner [modifier modifier-value]]
                       (case modifier
                         :let (list 'let modifier-value inner)
                         :when (list 'if modifier-value inner 1)
                         :while (list 'if modifier-value inner 0)))
                     (list* 'do (concat group-body [1]))
                     (reverse modifiers))
                    values (synthetic "doseq-values")
                    length (synthetic "doseq-length")
                    block-signal
                    (fn [indices]
                      (reduce
                       (fn [continuation index]
                         (list 'if (list '< index length)
                               (list 'if
                                     (list 'let
                                           [item (list 'vector-at values index)]
                                           iteration-signal)
                                     continuation
                                     0)
                               1))
                       1
                       (reverse indices)))
                    blocks (map block-signal (partition-all 16 (range limit)))
                    unrolled
                    (reduce (fn [continuation block]
                              (list 'if block continuation 0))
                            0
                            (reverse blocks))
                    pair-unrolled
                    ((fn step [index cursor-expr]
                       (let [cursor (synthetic "doseq-cursor")]
                         (list 'let [cursor cursor-expr]
                               (if (= index limit)
                                 (list 'if (list '= cursor 0)
                                       0
                                       (list 'quot 1 0))
                                 (let [next-cursor (synthetic "doseq-next")]
                                   (list 'if (list '= cursor 0)
                                         0
                                         (list 'let
                                               [next-cursor
                                                (list 'pair-second cursor)]
                                               (list 'if
                                                     (list 'let
                                                           [item (list 'pair-first cursor)]
                                                           iteration-signal)
                                                     (step (inc index) next-cursor)
                                                     0))))))))
                     0 values)
                    bounded
                    (if pair-sequence?
                      pair-unrolled
                      (if (< limit value/vector-literal-item-limit)
                        (list 'if (list '< limit length)
                              (list 'quot 1 0)
                              unrolled)
                        unrolled))]
                (list 'let [values (if (and pair-sequence?
                                            (seq? collection)
                                            (= '__kotoba_pair_sequence
                                               (first collection)))
                                     (second collection)
                                     collection)]
                      (if pair-sequence?
                        bounded
                        (list 'let [length (list 'vector-count values)]
                              bounded)))))]
      (let [groups (parse-groups)
            group-count (count groups)]
        (when-not (<= 1 group-count 4)
          (reject! "doseq supports at most four collection bindings"
                   form))
        (let [lowered
              (reduce (fn [inner group]
                        (lower-group group [inner]
                                     (cond
                                       (= 4 group-count) 2
                                       (= 3 group-count) 4
                                       (= 2 group-count) 16
                                       (:pair-sequence? group) 32
                                       :else value/vector-literal-item-limit)))
                      (list* 'do (concat body [0]))
                      (reverse groups))]
          (desugar-expr lowered))))))

#?(:kotoba
   (defn thread-form [value [:ref :form/r] step [:ref :form/r] last? :bool] [:ref :form/r]
     (cond
       (form/is-symbol? step) (form/call1 (form/symbol-value step) value)
       (and (form/is-seq? step) (> (form/count-of step) 0) (form/is-symbol? (form/nth-of step 0)))
       (if last?
         (form/form-seq (form/cons-onto (form/nth-of step 0) (form/append-form (form/rest-list step) value)))
         (form/form-seq (form/cons-onto (form/nth-of step 0) (form/cons-onto value (form/rest-list step)))))
       :else (throw (fe-reject "thread step must be a symbol or non-empty call" "kotoba.error/subset-reject" step))))
   :default
(defn thread-form [value step last?]
  (cond
    (symbol? step) (list step value)
    (and (seq? step) (symbol? (first step)))
    (if last?
      (apply list (first step) (concat (rest step) [value]))
      (list* (first step) value (rest step)))
    :else (reject! "thread step must be a symbol or non-empty call" step))))

#?(:kotoba
   (defn desugar-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) (if last? "->> requires an initial value" "-> requires an initial value")
                        "kotoba.error/subset-reject" form)
           v (thread-steps (arg form 0) form 2 last?)]
       (desugar-expr env v)))
   :default
(defn desugar-thread [args form last?]
  (when (empty? args)
    (reject! (if last? "->> requires an initial value" "-> requires an initial value") form))
  (desugar-expr (reduce #(thread-form %1 %2 last?) (first args) (rest args)))))

#?(:kotoba
   (defn desugar-as-thread [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (simple-symbol-form? (arg form 1)))
                        "as-> requires an initial value, an unqualified binding symbol, and optional forms"
                        "kotoba.error/subset-reject" form)]
       (desugar-expr env (as-thread-steps (arg form 0) (arg form 1) form 3))))
   :default
(defn desugar-as-thread [args form]
  (let [[initial name & steps] args]
    (when-not (and (<= 2 (count args)) (symbol? name) (nil? (namespace name)))
      (reject! "as-> requires an initial value, an unqualified binding symbol, and optional forms" form))
    (desugar-expr
     (reduce (fn [value step] (list 'let [name value] step))
             initial steps)))))

#?(:kotoba
   (defn resolve-option-type [env [:ref :fe/env] v [:ref :form/r]] [:ref :form/r]
     (let [fallback (form/vec2 (form/keyword-form :option) (form/keyword-form :i64))]
       (cond
         (and (simple-symbol-form? v) (form/is-map? (record-get [:ref :fe/env] env :options)))
         (form/form-get (record-get [:ref :fe/env] env :options) v)
         (and (form/is-seq? v) (> (form/count-of v) 0)
              (or (head-is? v "option-some-of") (head-is? v "option-none-of") (head-is? v "option-some?-of")
                  (head-is? v "option-value-of") (head-is? v "option-match"))
              (option-descriptor? (form/nth-of v 1)))
         (form/nth-of v 1)
         (head-is? v "record-get")
         (let [n (argc v)
               ft (cond
                    (and (= 3 n) (form/is-keyword? (arg v 2)))
                    (record-field-type (arg v 0) (arg v 2) (env-schemas env))
                    (and (= 2 n) (form/is-symbol? (arg v 0)) (form/is-keyword? (arg v 1)) (form/is-map? (env-types env)))
                    (record-field-type (form/form-get (env-types env) (arg v 0)) (arg v 1) (env-schemas env))
                    :else (form/nil-form))]
           (if (option-descriptor? ft) ft fallback))
         :else fallback)))
   :default
(defn resolve-option-type
  "Best-effort option type for sugar lowering (Product Value ABI v1).

  Prefer an explicit typed local (`*local-option-types*`), then syntactic
  constructors `(option-some-of T …)` / `(option-none-of T)`, then
  `(record-get … :field)` when the field is itself `[:option T]` (T5.2
  option-string-in-record). Fall back to `[:option :i64]` only for legacy
  monomorphic option-i64 paths."
  [value-form]
  (cond
    (and (symbol? value-form) (nil? (namespace value-form))
         (map? *local-option-types*))
    (get *local-option-types* value-form)

    (and (seq? value-form)
         (contains? '#{option-some-of option-none-of option-some?-of
                       option-value-of option-match}
                    (first value-form))
         (vector? (second value-form))
         (= :option (first (second value-form))))
    (second value-form)

    ;; `(record-get TYPE value field)` (post rewrite) or
    ;; `(record-get value field)` (pre rewrite, typed local).
    (and (seq? value-form)
         (= 'record-get (first value-form)))
    (let [args (vec (rest value-form))
          field-type
          (cond
            (and (= 3 (count args)) (keyword? (nth args 2)))
            (record-field-type (nth args 0) (nth args 2))

            (and (= 2 (count args))
                 (symbol? (nth args 0))
                 (keyword? (nth args 1))
                 (map? *local-types*))
            (record-field-type (get *local-types* (nth args 0)) (nth args 1))

            :else nil)]
      (if (and (vector? field-type) (= :option (first field-type)))
        field-type
        [:option :i64]))

    :else [:option :i64])))

#?(:kotoba
   (defn option-payload-fallback [t [:ref :form/r]] [:ref :form/r]
     (cond
       (form/eq t (form/keyword-form :i64)) (form/int-form 0)
       (form/eq t (form/keyword-form :bool)) (form/bool-form false)
       (form/eq t (form/keyword-form :string)) (form/string-form "")
       (form/eq t (form/keyword-form :keyword)) (form/keyword-form :none)
       (form/eq t (form/keyword-form :f64)) (form/f64-form 0)
       (form/eq t (form/keyword-form :f32)) (form/f64-form 0)
       :else (form/int-form 0)))
   :default
(defn option-payload-fallback
  "Typed bottom value for option-value-of's unused fallback arm.
  Must match payload type so typecheck accepts the if-some lowering."
  [payload-type]
  (cond
    (= payload-type :i64) 0
    (= payload-type :bool) false
    (= payload-type :string) ""
    (= payload-type :keyword) :none
    (= payload-type :f64) 0.0
    (= payload-type :f32) 0.0
    :else 0)))

#?(:kotoba
   (defn desugar-some-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) (if last? "some->> requires an initial option" "some-> requires an initial option")
                        "kotoba.error/subset-reject" form)]
       (some-thread-lower env (arg form 0) form 2 last?)))
   :default
(defn desugar-some-thread
  "`(some-> x s1 s2)` threads while each value is present (ADR 0353 floor
  :absence). A step whose value is an `[:option T]` stops the thread when it
  is absent and passes its payload on; a step whose value is not an option is
  always present. The result is always an option: the last step's value
  wrapped in `option-some-of` unless it already is one, absent if any step
  was. Types decide all three, so this emits the markers
  `__kotoba_some_bind` / `__kotoba_some_last` / `__kotoba_present` and
  `rewrite-record-projection` resolves them once the steps have types."
  [args form last?]
  (when (empty? args)
    (reject! (if last? "some->> requires an initial option" "some-> requires an initial option") form))
  (letfn [(lower [value-form steps]
            (if (empty? steps)
              (list '__kotoba_some_last (desugar-expr value-form))
              (let [tmp (if *loop-counter*
                          (symbol (str "some-thread__" (vswap! *loop-counter* inc)))
                          (synthetic "some-thread"))
                    threaded (thread-form (list '__kotoba_present tmp) (first steps) last?)]
                (list 'let [tmp (desugar-expr value-form)]
                      (list '__kotoba_some_bind tmp (lower threaded (rest steps)))))))]
    (lower (first args) (rest args)))))

#?(:kotoba
   (defn desugar-binding-if [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (let [binding (arg form 0)
           nb (- (form/count-of form) 2)
           _ (require-k (and (form/is-vec? binding) (= 2 (form/count-of binding)))
                        (if when? "when-let requires one binding pair" "if-let requires one binding pair")
                        "kotoba.error/subset-reject" form)
           _ (require-k (if when? (> nb 0) (and (<= 1 nb) (<= nb 2)))
                        (if when? "when-let requires at least one body expression"
                            "if-let requires then and optional else expressions")
                        "kotoba.error/subset-reject" form)
           pattern (form/nth-of binding 0)
           t (synthetic env "binding-if")
           tmp (dr-form t)
           then-form (binding-if-then form when?)
           else-form (binding-if-else env form when?)
           v (desugar-bool-expr (dr-env t) (form/nth-of binding 1))]
       (desugar-expr (dr-env v)
                     (form/call2 "let" (form/vec2 tmp (dr-form v))
                                 (form/call3 "if" tmp
                                             (form/call2 "let" (form/vec2 pattern (form/call1 "__kotoba_present" tmp)) then-form)
                                             else-form)))))
   :default
(defn desugar-binding-if [args form when?]
  (let [[binding & bodies] args]
    (when-not (and (vector? binding) (= 2 (count binding)))
      (reject! (if when? "when-let requires one binding pair"
                           "if-let requires one binding pair") form))
    (when (if when? (empty? bodies) (not (<= 1 (count bodies) 2)))
      (reject! (if when? "when-let requires at least one body expression"
                           "if-let requires then and optional else expressions") form))
    (let [[pattern value] binding
          tmp (synthetic "binding-if")
          then-form (if when?
                      (if (= 1 (count bodies)) (first bodies) (cons 'do bodies))
                      (first bodies))
          else-form (if when? (absence-marker-form)
                        (if (= 2 (count bodies)) (second bodies) (absence-marker-form)))]
      ;; ADR 0353 floor :absence: over an `[:option T]` the test is presence
      ;; and the pattern binds the payload. Which one this is is known only
      ;; once the value has a type, so `rewrite-record-projection` resolves
      ;; `if` and `__kotoba_present` from the inferred type of `tmp`; over a
      ;; `:bool` both are what they always were.
      (desugar-expr
       (list 'let [tmp (desugar-bool-expr value)]
             (list 'if tmp
                   (list 'let [pattern (list '__kotoba_present tmp)] then-form)
                   else-form)))))))

#?(:kotoba
   (defn desugar-binding-some [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (let [binding (arg form 0)
           nb (- (form/count-of form) 2)
           _ (require-k (and (form/is-vec? binding) (= 2 (form/count-of binding)))
                        (if when? "when-some requires one binding pair" "if-some requires one binding pair")
                        "kotoba.error/subset-reject" form)
           _ (require-k (if when? (> nb 0) (and (<= 1 nb) (<= nb 2)))
                        (if when? "when-some requires at least one body expression"
                            "if-some requires then and optional else expressions")
                        "kotoba.error/subset-reject" form)
           pattern (form/nth-of binding 0)
           value (form/nth-of binding 1)
           t (synthetic env "binding-some")
           tmp (dr-form t)
           found (resolve-option-type (dr-env t) value)
           option-type (if (form/is-nil? found) (form/vec2 (form/keyword-form :option) (form/keyword-form :i64)) found)
           th (binding-some-then (dr-env t) form when?)
           else-form (binding-if-else (dr-env th) form when?)
           payload-type (if (option-descriptor? option-type) (form/nth-of option-type 1) (form/nil-form))
           fallback (option-payload-fallback payload-type)
           _ (require-k (option-descriptor? option-type)
                        "if-some/when-some value must have an option type; use match-option with an explicit type or a typed local"
                        "kotoba.error/subset-reject" form)]
       (desugar-expr (dr-env th)
                     (form/call2 "let" (form/vec2 tmp value)
                                 (form/call3 "if" (form/call2 "option-some?-of" option-type tmp)
                                             (form/call2 "let" (form/vec2 pattern (form/call3 "option-value-of" option-type tmp fallback))
                                                         (dr-form th))
                                             else-form)))))
   :default
(defn desugar-binding-some [args form when?]
  (let [[binding & bodies] args]
    (when-not (and (vector? binding) (= 2 (count binding)))
      (reject! (if when? "when-some requires one binding pair"
                           "if-some requires one binding pair") form))
    (when (if when? (empty? bodies) (not (<= 1 (count bodies) 2)))
      (reject! (if when? "when-some requires at least one body expression"
                           "if-some requires then and optional else expressions") form))
    (let [[pattern value] binding
          ;; Deterministic, like every other synthesized temp. This was already
          ;; deterministic but kept the old `binding-some__N` shape, which has
          ;; two costs: it still matches the `.+__\d+` gensym pattern, so the
          ;; conformance digest normalized it away and could not see a change in
          ;; it; and it borrowed `*loop-counter*`, so adding or removing a
          ;; `loop` renumbered it for no reason.
          tmp (synthetic "binding-some")
          option-type (or (resolve-option-type value) [:option :i64])
          then-form (if when?
                      (if (= 1 (count bodies)) (first bodies) (desugar-do bodies))
                      (first bodies))
          else-form (if when? (absence-marker-form)
                        (if (= 2 (count bodies)) (second bodies) (absence-marker-form)))
          payload-type (when (and (vector? option-type) (= :option (first option-type)))
                         (second option-type))
          fallback (option-payload-fallback payload-type)]
      (when-not (and (vector? option-type) (= :option (first option-type)))
        (reject! "if-some/when-some value must have an option type; use match-option with an explicit type or a typed local"
                 form))
      (desugar-expr
       (list 'let [tmp value]
             (list 'if (list 'option-some?-of option-type tmp)
                   (list 'let [pattern (list 'option-value-of option-type tmp fallback)]
                         then-form)
                   else-form)))))))

#?(:kotoba
   (defn desugar-case [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "case requires a dispatch expression" "kotoba.error/subset-reject" form)
           clauses (- (argc form) 1)
           default? (= 1 (rem clauses 2))
           end (if default? (- (form/count-of form) 1) (form/count-of form))
           _ (require-k (case-constants-ok? form 2 end)
                        "case constants must be bounded integer, keyword, boolean, or string literals"
                        "kotoba.error/subset-reject" form)
           _ (require-k (all-distinct? (case-constants form 2 end (form/no-forms)) 0)
                        "case constants must be unique" "kotoba.error/subset-reject" form)
           t (synthetic env "case")
           tmp (dr-form t)
           disp (desugar-expr (dr-env t) (arg form 0))
           dflt (desugar-expr (dr-env disp) (condp-default-form form default?))
           folded (case-fold (dr-env dflt) tmp form 2 end (dr-form dflt))]
       (dr (dr-env folded) (form/call2 "let" (form/vec2 tmp (dr-form disp)) (dr-form folded)))))
   :default
(defn desugar-case [args form]
  (when (empty? args) (reject! "case requires a dispatch expression" form))
  (let [[dispatch & clauses] args
        default? (odd? (count clauses))
        default (if default? (last clauses) '(quot 1 0))
        pairs (partition 2 (if default? (butlast clauses) clauses))
        groups (map first pairs)
        constants (mapcat #(if (seq? %) % [%]) groups)
        literal? #(or (kotoba-integer? %) (keyword? %) (boolean? %) (string? %))]
    (when-not (every? literal? constants)
      (reject! "case constants must be bounded integer, keyword, boolean, or string literals" form))
    (when-not (all-distinct? constants)
      (reject! "case constants must be unique" form))
    (let [tmp (synthetic "case")]
      (list 'let [tmp (desugar-expr dispatch)]
            (reduce (fn [fallback [group result]]
                      (let [members (if (seq? group) group [group])
                            test (if (= 1 (count members))
                                   (list '= tmp (desugar-expr (first members)))
                                   (desugar-or
                                    (map #(list '= tmp (desugar-expr %)) members)))]
                        (list 'if test
                              (desugar-expr result) fallback)))
                    (desugar-expr default)
                    (reverse pairs)))))))

;; ARGS are the forms of FORM from index I
#?(:kotoba
   (defn desugar-comparison-chain [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)
           _ (require-k (or (string=? (form/symbol-value op) "=") (> n 0))
                        "ordered comparison requires at least one operand" "kotoba.error/subset-reject" form)]
       (if (= n 0)
         (dr env (form/bool-form true))
         (let [left (chain-temp "cmp" (+ n 1))
               a (desugar-expr env (form/nth-of form i))
               b (comparison-chain-rest (dr-env a) op left form (+ i 1))]
           (dr (dr-env b)
               (form/call2 "let" (form/vec2 left (dr-form a)) (dr-form b)))))))
   :default
(defn desugar-comparison-chain [op args form]
  (when (and (not= op '=) (empty? args))
    (reject! "ordered comparison requires at least one operand" form))
  ;; Comparisons are `:bool`-typed, so a chain folds to `true`/`false` rather
  ;; than 1/0 — otherwise the chain is an i64 that cannot compose with `and`,
  ;; `or`, `not` or another comparison.
  (letfn [(chain [left remaining]
            (if (empty? remaining)
              true
              (let [right (chain-temp "cmp" (count remaining))]
                (list 'let [right (desugar-expr (first remaining))]
                      (list 'if (list op left right)
                            (chain right (rest remaining)) false)))))]
    (if (empty? args)
      true
      (let [left (chain-temp "cmp" (inc (count args)))]
        (list 'let [left (desugar-expr (first args))]
              (chain left (rest args))))))))


#?(:kotoba
   (defn desugar-do [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 0))
         (= n 1) (desugar-expr env (form/nth-of form i))
         :else (let [t (synthetic env "do-tmp")
                     a (desugar-expr (dr-env t) (form/nth-of form i))
                     b (desugar-do (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 (dr-form t) (dr-form a)) (dr-form b)))))))
   :default
(defn desugar-do
  "ADR-2607180900 L2: `(do a b c)` -> nested `let` returning last expression."
  [args]
  (cond
    (empty? args) 0
    (empty? (rest args)) (desugar-expr (first args))
    :else (let [tmp (synthetic "do-tmp")]
            (list 'let [tmp (desugar-expr (first args))]
                  (desugar-do (rest args)))))))

(defn f64-literal-key?
  "A floating literal in either of its two read forms: a host double on `:clj`,
  and the JVM-free reader's exact-bits `(f64-from-bits <i64>)` on `:cljs`."
  [form]
  (or (value/f64-value? form)
      (and (seq? form)
           (true? (:kotoba.reader/f64-literal (meta form))))))

#?(:kotoba nil :default (def map-literal-value-constructors tables/map-literal-value-constructors))

(defn map-literal-value-type
  "The value type a literal's VALUE expression determines ON ITS OWN, or `nil`
  when it is an arbitrary expression whose type only inference can know.

  This is the map-value analogue of `closed-vector-literal-type`, and it is
  deliberately syntactic: `desugar-map` runs before inference, so the only
  types available here are the ones the source spells out. Floating literals
  are recognized so they can be refused BY NAME (see `desugar-map`) rather
  than reaching the generic arm."
  [form]
  (cond
    (boolean? form) :bool
    (kotoba-integer? form) :i64
    (string? form) :string
    (keyword? form) :keyword
    (f64-literal-key? form) :f64
    (seq? form)
    (let [head (first form)]
      (cond
        (= 'f64-from-bits head) :f64
        (= 'f32-from-bits head) :f32
        :else
        (let [declared (get map-literal-value-constructors head)
              descriptor (second form)]
          (when (and declared (vector? descriptor) (seq descriptor)
                     (= declared (first descriptor)))
            descriptor))))
    :else nil))

(defn map-literal-type-description
  "A value type said the way the SOURCE says it, for a refusal message --
  `:string`, not `string`. The refusal names `typed-map-new` as the way to
  write the map the program wanted, and a reader has to be able to paste the
  type into it; `(name :string)` would print a descriptor that does not read."
  [type]
  (pr-str type))

(defn map-literal-key-description-for-message
  "Which ENTRY a refusal is about. A Clojure map literal has no positions, so
  the entry is named by its key -- which is what the reader wrote, and what
  the canonical order is keyed on.

  An integer key goes through `str` and not `pr-str`, because a `.kotoba`
  integer literal is a JS bigint under `:cljs` and `pr-str` renders that as
  `#object[BigInt 1]`. Measured 2026-09-03: the first draft used `pr-str` for
  every key, was green on the JVM, and printed `map literal value at key
  #object[BigInt 1] ...` under nbb -- the SAME refusal saying two different
  things on the two runtimes this file claims. A string key keeps `pr-str`,
  which is what puts the quotes on."
  [key]
  (if (kotoba-integer? key) (str key) (pr-str key)))

(defn map-literal-key-kind [key]
  (cond (keyword? key) :keyword
        (kotoba-integer? key) :i64
        (string? key) :string
        :else nil))

(defn map-literal-key-description
  "What a refused key IS, said in source terms. `(pr-str key)` alone would
  print `1.5` for a JVM double and `(f64-from-bits …)` for the same literal
  read JVM-free, so the KIND is named rather than the value shown."
  [key]
  (cond (f64-literal-key? key) "floating point"
        (boolean? key) "boolean"
        (seq? key) "expression"
        (symbol? key) "symbol"
        (vector? key) "vector"
        (map? key) "map"
        (set? key) "set"
        (nil? key) "nil"
        :else "unrecognized"))

(defn map-literal-item-type
  "The VALUE type of a bounded map literal, read off its own value expressions.

  A literal carries no annotation, so this is the only place the value half
  can come from. Every value whose type the source spells out has to agree on
  ONE type; values whose type only inference can know (an ordinary call, a
  local, an arithmetic form) contribute nothing here and are checked against
  the agreed type afterwards, exactly as they were checked against `:i64`
  before. A literal with no typed value at all keeps `:i64`, so an all-unknown
  literal lowers to the descriptor it always lowered to.

  Three refusals happen here rather than downstream, because downstream has
  only a type mismatch to report and this has the reason:

  * a FLOATING value, refused on the structured scalar ABI. This is NOT the
    floating-KEY refusal wearing a different hat. A key needs a total order
    and a decidable identity, and a float has neither; a value needs neither,
    and is refused only because `[:map K :f64]` has no encoding --
    `kotoba.kir.value/validate-value-type!` throws
    \"direct floating map keys or values are outside the structured scalar
    ABI\" for it, measured. The two facts are said as two messages.
  * DISAGREEING value types, naming both types and both entries.
  KEYWORD keys never reach this function: their literal is typed by
  `keyword-map-literal-record-fields` (a legacy pair map when every spelled
  value is `:i64`, a closed record otherwise), which is why the two float
  refusals below stay the typed map's alone -- a record field HAS an `:f64`
  encoding."
  [kind entries]
  (let [typed (vec (keep (fn [[k v]]
                           (when-let [t (map-literal-value-type v)] [k t]))
                         entries))
        floating (first (filter (fn [[_ t]] (contains? #{:f32 :f64} t)) typed))]
    (when floating
      (let [[k t] floating]
        (reject! (str "map literal value at key "
                      (map-literal-key-description-for-message k)
                      " is a floating point literal: map value type " t
                      " is outside the structured scalar ABI. This is the "
                      "ABI's refusal and not the floating-key one -- a value "
                      "needs neither a total order nor a decidable identity, "
                      "and is refused because the typed map's value slot has "
                      "no floating encoding")
                 entries :kotoba.error/floating-map-kv)))
    (if-let [[first-key first-type] (first typed)]
      ;; `=` rather than `distinct`: a value type may be a descriptor
      ;; vector, and hashing is not something both runtimes agree on for
      ;; every literal shape (`run-tests.cljk` records the `desugar-case`
      ;; bigint hashing defect that taught this).
      (if-let [[other-key other-type]
               (first (remove (fn [[_ t]] (= t first-type)) (rest typed)))]
        (reject! (str "map literal values must all be one type; the value "
                      "at key "
                      (map-literal-key-description-for-message first-key)
                      " is " (map-literal-type-description first-type)
                      " and the value at key "
                      (map-literal-key-description-for-message other-key)
                      " is " (map-literal-type-description other-type))
                 entries :kotoba.error/map-literal-value)
        first-type)
      :i64)))

(defn map-literal-record-field-type
  "The field type ONE value of a keyword-keyed literal determines on its own,
  or `nil` for an expression whose type only inference can know.

  This is `map-literal-value-type` plus the two literal shapes a config map
  actually nests -- a vector literal (through `closed-vector-literal-type`,
  the same reading a bare vector gets) and a map literal (through the type
  the nested literal itself lowers to)."
  [form]
  (cond
    (map? form) (map-literal-lowered-type form)
    (vector? form) (closed-vector-literal-type form)
    :else (map-literal-value-type form)))

(defn keyword-map-literal-record-fields
  "The fields of the closed record a keyword-keyed literal lowers to, or
  `nil` when the literal stays the legacy untagged pair map.

  The rule is one predicate: does any value SPELL a type other than `:i64`?
  If none does -- every value is an integer literal or an expression whose
  type only inference can know -- the literal is the pair map it always was,
  byte for byte, and its definition CID does not move. If any does, the
  literal is a closed record: keyword keys only (`desugar-map` has already
  refused a mixed key kind by name), the key set closed, at most
  `max-record-fields` entries, fields in the same total order the pair map's
  entries are emitted in. A value that spells no type takes `:i64`, which is
  `:not-spelled :i64` from the typed-keyed literal applied unchanged, and is
  checked against that by `record-new`'s own inference afterwards.

  Two refusals are BY NAME here because downstream has only a shape to report:

  * `nil`, which has no value type. An absent field is an `[:option T]` and
    is spelled as one.
  * more than `max-record-fields` entries -- the bound `defrecord` has."
  [form entries]
  (let [typed (mapv (fn [[k v]] [k (map-literal-record-field-type v)]) entries)]
    ;; ADR 0353 floor :absence -- `nil` as a value SPELLS a record: it makes
    ;; that field an absent `[:option T]`, so a literal holding one is never
    ;; the i64 pair map (where `nil` used to lower to a legacy `option-i64`
    ;; and fail as `expected i64`). With no record type in context, T is
    ;; unknown, and that is refused by name: the literal's own source does not
    ;; say what the field holds when it is present.
    (when-let [[k _] (first (filter (fn [[_ v]] (nil? v)) entries))]
      (reject! (str "map literal value at key "
                    (map-literal-key-description-for-message k)
                    " is nil, which makes the field an absent [:option T], and "
                    "nothing here says T: give the literal a record type from "
                    "context (a declared record result, or a record field) or "
                    "write (option-none-of [:option T])")
               form :kotoba.error/map-literal-value))
    (when (first-truthy (fn [[_ t]] (and (some? t) (not= :i64 t))) typed)
      (when (> (count entries) max-record-fields)
        (reject! (str "map literal with keyword keys and a non-i64 value lowers "
                      "to a closed record and exceeds the record field limit: "
                      (count entries) " entries, at most " max-record-fields)
                 form :kotoba.error/map-literal-value))
      (mapv (fn [[k t]] [k (or t :i64)]) typed))))

(defn map-literal-lowered-type
  "The type a map literal will lower to, read off its source alone -- what a
  NESTED literal contributes as a record field type. `nil` when the key set
  is not one admitted kind; the nested literal's own `desugar-map` then
  refuses it by name, and this function never has to say it twice."
  [form]
  (let [kinds (into #{} (map map-literal-key-kind) (keys form))
        kind (or (first kinds) :keyword)]
    (when (and (not (contains? kinds nil)) (<= (count kinds) 1))
      (let [entries (sort-by key (map-literal-key-order kind) form)]
        (if (= :keyword kind)
          (if-let [fields (keyword-map-literal-record-fields form entries)]
            (map-literal-record-type fields)
            :map)
          [:map kind (map-literal-item-type kind entries)])))))

(defn desugar-map-against-record
  "ADR 0353 floor :absence (narrows ADR 0028's \"no truthiness\" to presence).
  A keyword-keyed literal whose context already names a record lowers to THAT
  record, in its field order, instead of an anonymous one read off the
  literal. This is where `nil` gets its meaning: a field whose declared type
  is `[:option T]` and whose literal value is `nil` -- or whose key is left
  out -- is absent, `(option-none-of [:option T])`. Every other field is
  checked against its declared type as the value it is.

  Refused by name, because each is a different mistake: a key the record does
  not have, and a non-option field that is `nil` or left out (only an option
  can be absent -- `nil` is never a number, string or record)."
  [form record]
  (let [fields (nth record 2)
        field-names (set (map first fields))
        record-name (second record)]
    (when-let [extra (first (remove field-names (sort-by str (keys form))))]
      (reject! (str "map literal key " (map-literal-key-description-for-message extra)
                    " is not a field of record " record-name)
               form :kotoba.error/map-literal-value))
    (list* 'record-new record
           (map (fn [[field field-type]]
                  (let [value (get form field ::absent)]
                    (if (or (= ::absent value) (nil? value))
                      (if (generic-option-type? field-type)
                        (list 'option-none-of field-type)
                        (reject! (str "map literal field "
                                      (map-literal-key-description-for-message field)
                                      " of record " record-name " is "
                                      (pr-str field-type)
                                      ", which is not an option, so it cannot be absent"
                                      (if (= ::absent value) " (the key is left out)" " (its value is nil)")
                                      "; only an [:option T] field is absent")
                                 form :kotoba.error/map-literal-value))
                      (desugar-expected-value field-type value))))
                fields))))

(defn desugar-map
  "Lower a bounded literal into an owned map KIR operation.

  KEYWORD keys keep the legacy untagged pair-map (`map-new`) they have always
  had, byte for byte -- that is the representation `map-get` / `map-assoc` and
  every `match` map pattern are written against.

  `:i64` and `:string` keys lower to the canonical typed map instead. Until
  2026-09-02 they were refused here (`map keys must be bounded keywords`) and
  `kotoba-lang`'s stdlib recorded `frequencies` and `get-in` as unwritable for
  exactly that reason, even though `typed-map-new` had been generic in its key
  type the whole time -- the refusal was in the LITERAL, not in the map.

  The VALUE half was the same defect one layer over. It was fixed at `:i64`
  here, so `{1 \"a\"}` was refused with `expression type mismatch: expected
  i64, got string` -- a generic type error on a program that reads correct --
  while `(typed-map-new [:map :i64 :string] 1 \"a\")` had worked the whole time.
  Measured 2026-09-03 on sema df383ba0: the canonical surface already carried
  `:string`, `:bool`, `:keyword`, record, nested-map, heterogeneous-vector and
  typed-set values through `typed-map-new`, `typed-map-get`, `assoc`,
  `dissoc`, `contains?` and `typed-map-entry-at`, and
  `kotoba.kir.value/bounded-typed-value!` validated every one of them. Only
  the literal was pinned. `map-literal-item-type` now reads the value type off
  the literal's own value expressions.

  KEYWORD keys with a value that SPELLS a non-i64 type lower to a closed
  record instead (`keyword-map-literal-record-fields`): `{:runtime :nbb
  :compiler \"amu\" :ok? true}` is `(record-new [:record
  :kotoba.map-literal/compiler+ok?+runtime [[:compiler :string] [:ok? :bool]
  [:runtime :keyword]]] \"amu\" true :nbb)`, exactly what a `defrecord`
  constructor lowers to, so `(:compiler m)`, `get` and destructuring already
  read it with the field's static type. Until 2026-09-11 that literal was
  refused by name and pointed at `typed-map-new` -- which is homogeneous in V
  and could not have held it either. The refusal described the pair map, not
  a property of the language: `lang/surface-status.edn` carried it as
  `:implemented-partial` / `:keyword-keys :not-inferred`, and the record layer
  underneath already validated every one of these field types (measured
  2026-09-11 on the KIR interpreter: `:string`, `:bool`, `:keyword`, `:f64`,
  `:map`, `:document` fields all construct and project). A keyword-keyed
  literal whose spelled values are ALL `:i64` is untouched, byte for byte.

  Entries are emitted in the key type's total order (`compare-typed-values` in
  `kotoba.kir.value` is the same order the runtime keeps the entry chain in),
  so the KIR is reproducible without hashing identity. A key kind with no
  portable identity is refused BY NAME rather than falling through a generic
  arm, because `1.5` and `:a` fail here for entirely different reasons.

  A keyword-keyed literal in a position whose type is already a record (a
  declared record result, a record field) lowers against THAT record; see
  `desugar-map-against-record`."
  ([form] (desugar-map form nil))
  ([form contextual-type]
  (when (> (count form) max-list-items)
    (reject! "map entry count exceeds admission limit" form))
  (let [kinds (into #{} (map map-literal-key-kind) (keys form))
        context-record (let [t (canonical-closure-result-type contextual-type)]
                         (when (record-type? t) t))]
    (cond
      (and context-record (= #{:keyword} kinds))
      (desugar-map-against-record form context-record)

      (contains? kinds nil)
      (let [offender (first (remove map-literal-key-kind (keys form)))]
        (if (f64-literal-key? offender)
          (reject! (str "map literal keys must be keywords, integers or strings; "
                        "this literal has a floating point key, which has no "
                        "portable key identity -- NaN compares unequal to "
                        "itself, and +0.0 and -0.0 are equal while differing "
                        "in bits, so neither the entry order nor duplicate-key "
                        "detection is decidable")
                   form :kotoba.error/map-literal-key)
          (reject! (str "map literal keys must be keywords, integers or strings; "
                        "this literal has a key of kind: "
                        (map-literal-key-description offender))
                   form :kotoba.error/map-literal-key)))

      (> (count kinds) 1)
      (reject! (str "map literal keys must all be one kind; this literal mixes "
                    (str/join " and " (sort (map name kinds))))
               form :kotoba.error/map-literal-key)

      :else
      (let [kind (or (first kinds) :keyword)
            entries (sort-by key (map-literal-key-order kind) form)]
        (if (= :keyword kind)
          (if-let [fields (keyword-map-literal-record-fields form entries)]
            (list* 'record-new (map-literal-record-type fields)
                   (map (fn [[_ v] [_ field-type]]
                          (desugar-expected-value field-type v))
                        entries fields))
            (apply list 'map-new
                   (mapcat (fn [[k v]] [k (desugar-expr v)]) entries)))
          (let [item-type (map-literal-item-type kind entries)]
            (when (> (count form) max-typed-map-entries)
              (reject! (str "map literal with " (name kind)
                            " keys exceeds the typed map entry limit")
                       form :kotoba.error/map-literal-key))
            (apply list 'typed-map-new [:map kind item-type]
                   (mapcat (fn [[k v]] [k (desugar-expr v)]) entries)))))))))

(defn document-literal-key-frame [text]
  (str (count text) ":" text))

(defn document-literal-sort-key
  "Stable, host-independent ordering used only to make elaborated KIR
  reproducible. Runtime document constructors still own canonical EDN order."
  [form]
  (cond
    (nil? form) "00:nil"
    (boolean? form) (str "01:" form)
    (kotoba-integer? form) (str "02:" form)
    (value/f64-value? form) (str "03:" (value/f64-to-i64-bits form))
    (document-reader-f64-form? form) (str "03:" (second form))
    (string? form) (str "04:" form)
    (keyword? form) (str "05:" form)
    (symbol? form) (str "06:" form)
    (vector? form) (str "07:["
                        (apply str
                               (map #(document-literal-key-frame
                                      (document-literal-sort-key %))
                                    form))
                        "]")
    (set? form) (str "08:{"
                     (apply str
                            (map document-literal-key-frame
                                 (sort (map document-literal-sort-key form))))
                     "}")
    (map? form) (str "09:{"
                     (apply str
                            (sort
                             (map (fn [[key item]]
                                    (str (document-literal-key-frame
                                          (document-literal-sort-key key))
                                         (document-literal-key-frame
                                          (document-literal-sort-key item))))
                                  form)))
                     "}")
    (seq? form) (str "10:("
                     (apply str
                            (map #(document-literal-key-frame
                                   (document-literal-sort-key %))
                                 form))
                     ")")
    :else (str "99:" (pr-str form))))

(defn attach-literal-location [literal elaborated]
  (let [location (select-keys (meta literal)
                              [:line :column :end-line :end-column :offset :end-offset])]
    (if (and (seq location) (coll? elaborated))
      (with-meta elaborated (merge (meta elaborated) location))
      elaborated)))

(defn elaborate-document-literal
  "Elaborate one closed EDN-shaped tree into the existing document
  constructors. Nothing below `(document ...)` is evaluated as Kotoba code."
  [literal]
  (let [nodes (volatile! 0)]
    (letfn [(charge! [form depth]
              (when (> depth value/document-depth-limit)
                (reject! "document literal exceeds depth limit" form))
              (when (> (vswap! nodes inc) value/document-node-limit)
                (reject! "document literal exceeds node limit" form)))
            (walk [form depth]
              (charge! form depth)
              (attach-literal-location
               form
               (cond
                 (nil? form) '(document-null)
                 (boolean? form) (list 'document-bool form)
                 (kotoba-integer? form) (list 'document-i64 form)
                 (value/f64-value? form) (list 'document-f64 form)
                 (document-reader-f64-form? form) (list 'document-f64 form)
                 (string? form) (list 'document-string form)
                 (keyword? form) (list 'document-keyword form)
                 (symbol? form) (list 'document-symbol (list 'symbol (str form)))
                 (vector? form)
                 (do (when (> (count form) value/document-container-item-limit)
                       (reject! "document vector literal exceeds item limit" form))
                     (list* 'document-vector (map #(walk % (inc depth)) form)))
                 (set? form)
                 (do (when (> (count form) value/document-container-item-limit)
                       (reject! "document set literal exceeds item limit" form))
                     (list* 'document-set
                            (map #(walk % (inc depth))
                                 (sort-by document-literal-sort-key form))))
                 (map? form)
                 (do (when (> (count form) value/document-container-item-limit)
                       (reject! "document map literal exceeds entry limit" form))
                     (list* 'document-map
                            (mapcat (fn [[key item]]
                                      [(if (keyword? key)
                                         key
                                         (walk key (inc depth)))
                                       (walk item (inc depth))])
                                    (sort-by (comp document-literal-sort-key key) form))))
                 (seq? form)
                 (do (when (> (count form) value/document-container-item-limit)
                       (reject! "document list literal exceeds item limit" form))
                     (list* 'document-list (map #(walk % (inc depth)) form)))
                 :else (reject! "document requires a closed EDN literal tree" form))))]
      (walk literal 0))))

(defn contextual-document-literal?
  "True only for syntax that is unambiguously a closed document value.

  Simple symbols and lists remain expressions: a document-typed parameter must
  still pass through as a parameter, and a call returning :document must still
  execute. Namespaced symbols are admitted as inert document data because they
  cannot name lexical values in the safe source profile. Explicit document
  syntax remains the escape hatch for simple symbols and EDN list values."
  [form]
  (cond
    (or (nil? form)
        (boolean? form)
        (kotoba-integer? form)
        (value/f64-value? form)
        (document-reader-f64-form? form)
        (string? form)
        (keyword? form)) true
    (symbol? form) (some? (namespace form))
    (vector? form) (every? contextual-document-literal? form)
    (set? form) (every? contextual-document-literal? form)
    (map? form) (every? (fn [[key item]]
                          (and (contextual-document-literal? key)
                               (contextual-document-literal? item)))
                        form)
    :else false))

#?(:kotoba
   (defn string-from-i64-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_string_from_i64"))
   :default
(def string-from-i64-helper-name '__kotoba_string_from_i64))

#?(:kotoba
   (defn char-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_char"))
   :default
(def char-helper-name '__kotoba_char))
#?(:kotoba
   (defn doc-append-from-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_doc_append_from"))
   :default
(def doc-append-from-helper-name '__kotoba_doc_append_from))

#?(:kotoba nil :default (def document-returning-heads tables/document-returning-heads))

#?(:kotoba nil :default (def document-constructor-heads tables/document-constructor-heads))

#?(:kotoba
   (defn guess-document-form? [env [:ref :fe/env] f [:ref :form/r]] :bool
     (cond
       (form/is-symbol? f)
       (and (form/is-map? (env-types env))
            (form/eq (form/form-get (env-types env) f) (form/keyword-form :document)))
       (form/is-seq? f)
       (if (= 0 (form/count-of f))
         false
         (let [op (form/nth-of f 0)
               lexical? (tables/table-has? (env-lexical env) op)
               n (argc f)]
           (or (tables/table-has? (env-table env :doc-ctor) op)
               (and (or (sym-is? op "keys") (sym-is? op "vals")) (not lexical?))
               (and (form/is-symbol? op) (tables/table-has? (env-docfns env) op) (not lexical?))
               (and (tables/table-has? (env-table env :doc-ret) op) (not lexical?)
                    (guess-document-form? env (guess-document-src env op f)))
               (and (sym-is? op "get") (= 3 n) (guess-document-form? env (form/nth-of f 1)))
               (and (sym-is? op "reduce") (= 3 n) (guess-document-form? env (form/nth-of f 2))))))
       :else false))
   :default
(defn guess-document-form?
  "Whether SOURCE form FORM is a `:document`, as far as desugaring can tell
  without types: a parameter or `let` local recorded as a document, a document
  constructor, or a sequence/map head applied to a document. The type-aware
  rewrite that runs after desugaring decides the rest; this only chooses between
  the vector-i64 and document lowerings of `reduce`/`map`/`filter`."
  [form]
  (cond
    (symbol? form) (and (map? *local-types*) (= :document (get *local-types* form)))
    (seq? form)
    (let [[op & args] form]
      (or (contains? document-constructor-heads op)
          ;; the keys / values of a map are a document vector whatever the map's
          ;; expression is (a call to a module function is not typed yet here)
          (and (contains? '#{keys vals} op) (not (contains? *lexical-bindings* op)))
          (and (symbol? op) (contains? *document-functions* op)
               (not (contains? *lexical-bindings* op)))
          (and (contains? document-returning-heads op)
               (not (contains? *lexical-bindings* op))
               (let [src (if (contains? '#{map mapv filter filterv remove} op)
                           (second args)
                           (first args))]
                 (guess-document-form? src)))
          (and (= 'get op) (= 3 (count args)) (guess-document-form? (first args)))
          (and (= 'reduce op) (= 3 (count args)) (guess-document-form? (second args)))))
    :else false)))

(defn document-callback-call
  "The source form applying callback F-FORM to the symbol X: an inline `fn`
  binds its parameter (or destructures it) to X, a keyword looks itself up, and
  anything else is called."
  [f-form x]
  (cond
    (and (seq? f-form) (= 'fn (first f-form)))
    (let [[_ params & body] f-form]
      (when-not (and (vector? params) (= 1 (count params)) (seq body))
        (reject! "a fn applied to a document collection takes one parameter and a body"
                 f-form))
      (list 'let [(first params) x] (implicit-do-body body)))

    (keyword? f-form) (list 'get x f-form '(document-null))

    :else (list f-form x)))

(defn document-hof->reduce
  "`(map f doc)` / `(filter p doc)` / `(remove p doc)` (and the -v spellings) as
  the `reduce` over a document that builds a document vector. The result is a
  `:document`, so a chain of them and `keys`/`vals`/`rest` stays in documents."
  [op [f-form coll-form]]
  (let [acc '__kotoba_hof_acc
        x '__kotoba_hof_x
        call (document-callback-call f-form x)
        step (case op
               (map mapv) (list 'document-vector-conj acc (list '__kotoba_document_of call))
               (filter filterv) (list 'if call (list 'document-vector-conj acc x) acc)
               remove (list 'if call acc (list 'document-vector-conj acc x)))]
    (list 'reduce (list 'fn [acc x] step) '(document-vector) coll-form)))

#?(:kotoba nil :default (def document-head-set tables/document-head-set))

#?(:kotoba
   (defn document-head-target [op [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (or (sym-is? op "some") (sym-is? op "every?") (sym-is? op "keep")) (form/nth-of form 2) (form/nth-of form 1)))
   :default
(defn document-head-target
  "The argument whose type decides whether OP is a document operation."
  [op args]
  (if (contains? '#{some every? keep} op) (second args) (first args))))

(defn document-head->form
  "OP applied to a document, as source built from primitives the frontend already
  has: nested `get`/`assoc` for paths, `document-merge`, and `reduce` for the
  collection folds. Paths must be literal vectors of keys; a callback is an
  inline `fn` (one parameter) or a symbol, applied by `document-callback-call`."
  [op args]
  (let [acc '__kotoba_hof_acc
        x '__kotoba_hof_x
        nil-doc '(document-null)
        path! (fn [v]
                (when-not (and (vector? v) (seq v))
                  (reject! (str op " on a document takes a literal non-empty vector of keys")
                           (cons op args)))
                v)]
    (case op
      merge (reduce (fn [a b] (list 'document-merge a b)) (first args) (rest args))

      select-keys
      (let [m '__kotoba_sel_m
            ks (path! (second args))]
        (list 'let [m (first args)]
              (reduce (fn [accumulated k]
                        (list 'if (list 'contains? m k)
                              (list 'assoc accumulated k (list 'get m k nil-doc))
                              accumulated))
                      '(document-map) ks)))

      get-in
      (let [ks (path! (second args))
            default (if (= 3 (count args)) (nth args 2) nil-doc)]
        (loop [form (first args) remaining ks]
          (let [k (first remaining)]
            (if (next remaining)
              (recur (list 'get form k nil-doc) (next remaining))
              (list 'get form k default)))))

      assoc-in
      (let [ks (path! (second args))
            v (nth args 2)]
        (letfn [(build [m remaining]
                  (let [k (first remaining)]
                    (if (next remaining)
                      (list 'assoc m k (build (list 'get m k '(document-map)) (next remaining)))
                      (list 'assoc m k v))))]
          (build (first args) ks)))

      update
      (let [[m k f & more] args
            current (list 'get m k nil-doc)
            applied (if (and (seq? f) (= 'fn (first f)))
                      (document-callback-call f current)
                      (if (keyword? f)
                        (list 'get current f nil-doc)
                        (apply list f current more)))]
        (list 'assoc m k applied))

      empty? (list '= (list 'document-count (first args)) 0)

      some (let [[p coll] args]
             (list 'reduce (list 'fn [acc x] (list 'if acc acc (document-callback-call p x)))
                   false coll))

      every? (let [[p coll] args]
               (list 'reduce (list 'fn [acc x] (list 'if acc (document-callback-call p x) false))
                     true coll))

      ;; a recursive helper, not a nested reduce: an inner loop's result type is
      ;; not resolved when an outer loop's argument types are
      concat (reduce (fn [folded coll] (list doc-append-from-helper-name coll 0 folded))
                     '(document-vector) args)

      keep (let [[f coll] args]
             (list 'reduce
                   (list 'fn [acc x]
                         (list 'let ['__kotoba_kept (document-callback-call f x)]
                               (list 'if (list '= (list 'document-kind '__kotoba_kept) :null)
                                     acc
                                     (list 'document-vector-conj acc '__kotoba_kept))))
                   '(document-vector) coll))

      ;; `(into to coll)`: a map target takes each [key value] entry, any other
      ;; target appends the item.
      into (let [[to coll] args]
             (list 'reduce
                   (list 'fn [acc x]
                         (list 'if (list '= (list 'document-kind acc) :map)
                               (list 'document-assoc acc
                                     (list doc-nth-helper-name x 0)
                                     (list doc-nth-helper-name x 1))
                               (list 'document-vector-conj acc x)))
                   to coll)))))

(def max-match-arms 32)
(def max-match-pattern-keys 8)

(defn match-literal-pattern? [value]
  (or (kotoba-integer? value) (keyword? value) (boolean? value) (string? value)))

(defn match-pattern-plan
  "Compile ONE pattern against SUBJECT (a symbol already bound to the value
  being tested) into `{:temps [[sym expr] ...] :tests [...] :binds [[sym expr] ...]}`.

  Admitted patterns, and nothing else:

    `_`                     wildcard; matches anything, binds nothing
    unqualified symbol      matches anything, binds it (irrefutable)
    bounded literal         integer, keyword, boolean or string; equality test
    `{:key sub-pattern ...}` every listed key must be PRESENT, and each
                            sub-pattern must match the value at that key. A
                            sub-pattern is `_`, an unqualified symbol, or a
                            bounded literal -- not another map.

  `:temps` are `__kotoba_`-prefixed, so wrapping the REST OF THE MATCH in them
  cannot capture anything a program is able to write (`reject-reserved-source-
  symbols!` refuses that prefix in source). `:binds` are the user's names and
  are emitted only inside the arm that matched, so a later arm never sees them.

  Every temp is a total, pure projection (`get` on an absent key answers the
  default rather than trapping), which is what makes it sound to bind them all
  before testing any of them. That keeps the lowering LINEAR in the number of
  tests: the fallback appears once per arm rather than once per test."
  [pattern subject form nested?]
  (cond
    (= '_ pattern)
    {:temps [] :tests [] :binds []}

    (symbol? pattern)
    (do
      (when (namespace pattern)
        (reject! "match binding pattern must be an unqualified symbol" form))
      {:temps [] :tests [] :binds [[pattern subject]]})

    (match-literal-pattern? pattern)
    ;; `=` is refused on `:string` by the safe value profile, so a string
    ;; pattern tests through `string=?`. Without this a string pattern would
    ;; be reported as `equality type is outside the safe value profile`, which
    ;; names neither `match` nor the pattern that caused it.
    {:temps []
     :tests [(if (string? pattern)
               (list 'string=? subject (desugar-expr pattern))
               (list '= subject (desugar-expr pattern)))]
     :binds []}

    (map? pattern)
    (do
      ;; A map inside a map is refused rather than admitted-and-unreachable:
      ;; this profile's bounded map literal checks its values as i64, so no
      ;; source can currently build a map whose value is a map, and a pattern
      ;; that can never match is a claim nothing can test.
      (when nested?
        (reject! "match map pattern values admit `_`, an unqualified symbol, or a bounded literal"
                 form))
      (when (empty? pattern)
        (reject! "match map pattern requires at least one key" form))
      (when (> (count pattern) max-match-pattern-keys)
        (reject! "match map pattern key count exceeds admission limit" form))
      (when-not (every? keyword? (keys pattern))
        (reject! "match map pattern keys must be keywords" form))
      ;; Sorted by key text so the same source always yields the same KIR --
      ;; a literal map's own iteration order is not part of the source.
      (reduce (fn [plan [key sub-pattern]]
                (let [projection (synthetic "match-key")
                      sub (match-pattern-plan sub-pattern projection form true)]
                  (-> plan
                      (update :temps conj [projection (list 'get subject key)])
                      (update :temps into (:temps sub))
                      (update :tests conj (list match-has-marker subject key))
                      (update :tests into (:tests sub))
                      (update :binds into (:binds sub)))))
              {:temps [] :tests [] :binds []}
              (sort-by (comp str key) pattern)))

    (vector? pattern)
    (reject! "match does not admit vector patterns" form)

    (set? pattern)
    (reject! "match does not admit set patterns" form)

    (seq? pattern)
    (reject! "match does not admit list patterns or guards" form)

    :else
    (reject! (str "match admits `_`, an unqualified symbol, a bounded integer, "
                  "keyword, boolean or string literal, and a keyword-keyed map "
                  "pattern")
             form)))

(defn match-conjunction
  "Nested `if` rather than `and` so the emitted KIR carries no chain temps and
  stays gensym-stable for the drift gate.

  A single test is emitted as itself. `(if t true false)` is the wrap this repo
  already calls a stale self-restriction elsewhere -- every test here is
  `:bool`-typed, so the wrap adds a node and says nothing. Most arms have
  exactly one test (a literal pattern, or a one-key map pattern)."
  [tests]
  (cond
    (empty? tests) true
    (empty? (rest tests)) (first tests)
    :else (list 'if (first tests) (match-conjunction (rest tests)) false)))

(defn match-arm
  "One arm, with FALLBACK (the whole rest of the match) appearing exactly once."
  [{:keys [temps tests binds]} result fallback]
  (let [matched (if (seq binds)
                  (list 'let (vec (apply concat binds)) result)
                  result)
        chosen (if (empty? tests)
                 matched
                 (list 'if (match-conjunction tests) matched fallback))]
    (if (seq temps)
      (list 'let (vec (apply concat temps)) chosen)
      chosen)))

(defn desugar-match
  "`(match scrutinee pattern result ... :else default?)` -> a single binding of
  the scrutinee followed by left-to-right nested `let`/`if` tests.

  With no `:else` a miss traps through quot-by-zero, the same convention
  `case` and `condp` already use in this profile."
  [args form]
  (when (empty? args)
    (reject! "match requires a scrutinee expression" form))
  (let [[scrutinee & clauses] args]
    (when (odd? (count clauses))
      (reject! "match requires pattern/result pairs" form))
    (when (empty? clauses)
      (reject! "match requires at least one pattern/result pair" form))
    (when (> (quot (count clauses) 2) max-match-arms)
      (reject! "match clause count exceeds admission limit" form))
    (let [pairs (vec (partition 2 clauses))
          else-positions (vec (keep-indexed (fn [index [pattern _]]
                                              (when (= :else pattern) index))
                                            pairs))]
      (when (> (count else-positions) 1)
        (reject! "match admits at most one :else clause" form))
      (when (and (seq else-positions)
                 (not= (first else-positions) (dec (count pairs))))
        (reject! "match :else clause must be last" form))
      (let [else? (seq else-positions)
            default (if else? (second (last pairs)) '(quot 1 0))
            arms (if else? (subvec pairs 0 (dec (count pairs))) pairs)
            subject (synthetic "match")
            plans (mapv (fn [[pattern _]] (match-pattern-plan pattern subject form false))
                        arms)]
        ;; An arm with no tests always matches, so anything after it can never
        ;; run. Dropping those clauses silently would make a typo in the last
        ;; arm invisible; saying so is the whole difference.
        (doseq [[index plan] (map-indexed vector plans)]
          (when (and (empty? (:tests plan))
                     (or else? (< index (dec (count plans)))))
            (reject! "match clause after an irrefutable pattern is unreachable" form)))
        (doseq [plan plans]
          (let [names (mapv first (:binds plan))]
            (when-not (= (count names) (count (distinct names)))
              (reject! "match pattern binds the same symbol twice" form))))
        (list 'let [subject (desugar-expr scrutinee)]
              (reduce (fn [fallback [plan [_ result]]]
                        (match-arm plan (desugar-expr result) fallback))
                      (desugar-expr default)
                      (reverse (map vector plans arms))))))))

(defn destructure-binding
  "Expands ONE `[pattern value-expr]` `let`/`defn`-param binding into a flat
  seq of `[symbol expr]` pairs (ADR-2607150000/ADR 0207). PATTERN is a plain
  symbol, a positional vector `[a [b c] & rest]`, or a map using `:keys`,
  `:or`, `:as`, and Clojure-shaped explicit entries such as
  `{{:keys [name]} :user}`. Composite patterns recurse through ordinary `nth`
  and an internal destructuring lookup; the later type-directed pass selects
  the exact heterogeneous-vector, typed-map, record, or legacy accessor.

  VALUE-EXPR must already be desugared. Every composite pattern binds one
  deterministic synthetic temp first, so neither the original expression nor
  a nested projection is evaluated more than once."
  [pattern value-expr]
  (letfn [(supported-pattern? [candidate]
            (or (symbol? candidate) (vector? candidate) (map? candidate)))
          (expand [candidate value]
            (cond
              (symbol? candidate) [[candidate value]]

              (vector? candidate)
              (let [tmp (synthetic "destr-vector")
                    [positional rest-part] (split-with (complement #{'&}) candidate)]
                (when-not (every? supported-pattern? positional)
                  (reject! "vector destructuring items must be symbols or nested vector/map patterns"
                           candidate))
                (when (and (seq rest-part)
                           (or (not= 2 (count rest-part))
                               (not (symbol? (second rest-part)))))
                  (reject! "`&` in vector destructuring must be followed by exactly one rest-binding symbol"
                           candidate))
                (into [[tmp value]]
                      (concat
                       (mapcat (fn [[index item-pattern]]
                                 (expand item-pattern (list 'nth tmp index)))
                               (map-indexed vector positional))
                       ;; A rest binding retains the established homogeneous
                       ;; vector contract. Heterogeneous rest needs an exact
                       ;; sliced descriptor and is rejected by type checking
                       ;; until that representation is admitted explicitly.
                       (when-let [rest-name (second rest-part)]
                         [[rest-name (list 'vector-drop tmp (count positional))]]))))

              (map? candidate)
              (let [;; `:keys [a ns/b]` and the namespaced form `:ns/keys [a b]`
                    ;; (ADR 0207): a qualified key symbol binds its bare name
                    ;; and looks up the qualified keyword.
                    keys-slots (filterv (fn [k] (and (keyword? k) (= "keys" (name k))))
                                        (keys candidate))
                    keys-vec (vec (mapcat (fn [slot]
                                            (let [v (get candidate slot)]
                                              (if (vector? v) v [slot])))
                                          keys-slots))
                    key-entries (vec (mapcat
                                      (fn [slot]
                                        (let [v (get candidate slot)]
                                          (when (and (vector? v) (every? symbol? v))
                                            (map (fn [k]
                                                   [(symbol (name k))
                                                    (keyword (or (namespace k) (namespace slot))
                                                             (name k))])
                                                 v))))
                                      keys-slots))
                    key-names (mapv first key-entries)
                    defaults (get candidate :or {})
                    as-name (:as candidate)
                    explicit (apply dissoc candidate (concat keys-slots [:or :as]))
                    explicit (sort-by (comp pr-str val) explicit)
                    direct-symbols
                    (into (set key-names)
                          (keep (fn [[binding-pattern _]]
                                  (when (symbol? binding-pattern) binding-pattern)))
                          explicit)]
                (when-not (and (every? symbol? keys-vec)
                               (map? defaults) (every? symbol? (keys defaults))
                               (every? direct-symbols (keys defaults))
                               (or (nil? as-name) (symbol? as-name))
                               (every? (fn [[binding-pattern lookup-key]]
                                         (and (supported-pattern? binding-pattern)
                                              (keyword? lookup-key)))
                                       explicit)
                               (or (seq key-entries) (seq explicit) as-name))
                  (reject! (str "map destructuring requires :keys, :as, or keyword-valued "
                                "explicit entries, with :or defaults for direct symbol bindings")
                           candidate))
                (let [tmp (synthetic "destr-map")
                      entries (concat key-entries explicit)]
                  (into [[tmp value]]
                        (concat
                         (mapcat
                          (fn [[binding-pattern lookup-key]]
                            (let [lookup
                                  (if (and (symbol? binding-pattern)
                                           (contains? defaults binding-pattern))
                                    (list '__kotoba_destructure_get tmp lookup-key
                                          (desugar-expr (get defaults binding-pattern)))
                                    (list '__kotoba_destructure_get tmp lookup-key))]
                              (expand binding-pattern lookup)))
                          entries)
                         (when as-name [[as-name tmp]])))))

              :else (reject! "unsupported destructuring pattern" candidate)))]
    (expand pattern value-expr)))

(defn form-free-symbols
  "Symbols FORM references as VALUES (never call-heads) that aren't in
  BOUND -- a purely syntactic free-variable scan for `loop`'s closure
  conversion (see desugar-expr's `loop` case). Operates on an ALREADY
  DESUGARED form, so every `let` it sees has plain-symbol bindings only
  (destructuring has already been expanded away by this point) -- no need
  to reason about vector/map patterns here."
  [form bound]
  (cond
    (symbol? form) (if (contains? bound form) #{} #{form})
    (seq? form)
    (let [[op & args] form]
      (case op
        let
        (let [[bindings & body] args]
          (loop [pairs (partition 2 bindings) bound bound acc #{}]
            (if-let [[name value] (first pairs)]
              (recur (next pairs) (conj bound name) (set/union acc (form-free-symbols value bound)))
              (apply set/union acc (map #(form-free-symbols % bound) body)))))
        ;; The catch binder is bound in the handler and nowhere else.
        try
        (let [[body clause] args
              [_ binder handler] (try-clause-parts clause form)]
          (set/union (form-free-symbols body bound)
                     (form-free-symbols handler (conj bound binder))))
        (apply set/union #{} (map #(form-free-symbols % bound) args))))
    (coll? form) (apply set/union #{} (map #(form-free-symbols % bound) form))
    :else #{}))

(defn replace-recur
  "Walks the already-desugared loop BODY, replacing every `(recur a b ...)`
  with a call to HELPER-NAME carrying the new loop-binding values (A/B/...)
  followed by CAPTURED's outer-variable values UNCHANGED (they never vary
  across iterations, only the loop's own bindings do). A `recur` belonging
  to a NESTED loop is never seen here -- desugar-expr's `loop` case already
  resolved it (into an ordinary call to ITS OWN gensym'd helper) as part of
  desugaring this loop's body, before replace-recur ever runs."
  [form helper-name loop-names captured]
  (cond
    (seq? form)
    (let [[op & args] form]
      (if (= op 'recur)
        (do (when-not (= (count args) (count loop-names))
              (reject! "recur argument count must match loop bindings" form))
            (list* helper-name (concat args captured)))
        (cons op (map #(replace-recur % helper-name loop-names captured) args))))
    :else form))

#?(:kotoba
   (defn top-level-function-symbol? [env [:ref :fe/env] v [:ref :form/r]] :bool
     (and (simple-symbol-form? v)
          (not (tables/table-has? (env-lexical env) v))
          (tables/table-has? (env-arities env) v)))
   :default
(defn top-level-function-symbol? [value]
  (and (symbol? value)
       (nil? (namespace value))
       (not (contains? *lexical-bindings* value))
       (contains? *function-arities* value))))

(defn callback-supported-arities [callback]
  (cond
    (top-level-function-symbol? callback)
    (get *function-arities* callback)

    (and (seq? callback) (= 'fn (first callback)))
    (let [[_ params-or-clause & tail] callback
          clauses (if (vector? params-or-clause)
                    [params-or-clause]
                    (when (every? #(and (seq? %) (vector? (first %)))
                                  (cons params-or-clause tail))
                      (map first (cons params-or-clause tail))))]
      (when clauses
        (apply set/union
               (map (fn [params]
                      (let [amp-index (first (keep-indexed #(when (= '& %2) %1) params))]
                        (if amp-index
                          (set (range amp-index 5))
                          #{(count params)})))
                    clauses))))

    :else nil))

(defn callback-closure [kind callback arity]
  (when-let [arities (callback-supported-arities callback)]
    (when-not (contains? arities arity)
      (reject! (str (name kind) " callback does not provide arity " arity)
               callback)))
  (if (top-level-function-symbol? callback)
    (desugar-expr (list 'fn-ref callback))
    (desugar-expr callback)))

(defn synthesize-lazy-map [callback colls form]
  (let [arity (count colls)
        helper-name (synthetic "lazy_map")
        callback-param (symbol (str helper-name "_callback"))
        coll-params (mapv #(symbol (str helper-name "_coll_" %)) (range arity))
        callback-value (callback-closure :lazy-map callback arity)
        resolver
        (binding [*lifting-lazy-thunk?* true]
          (lift-lambda
           (list 'fn []
                 (list 'if
                       (apply list 'or (map #(list 'lazy-empty? %) coll-params))
                       0
                       (list 'pair
                             (list 'fn []
                                   (apply list 'invoke callback-param
                                          (map #(list 'lazy-first %) coll-params)))
                             (list 'fn []
                                   (apply list helper-name callback-param
                                          (map #(list 'lazy-rest %) coll-params))))))))
        helper {:name helper-name
                :params (into [callback-param] coll-params)
                :result :i64 :effects #{} :body resolver}]
    (when (> (count (:params helper)) max-parameters)
      (reject! "lazy-map callback plus sources exceed ABI-supported arity" form))
    (when *pending-loop-helpers*
      (swap! *pending-loop-helpers* conj helper))
    (apply list helper-name callback-value (map desugar-expr colls))))

(defn synthesize-lazy-filter [callback coll]
  (let [helper-name (synthetic "lazy_filter")
        callback-param (symbol (str helper-name "_callback"))
        coll-param (symbol (str helper-name "_coll"))
        value (symbol (str helper-name "_value"))
        callback-value (callback-closure :lazy-filter callback 1)
        cursor (symbol (str helper-name "_cursor"))
        ;; The rejection branch is a `recur`, not a self-call through `invoke`.
        ;;
        ;; It used to be `(invoke (helper cb (lazy-rest coll)))` -- build the
        ;; next thunk and force it immediately -- which nests one host frame
        ;; per REJECTED element. `lazy-map` never has this shape because both
        ;; of its branches return a `pair`; only `filter` has to keep looking.
        ;;
        ;; The KIR trampoline flattens a self-tail call to a `__kotoba_loop_N`
        ;; helper, and `loop`/`recur` is what produces one. Going through
        ;; `invoke` of a closure is invisible to it: the recursion is a call to
        ;; a closure handle, not a named self-call, so nothing could flatten it.
        ;; Measured 2026-08-24 before this change: amu's `lazy-sequence`
        ;; fixture -- four rejected elements -- exhausted the constant oracle's
        ;; host stack on nbb 1.5.212 while the JVM folded it.
        ;;
        ;; The ACCEPT branch still names the helper, and must: that call sits
        ;; inside a `(fn [] ...)`, deferred until the consumer asks for the
        ;; rest. It is not a tail call and must not become one.
        resolver
        (binding [*lifting-lazy-thunk?* true]
          (lift-lambda
           (list 'fn []
                 (list 'loop [cursor coll-param]
                       (list 'if (list 'lazy-empty? cursor)
                             0
                             (list 'let [value (list 'lazy-first cursor)]
                                   (list 'if (list 'invoke :bool callback-param value)
                                         (list 'pair
                                               (list 'fn [] value)
                                               (list 'fn []
                                                     (list helper-name callback-param
                                                           (list 'lazy-rest cursor))))
                                         (list 'recur (list 'lazy-rest cursor)))))))))
        helper {:name helper-name :params [callback-param coll-param]
                :result :i64 :effects #{} :body resolver}]
    (when *pending-loop-helpers*
      (swap! *pending-loop-helpers* conj helper))
    (list helper-name callback-value (desugar-expr coll))))

(defn desugar-dataspace-form
  "Lower one source coordination form to the existing typed capability
  kernel. Assertion/pattern values are inert documents; facet 0 is the
  provider-owned root facet. The named capability resolver both seals wire id
  24 and records namespace usage for fail-closed declaration checking."
  [op args form]
  (let [[tag payload-type payload]
        (case op
          assert!
          (do (when-not (<= 1 (count args) 2)
                (reject! "assert! requires an assertion document and an optional facet" form))
              [:assert dataspace-assert-type
               (list 'record-new dataspace-assert-type
                     (first args) (or (second args) 0))])

          retract!
          (do (when-not (<= 1 (count args) 2)
                (reject! "retract! requires an assertion document and an optional facet" form))
              [:retract dataspace-retract-type
               (list 'record-new dataspace-retract-type
                     (first args) (or (second args) 0))])

          observe!
          (do (when-not (<= 1 (count args) 2)
                (reject! "observe! requires a pattern document and an optional facet" form))
              [:observe dataspace-observe-type
               (list 'record-new dataspace-observe-type
                     (first args) (or (second args) 0))])

          facet-enter!
          (do (when-not (empty? args)
                (reject! "facet-enter! takes no arguments" form))
              [:facet-enter :bool true])

          facet-leave!
          (do (when-not (= 1 (count args))
                (reject! "facet-leave! requires one facet identifier" form))
              [:facet-leave :i64 (first args)]))
        request (list 'variant-new dataspace-request-type tag payload)
        lowered (list 'typed-cap-call
                      (resolve-capability-keyword! :dataspace/transact form)
                      dataspace-request-type dataspace-result-type
                      (desugar-expected-value dataspace-request-type request))]
    (attach-source-operation form lowered :dataspace/transact)))

(defn symbol-literal-form [sym]
  (list 'symbol (str sym)))

#?(:kotoba
   (defn desugar-quoted-datum [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [datum (form/nth-of form 1)]
       (cond
         (not (holds-symbol? datum))
         (if (form/is-seq? datum)
           (throw (fe-unported "quoted list refusal" form))
           (desugar-expr* (with-result env (form/nil-form)) datum ctx))
         (form/is-symbol? datum) (dr env (form/call1 "symbol" (form/string-form (form/symbol-value datum))))
         (and (form/is-vec? datum) (> (form/count-of datum) 0) (<= (form/count-of datum) 128) (all-symbols? datum 0))
         (dr env (head-call (form/symbol-form "hetero-vector-new")
                            (form/cons-onto (form/vec2 (form/keyword-form :vector) (form/form-vec (symbol-type-list (form/count-of datum) (form/no-forms))))
                                            (symbol-literal-forms datum 0 (form/no-forms)))))
         :else (throw (fe-unported "quoted symbol set, map or refusal" form)))))
   :default
(defn desugar-quoted-datum
  "`(quote datum)` as an expression. Symbol data lowers to the same forms
  the unquoted `(symbol \"...\")` / typed constructors are; a quoted datum
  holding no symbol is that datum (the quote comes off, as at a def)."
  [form contextual-result-type]
  (let [datum (second form)]
    (if-not (holds-symbol? datum)
      (if (seq? datum)
        (reject-quoted-symbol-datum! form)
        (desugar-expr* datum contextual-result-type))
      (let [{:keys [kind value-type]} (quoted-symbol-datum-kind datum)]
        (case kind
          :symbol (symbol-literal-form datum)
          :symbol-set (list* 'typed-set-new [:set :symbol]
                             (map symbol-literal-form (sort-by pr-str datum)))
          :symbol-key-map (list* 'typed-map-new [:map :symbol value-type]
                                 (mapcat (fn [[k v]] [(symbol-literal-form k)
                                                      (desugar-expected-value value-type v)])
                                         (sort-by (comp pr-str key) datum)))
          :symbol-vector (list* 'hetero-vector-new [:vector (vec (repeat (count datum) :symbol))]
                                (map symbol-literal-form datum))
          (reject-quoted-symbol-datum! form)))))))

#?(:kotoba
   (defn desugar-expr* [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (cond
       (absence-marker? form) (dr env form)
       (document-ctx? ctx) (throw (fe-unported "document context" form))
       (form/is-int? form) (dr env form)
       (form/is-vec? form) (desugar-vector-literal env form)
       (or (form/is-f64? form) (form/is-map? form) (form/is-set? form))
       (throw (fe-unported "literal" form))
       (form/is-keyword? form) (dr env form)
       (form/is-bool? form) (dr env form)
       (form/is-nil? form) (dr env (form/call0 "option-none"))
       (not (form/is-seq? form)) (dr env form)
       (and (head-is? form "quote") (= 2 (form/count-of form))) (desugar-quoted-datum env form ctx)
       :else (desugar-call env form ctx)))
   :default
(defn desugar-expr* [form contextual-result-type]
  (cond
    ;; An absence marker is already desugared (see `absence-type`).
    (absence-marker? form) form
    ;; A closed EDN-shaped value in a :document context is already fully
    ;; typed by its consumer. Elaborate it directly so authors do not have to
    ;; wrap ordinary data in document syntax. The predicate deliberately
    ;; excludes executable lists and lexical symbols.
    (and (= :document contextual-result-type)
         (contextual-document-literal? form))
    (elaborate-document-literal form)

    ;; Under nbb, compiler-synthesized integer literals are ordinary JS
    ;; numbers while source integers are bigint. Classify the integral host
    ;; form before the broader f64 predicate so generated loop indices/defaults
    ;; stay i64 in typed modules.
    (kotoba-integer? form) form
    ;; A decimal literal in an `:f32` context. Without this branch the literal
    ;; below turns it into an `(f64-from-bits ...)` -- an f64 -- and every f32
    ;; operation then rejects its own literal argument as the wrong type, which
    ;; is why no f32 expression could be written with a number in it at all.
    ;; The narrowing is exact-or-refused; see `f32-literal-bits!`.
    (and (= :f32 contextual-result-type) (value/f64-value? form))
    (list 'f32-from-bits (f32-literal-bits! form))

    ;; The same literal, as the JVM-free reader hands it over. A decimal
    ;; reaches the JVM as a host double, but `kotoba-reader` has already
    ;; turned it into `(f64-from-bits <i64>)` -- so the branch above, which
    ;; asks `value/f64-value?` (a host double), never fired on ClojureScript.
    ;; The literal fell through to the generic f64 lowering and every f32
    ;; operation rejected its own argument: `(defn main [] :f32 1.5)` and
    ;; `(f32-add 1.5 2.5)` were unwritable on nbb while the JVM compiled both.
    ;;
    ;; The frontend already carries this shim in the two other places the
    ;; reader shape reaches a literal branch (`f64-literal-key?` for map
    ;; keys, `document-reader-f64-form?` for document literals) and in the
    ;; `f32` argument path at the bottom of this file. This branch is the one
    ;; that was missed, and it stayed missed because `f32_literal_test.clj` is
    ;; `.clj`: the only suite that ever exercised f32 literals was the one
    ;; host where the bug does not exist. That test is `.cljc` as of this
    ;; commit and runs on both.
    (and (= :f32 contextual-result-type) (document-reader-f64-form? form))
    (list 'f32-from-bits (f32-literal-bits! (value/i64-bits-to-f64 (second form))))
    (value/f64-value? form) (list 'f64-from-bits (value/f64-to-i64-bits form))
    (keyword? form) form
    (boolean? form) form
    (nil? form) '(option-none)
    (map? form) (desugar-map form contextual-result-type)
    ;; Top-level constants admit only bounded, non-empty keyword sets. Lower
    ;; them into the typed-set profile in canonical order so raw set iteration
    ;; order is never observable in KIR or an artifact.
    ;; The item type is read off the literal: all strings is `[:set :string]`,
    ;; all integers `[:set :i64]`. It was hard-coded `[:set :keyword]`, which made
    ;; `#{"eval" "exec"}` -- ordinary Clojure, and how the compiler's own sources
    ;; write a set of names to test membership in -- unwritable. A literal that
    ;; mixes kinds (or is empty) keeps `[:set :keyword]` and is refused by name
    ;; at the item that does not fit.
    (set? form) (let [item-type (cond
                                  (and (seq form) (every? string? form)) :string
                                  (and (seq form) (every? kotoba-integer? form)) :i64
                                  :else :keyword)]
                  (list* 'typed-set-new [:set item-type]
                         (sort-by pr-str form)))
    ;; Vector literals now enter the owned bounded vector-i64 profile rather
    ;; than the legacy untagged pair arena. Binding and parameter vectors are
    ;; consumed by their enclosing forms and never reach this branch.
    ;; here because `let`'s OWN bindings vector never reaches this branch:
    ;; the `let` case below fully owns processing it directly (via
    ;; destructure-binding) and never routes it back through desugar-expr
    ;; as a bare value. `defn` params are consumed entirely inside
    ;; `analyze`, before any desugar-expr call, for the same reason.
    (vector? form)
    (do (when (> (count form) value/vector-literal-item-limit)
          (reject! "vector literal exceeds item limit" form))
        (let [item-types (mapv closed-vector-literal-type form)]
          (cond
            (or (empty? item-types) (every? #{:i64} item-types))
            (apply list 'vector-new (map desugar-expr form))

            (every? #{:f64} item-types)
            (apply list 'vector-f64-new (map desugar-expr form))

            (every? some? item-types)
            (let [type [:vector item-types]]
              (list* 'hetero-vector-new type
                     (mapv (fn [item-type item]
                             (desugar-expected-value item-type item))
                           item-types form)))

            :else
            (apply list 'vector-new (map desugar-expr form)))))
    (not (seq? form)) form
    ;; `(quote datum)` -- the reader's `'datum`. See the section comment
    ;; above `quote-form?`.
    (quote-form? form) (desugar-quoted-datum form contextual-result-type)
    ;; `(:field r)` — the Clojure keyword accessor. Desugars to the 2-arity
    ;; `record-get`, which `rewrite-record-projection` then resolves against the
    ;; value's inferred type (ADR 0189/0190). Keeping it a desugar means no new
    ;; head reaches validation, inference or any backend.
    (and (keyword? (first form)) (= 2 (count form)))
    (list 'record-get (desugar-expr (second form)) (first form))
    ;; `(:field m default)` is Clojure's `(get m :field default)`, and that is
    ;; what it desugars to: `get` already selects the primitive from the
    ;; receiver's type (typed map -> typed-map-get + option-value-of, bounded
    ;; map -> map-get with that default) and refuses a record receiver by
    ;; name, since a closed record field is never absent.
    (and (keyword? (first form)) (= 3 (count form)))
    (desugar-expr (list 'get (second form) (first form) (nth form 2)))
    :else
    (let [[op & args] form]
      (cond
        (lexical-call-form? form)
        (desugar-lexical-call (or contextual-result-type :i64) form)

        ;; A call whose operator is itself a call form -- `((lam [x] ...) n)`,
        ;; the beta-redex, and the `(app (lam [x] ...) n)` the pure core
        ;; spells it with. It is bound to a let and called by name, which is
        ;; the shape `desugar-lexical-call` already lowers; the two spellings
        ;; therefore produce the same HIR and nothing new reaches a backend.
        ;;
        ;; This branch has to come BEFORE the `contains?` lookups below.
        ;; Those take `op` as a MAP KEY, and hashing a call form hashes its
        ;; literals -- so under ClojureScript, where a `.kotoba` integer
        ;; literal is a JS bigint, `((fn [x] (+ x 1)) n)` raised
        ;; `Cannot create property 'closure_uid_...' on bigint '1'` and was
        ;; reported as `:kotoba.error/internal-operation-failure`. The same
        ;; program on the JVM hashed the form without complaint, fell through
        ;; to validate-expr and was refused `computed or namespaced calls are
        ;; forbidden`. One program, an internal failure on one backend and a
        ;; refusal on the other, and neither answer was the right one.
        ;; Measured 2026-09-06 against kotoba-sema 9a23bbc.
        ;;
        ;; Only `seq?` operators are taken. A keyword operator of any other
        ;; arity than the 2 handled above, a map, a vector -- each keeps the
        ;; refusal it already had, because binding them would admit spellings
        ;; nothing has decided the meaning of.
        (seq? op)
        (let [callee (synthetic "app_callee")]
          (binding [*contextual-closure-result-type* contextual-result-type]
            (desugar-expr (list 'let [callee op] (apply list callee args)))))

        (contains? contextual-string-argument-indexes op)
        (let [string-indexes (get contextual-string-argument-indexes op)]
          (apply list op
                 (map-indexed (fn [index arg]
                                ((if (contains? string-indexes index)
                                   #(desugar-result-expr :string %)
                                   desugar-expr)
                                 arg))
                              args)))

        (contains? contextual-document-argument-indexes op)
        (let [document-indexes (get contextual-document-argument-indexes op)]
          (apply list op
                 (map-indexed (fn [index arg]
                                ((if (contains? document-indexes index)
                                   #(desugar-result-expr :document %)
                                   desugar-expr)
                                 arg))
                              args)))

        (contains? '#{document-vector document-list document-set} op)
        (apply list op (map #(desugar-result-expr :document %) args))

        (= 'document-map op)
        (apply list op
               (map-indexed (fn [index arg]
                              ((if (odd? index)
                                 #(desugar-result-expr :document %)
                                 desugar-expr)
                               arg))
                            args))

        (contains? contextual-f64-argument-indexes op)
        (let [f64-indexes (get contextual-f64-argument-indexes op)]
          (apply list op
                 (map-indexed (fn [index arg]
                                ((if (contains? f64-indexes index)
                                   #(desugar-result-expr :f64 %)
                                   desugar-expr)
                                 arg))
                              args)))

        (contains? contextual-f32-argument-indexes op)
        (let [f32-indexes (get contextual-f32-argument-indexes op)]
          (apply list op
                 (map-indexed (fn [index arg]
                                ((if (contains? f32-indexes index)
                                   #(desugar-result-expr :f32 %)
                                   desugar-expr)
                                 arg))
                              args)))

        (contains? contextual-vector-f64-argument-types op)
        (let [expected-types (get contextual-vector-f64-argument-types op)]
          (apply list op
                 (map-indexed (fn [index arg]
                                (if-let [expected (get expected-types index)]
                                  (desugar-result-expr expected arg)
                                  (desugar-expr arg)))
                              args)))

        (= 'vector-f64-new op)
        (apply list op (map #(desugar-result-expr :f64 %) args))

        (contains? typed-vector-operations op)
        (do
          (when-not (= (get typed-vector-operations op) (count args))
            (reject-operation-arity! "typed vector operation" op (get typed-vector-operations op) (count args) form))
          (apply list op
                 (map-indexed (fn [index arg]
                                ((if (zero? index)
                                   #(desugar-result-expr :vector-i64 %)
                                   desugar-expr)
                                 arg))
                              args)))

        ;; `mapv` and `filterv` are SURFACE ALIASES of `map` and `filter`, and
        ;; neither is declared by the grammar authority -- not in `:sugar`, not
        ;; in `:admitted-builtins` (measured 2026-09-06). The `case` below
        ;; rewrote them unconditionally, so a module that DEFINES a function
        ;; called `mapv` had its own definition silently overridden by the
        ;; alias, and the alias requires `vector-i64` sources.
        ;;
        ;; `lang/stdlib/core.kotoba` defines exactly that: a `mapv` over pair
        ;; chains, with a comment explaining that the `map` head refuses a
        ;; stored callback so it walks the chain itself. The alias took the
        ;; name anyway, and every function in that module became uncallable
        ;; through the oracle harness -- 772 errors in
        ;; `kotoba.lang.stdlib-core-oracle-test`, all of them one refusal
        ;; re-reported per assertion, because the namespace shares one `delay`.
        ;;
        ;; Measured 2026-09-06: `mapv` was the ONLY name where a built-in beat
        ;; a user definition. `keep`, `remove`, `sort`, `distinct`,
        ;; `interpose`, `partition`, `juxt2` and `frequencies` all resolve to
        ;; the module's own function; the identical body renamed to `mapv2`
        ;; compiles and runs. So this is not a general shadowing policy -- it
        ;; is one undeclared alias claiming a name it was never given.
        ;;
        ;; A DECLARED head is a different question: `map` and `filter` are in
        ;; the authority, and whether a module may define one is a decision
        ;; nobody has made. This changes only the two that the authority does
        ;; not declare.
        ;; `remove` joined the set 2026-09-25 when it gained its lowering
        ;; (the `(filter remove)` arm below): lang/stdlib/core defines its own
        ;; `remove`, and that definition must keep winning.
        (and (contains? '#{mapv filterv remove} op)
             (top-level-function-symbol? op))
        (apply list op (map desugar-expr args))

        ;; A document collection: fold it into a document vector (a `map` /
        ;; `filter` over a `:document` cannot be the vector-i64 lowering, which
        ;; assumes its source is one).
        (and (contains? '#{map mapv filter filterv remove} op)
             (= 2 (count args))
             (not (contains? *lexical-bindings* op))
             (guess-document-form? (second args)))
        (desugar-expr (document-hof->reduce op args))

        ;; the rest of the collection heads, on a document (merge, select-keys,
        ;; get-in, assoc-in, update, empty?, some, every?, concat, keep, into)
        (and (contains? document-head-set op)
             (not (contains? *lexical-bindings* op))
             (not (top-level-function-symbol? op))
             (seq args)
             (guess-document-form? (document-head-target op args)))
        (desugar-expr (document-head->form op args))

        :else
        (case op
        list (binding [*contextual-closure-result-type* contextual-result-type]
               (desugar-list args form))
        fn (binding [*contextual-closure-result-type* contextual-result-type]
             (lift-lambda form))
        ;; A literal nil branch is absence: a marker the other branch's type
        ;; resolves (`absence-type`). The 2-arity `if` stays refused
        ;; (`if-parts`); `when` is the form with no else.
        if (apply list 'if
                  (map-indexed (fn [index arg]
                                 (cond
                                   (zero? index) (desugar-bool-expr arg)
                                   (nil? arg) '(__kotoba_absent :nil)
                                   contextual-result-type
                                   (desugar-result-expr contextual-result-type arg)
                                   :else (desugar-expr arg)))
                               (if-parts args form)))
        ;; Abort ability, slice 1. The desugared shape is the source shape:
        ;; `(throw e)` and `(try body (catch [E] binder handler))`. Both survive
        ;; to `elaborate-aborts`, which lowers them to result values once every
        ;; function's error type is known; no backend ever sees either head.
        throw
        (do (when-not (= 1 (count args))
              (reject! "throw requires exactly one error value" form :kotoba.error/abort-shape))
            (when-let [context (abort-lexical-context)]
              (reject! (str "throw inside " context
                            " is not admitted in abort slice 1: precondition "
                            ":checked-lexical-facet-unwind is not met")
                       form :kotoba.error/abort-precondition))
            (list 'throw (desugar-expr (first args))))
        try
        (do (when-not (= 2 (count args))
              (reject! "try requires exactly one body expression and one catch clause"
                       form :kotoba.error/abort-shape))
            (let [[body clause] args
                  [error-type binder handler] (try-clause-parts clause form)]
              (when-not (valid-name? binder)
                (reject! "catch binder must be a bounded unqualified symbol" form :kotoba.error/abort-shape))
              (when (some? error-type) (validate-value-type! error-type))
              (let [handler* (binding [*lexical-bindings* (conj *lexical-bindings* binder)
                                       *local-types* (cond-> *local-types*
                                                       (some? error-type) (assoc binder error-type))]
                               (desugar-expr handler))]
                (list 'try (desugar-expr body)
                      (if (some? error-type)
                        (list 'catch error-type binder handler*)
                        (list 'catch binder handler*))))))
        catch
        (reject! "catch is admitted only as the clause of a try" form :kotoba.error/abort-shape)
        fn-ref
        (if (contains? *function-arities* 'fn-ref)
          (apply list 'fn-ref (map desugar-expr args))
          (do
            (when-not (and (= 1 (count args)) (symbol? (first args)))
              (reject! "fn-ref requires one top-level function symbol" form))
            (let [function-name (first args)
                  arities (get *function-arities* function-name)]
              (when-not (seq arities)
                (reject! "fn-ref requires a declared top-level function" function-name))
              (when (first-truthy #(> % 4) arities)
                (reject! "fn-ref target exceeds closure ABI arity four" function-name))
              (lift-lambda
               (cons 'fn
                     (mapv (fn [arity]
                             (let [params (mapv #(symbol (str "__kotoba_fn_ref_arg_" %))
                                                (range arity))]
                               (list params (apply list function-name params))))
                           (sort arities)))))))
        invoke
        (if (contains? *function-arities* 'invoke)
          (apply list 'invoke (map desugar-expr args))
          (let [declared-result (first args)
                typed? (closure-result-type? declared-result)
                _ (when (and (or (keyword? declared-result)
                                 (structured-type? declared-result))
                             (not typed?))
                    (reject! "closure result type is outside the admitted dispatcher profile"
                             declared-result))
                ;; A computed head is dynamic, but its result family often is
                ;; not: consumers such as string-length, record-get, and typed
                ;; function returns already provide a closed result context.
                ;; Reuse that context so ordinary source can say `(invoke f x)`
                ;; and reserve an explicit descriptor for genuinely ambiguous
                ;; positions. No context retains the historical :i64 default.
                result-type (cond
                              typed? (canonical-closure-result-type declared-result)
                              contextual-result-type
                              (canonical-closure-result-type contextual-result-type)
                              :else :i64)
                call-args (if typed? (rest args) args)]
            (when-not (<= 1 (count call-args) 5)
              (reject! "invoke requires an optional admitted result descriptor, a closure, and zero to four arguments"
                       form))
            (let [[closure & invoke-args] call-args]
              (apply list (request-invoke-dispatcher result-type (count invoke-args))
                     (desugar-result-expr result-type closure)
                     (map desugar-expr invoke-args)))))
        apply
        (if (contains? *function-arities* 'apply)
          (apply list 'apply (map desugar-expr args))
          (do
            (when-not (<= 2 (count args) 6)
              (reject! "apply requires a closure, up to four fixed arguments, and a final argument collection" form))
            (when *uses-apply?* (vreset! *uses-apply?* true))
            (let [closure (first args)
                  call-args (rest args)
                  trailing (last call-args)
                  fixed (butlast call-args)
                  argument-list (reduce (fn [tail value]
                                          (list 'pair (desugar-expr value) tail))
                                        (desugar-expr trailing)
                                        (reverse fixed))]
              (list '__kotoba_closure_apply (desugar-expr closure) argument-list))))
        eval
        (if (contains? *function-arities* 'eval)
          (apply list 'eval (map desugar-expr args))
          (do
            (when-not (= 1 (count args))
              (reject! "typed eval requires exactly one :document request" form))
            ;; Preserve the familiar Lisp spelling at the source surface while
            ;; routing through the catalogued, host-bound code/eval ability.
            ;; Neither source text nor a host namespace enters this path.
            (elaborate-named-operation form 'code/eval :code/eval args)))
        lazy-cons
        (do
          (when-not (= 2 (count args))
            (reject! "lazy-cons requires a head and lazy tail expression" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (binding [*lifting-lazy-thunk?* true]
            (lift-lambda
             (list 'fn []
                   (list 'pair
                         (list 'fn [] (first args))
                         (list 'fn [] (second args)))))))
        lazy-first
        (do
          (when-not (= 1 (count args))
            (reject! "lazy-first requires one lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (let [lazy-seq (synthetic "lazy_seq")
                cell (synthetic "lazy_cell")]
            (list 'let [lazy-seq (desugar-expr (first args))]
                  (list 'if (list '= lazy-seq 0)
                        0
                        (list 'let [cell (list (invoke-dispatcher-name 0) lazy-seq)]
                              (list 'if (list '= cell 0)
                                    0
                                    (list (invoke-dispatcher-name 0)
                                          (list 'pair-first cell))))))))
        lazy-rest
        (do
          (when-not (= 1 (count args))
            (reject! "lazy-rest requires one lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (let [lazy-seq (synthetic "lazy_seq")
                cell (synthetic "lazy_cell")]
            (list 'let [lazy-seq (desugar-expr (first args))]
                  (list 'if (list '= lazy-seq 0)
                        0
                        (list 'let [cell (list (invoke-dispatcher-name 0) lazy-seq)]
                              (list 'if (list '= cell 0)
                                    0
                                    (list (invoke-dispatcher-name 0)
                                          (list 'pair-second cell))))))))
        lazy-empty?
        (do
          (when-not (= 1 (count args))
            (reject! "lazy-empty? requires one lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (let [lazy-seq (synthetic "lazy_seq")]
            (list 'let [lazy-seq (desugar-expr (first args))]
                  (list 'if (list '= lazy-seq 0)
                        true
                        (list '= (list (invoke-dispatcher-name 0) lazy-seq) 0)))))
        lazy-map
        (do
          (when-not (<= 2 (count args) 5)
            (reject! "lazy-map requires a callback and one to four lazy sequences" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (synthesize-lazy-map (first args) (vec (rest args)) form))
        lazy-filter
        (do
          (when-not (= 2 (count args))
            (reject! "lazy-filter requires a unary predicate and lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (synthesize-lazy-filter (first args) (second args)))
        take
        (do
          (when-not (= 2 (count args))
            (reject! "take requires a count and lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (list lazy-take-helper-name
                (desugar-expr (first args))
                (desugar-expr (second args))))
        drop
        (do
          (when-not (= 2 (count args))
            (reject! "drop requires a count and lazy sequence" form))
          (when *uses-lazy?* (vreset! *uses-lazy?* true))
          (list lazy-drop-helper-name
                (desugar-expr (first args))
                (desugar-expr (second args))))
        document
        (do (when-not (= 1 (count args))
              (reject! "document requires exactly one closed literal tree" form))
            (elaborate-document-literal (first args)))

        ;; ADR-2607150000: `let` gets its own case (previously handled only
        ;; by the generic default case below) for two reasons: (1) bug fix
        ;; -- the default case's `(map desugar-expr args)` called
        ;; desugar-expr on the WHOLE bindings vector as one opaque arg;
        ;; since vectors aren't `seq?`, it passed through UNCHANGED,
        ;; silently skipping map/keyword/nested-vector desugaring inside
        ;; binding VALUES (`(let [m {:a 1}] (get m :a))` failed with
        ;; "value type is outside the safe profile" before this fix,
        ;; confirmed live). (2) destructuring: each binding's PATTERN may
        ;; now be a vector `[a b & rest]` or a map `{:keys [a b]}`, not
        ;; just a plain symbol (destructure-binding above expands either
        ;; into flat symbol bindings). Malformed bindings (not an even
        ;; vector) pass through unchanged so validate-expr's own existing
        ;; "let requires an even binding vector" check still fires with
        ;; its original, clearer error.
        let (let [[bindings & body] args]
              (if (and (vector? bindings) (even? (count bindings)))
                ;; Lower bindings sequentially.  A value may call a closure
                ;; introduced by an earlier binding, while its own pattern is
                ;; deliberately not visible until that value has finished.
                (letfn [(lower-bindings [remaining env contracts types lowered]
                          (if-let [[pattern value] (first remaining)]
                            (let [value-contract
                                  (binding [*lexical-callable-contracts* contracts]
                                    (expression-callable-contract value))
                                  ;; `reduce`/`map`/`filter` choose their lowering
                                  ;; by the collection's type at desugar time, so a
                                  ;; `let` local that is a document must be known
                                  ;; as one by the bindings and body that follow.
                                  document? (and (symbol? pattern)
                                                 (binding [*local-types* types]
                                                   (guess-document-form? value)))
                                  expanded
                                  (binding [*lexical-bindings* env
                                            *lexical-callable-contracts* contracts
                                            *local-types* types]
                                    (destructure-binding pattern
                                                         (desugar-expr value)))
                                  integer? (and (symbol? pattern)
                                                (not document?)
                                                (binding [*local-types* types]
                                                  (str-integer-form? value)))
                                  next-types (cond
                                               document? (assoc (or types {}) pattern :document)
                                               ;; so `str` can print it later
                                               integer? (assoc (or types {}) pattern :i64)
                                               :else types)
                                  next-env (into env (map first expanded))
                                  next-contracts
                                  (if (and (symbol? pattern) value-contract)
                                    (assoc contracts pattern value-contract)
                                    contracts)]
                              (lower-bindings (rest remaining) next-env next-contracts
                                              next-types (into lowered expanded)))
                            [(vec (mapcat identity lowered)) env contracts types]))]
                  (let [[lowered-bindings body-env body-contracts body-types]
                        (lower-bindings (partition 2 bindings)
                                        *lexical-bindings*
                                        *lexical-callable-contracts*
                                        *local-types* [])
                        ;; `mapv`, not bare `map`: forcing must remain in
                        ;; the dynamic extent of the compiler counters.
                        lowered-body
                        (binding [*lexical-bindings* body-env
                                  *lexical-callable-contracts* body-contracts
                                  *local-types* body-types]
                          (desugar-tail-expressions contextual-result-type body))]
                    ;; A `let` body is an implicit `do`, exactly like `when`,
                    ;; `when-not`, `when-let` and `when-some` already are here.
                    ;;
                    ;; The core form `let` takes ONE body expression -- that is
                    ;; the shape KIR documents (kotoba.kir:2246 "one body form")
                    ;; and the shape every later pass in this file destructures.
                    ;; So a multi-form source body has to become one expression
                    ;; HERE, and the head that does that is `do`, which is kept
                    ;; first-class through desugaring precisely so an earlier,
                    ;; unused, side-effecting subexpression is not dropped.
                    ;;
                    ;; Until 2026-09-02 this emitted `(list* 'let bindings
                    ;; body...)` -- every body form, on a head that takes one --
                    ;; and `rewrite-record-projection` then destructured
                    ;; `[bindings body]` and rebuilt the form from the FIRST
                    ;; body form alone. `(let [x (f)] (store! a x) (+ x 1))`
                    ;; compiled with :ok true, kept only `(store! a x)`, and
                    ;; dropped the value. Measured on the QWEN-RUNTIME cursor,
                    ;; where the dropped form carried the high word of a 64-bit
                    ;; offset. `validate-expr`'s "let requires one result
                    ;; expression" could never fire, because the truncation ran
                    ;; first and handed it a body of exactly one.
                    (list 'let lowered-bindings
                          (sequenced-body lowered-body form 'let))))
                ;; Preserve malformed input so validate-expr emits its
                ;; established even-binding-vector diagnostic.
                (list* 'let bindings (mapv desugar-expr body))))

        ;; `do` sequencing: evaluate each subexpression in order, discard all
        ;; but the last (which is the value). Unlike `let`, a `do` subexpression
        ;; is NOT substituted into a body -- so a side-effecting form here runs
        ;; exactly once, in order, even if its result is unused (kernel MMIO
        ;; ops). A single-expression `do` collapses to that expression. `do` is
        ;; kept as a first-class head through desugaring (a nested-`let`
        ;; desugaring would DCE-drop unused side-effecting subexprs).
        do (do (when (empty? args) (reject! "do requires at least one expression" form :kotoba.error/do-empty))
               (if (= 1 (count args))
                 (if contextual-result-type
                   (desugar-result-expr contextual-result-type (first args))
                   (desugar-expr (first args)))
                 (list* 'do (desugar-tail-expressions contextual-result-type args))))

        ;; ADR-2607150000: `loop`/`recur` desugars to a compiler-synthesized
        ;; recursive helper function (like `get`'s __kotoba_map_get, but
        ;; freshly gensym'd per loop occurrence rather than one shared fixed
        ;; name) -- no backend/codegen change, since ordinary recursive
        ;; `defn` calls already work and are already fuel-metered. Any free
        ;; variable the loop body references from its ENCLOSING scope is
        ;; captured as an EXTRA helper parameter (form-free-symbols does a
        ;; purely syntactic scan -- no environment lookup needed: an
        ;; over/under-capture mistake still fails SAFELY later, as a hard
        ;; :unbound-symbol or arity-mismatch compile error from validate-expr,
        ;; never silently wrong runtime behavior). Threading the captured
        ;; values through recur unchanged is handled by replace-recur.
        loop
        (let [[bindings & body] args]
          (when-not (and (vector? bindings) (even? (count bindings))
                         (every? symbol? (take-nth 2 bindings)))
            (reject! "loop requires an even vector of plain-symbol bindings (destructure inside the body instead)" form))
          (when-not (= 1 (count body))
            (reject! "loop requires exactly one body expression (this profile has no `do`)" form))
          (let [loop-names (vec (take-nth 2 bindings))
                loop-inits (mapv desugar-expr (take-nth 2 (rest bindings)))
                ;; a binding whose init is certainly an i64 stays one across
                ;; `recur`, so `str` may print it
                integer-names (keep (fn [[name init]]
                                      (when (str-integer-form? init) name))
                                    (partition 2 bindings))
                desugared-body (binding [*abort-lexical-context* :loop
                                         *local-types* (reduce #(assoc %1 %2 :i64)
                                                               (or *local-types* {})
                                                               integer-names)]
                                 (desugar-expr (first body)))
                captured (vec (sort-by str (form-free-symbols desugared-body (set loop-names))))
                helper-name (symbol (str "__kotoba_loop_" (vswap! *loop-counter* inc)))
                helper-params (into loop-names captured)]
            (when (> (count helper-params) max-parameters)
              ;; Name the arithmetic. The helper is not written down anywhere the
              ;; author can see, so "exceeds ABI-supported arity" was a refusal
              ;; about a function they never wrote: the ceiling on loop BINDINGS
              ;; is max-parameters MINUS however many outer variables the body
              ;; happens to mention, which is not `max-parameters` and is not a
              ;; constant.
              (reject! (str "loop bindings plus captured outer variables exceed this "
                            "compiler's ABI-supported arity: " (count loop-names)
                            " binding" (when (not= 1 (count loop-names)) "s")
                            " plus " (count captured) " captured outer variable"
                            (when (not= 1 (count captured)) "s")
                            " is " (count helper-params) ", and the limit is " max-parameters
                            (when (seq captured)
                              (str "; the captured variables are "
                                   (str/join ", " (map str captured)))))
                       form :kotoba.error/loop-parameter-ceiling
                       {:kotoba.error/loop-bindings (count loop-names)
                        :kotoba.error/loop-captured (vec captured)
                        :kotoba.error/max-parameters max-parameters}))
            (when *pending-loop-helpers*
              (swap! *pending-loop-helpers* conj
                     {:name helper-name :params helper-params
                      ;; :i64 is a PLACEHOLDER here, not an answer -- the real
                      ;; result is read from the loop's exits by
                      ;; `infer-loop-helper-results`, which needs parameter
                      ;; types this pass does not have yet.
                      :result (or *loop-result-type* :i64) :effects #{}
                      :loop-helper? true
                      :body (replace-recur desugared-body helper-name loop-names captured)}))
            (when *loop-helper-shapes*
              (vswap! *loop-helper-shapes* assoc helper-name
                      (cond-> {:bindings (count loop-names)
                               :declared-result *loop-result-type*}
                        (seq *loop-known-types*)
                        (assoc :known-types *loop-known-types*))))
            (list* helper-name (concat loop-inits captured))))
        cons (do (when-not (= 2 (count args)) (reject! "cons requires two operands" form))
                 (list 'pair (desugar-expr (first args)) (desugar-expr (second args))))
        first (do (when-not (= 1 (count args)) (reject! "first requires one operand" form))
                  (list 'pair-first (desugar-expr (first args))))
        second (do (when-not (= 1 (count args)) (reject! "second requires one operand" form))
                   (list 'pair-first (list 'pair-second (desugar-expr (first args)))))
        rest (do (when-not (= 1 (count args)) (reject! "rest requires one operand" form))
                 (list 'pair-second (desugar-expr (first args))))
        empty? (do (when-not (= 1 (count args)) (reject! "empty? requires one operand" form))
                   (list '= (desugar-expr (first args)) 0))
        ;; `not`/`not=` desugar through `if`, not through `(= x 0)`: comparisons
        ;; are `:bool`-typed now, so comparing their result to an i64 literal is
        ;; a type error. `if` accepts a boolean or a legacy 0/1 integer test, so
        ;; both an i64 operand and a bool one keep working, and the result is
        ;; `:bool` either way.
        not (do (when-not (= 1 (count args)) (reject! "not requires one operand" form))
                (list 'if (desugar-expr (first args)) false true))
        not= (if (= 2 (count args))
               (list 'if (list '= (desugar-expr (first args))
                                  (desugar-expr (second args)))
                     false true)
               (list 'if (desugar-comparison-chain '= args form) false true))
        zero? (do (when-not (= 1 (count args)) (reject! "zero? requires one operand" form))
                  (list '= (desugar-expr (first args)) 0))
        pos? (do (when-not (= 1 (count args)) (reject! "pos? requires one operand" form))
                 (list '> (desugar-expr (first args)) 0))
        neg? (do (when-not (= 1 (count args)) (reject! "neg? requires one operand" form))
                 (list '< (desugar-expr (first args)) 0))
        = (if (= 2 (count args))
            (list '= (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '= args form))
        < (if (= 2 (count args))
            (list '< (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '< args form))
        > (if (= 2 (count args))
            (list '> (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '> args form))
        <= (if (= 2 (count args))
             (list '<= (desugar-expr (first args)) (desugar-expr (second args)))
             (desugar-comparison-chain '<= args form))
        >= (if (= 2 (count args))
             (list '>= (desugar-expr (first args)) (desugar-expr (second args)))
             (desugar-comparison-chain '>= args form))
        and (desugar-and args)
        or (desugar-or args)
        -> (desugar-thread args form false)
        ->> (desugar-thread args form true)
        as-> (desugar-as-thread args form)
        some-> (desugar-some-thread args form false)
        some->> (desugar-some-thread args form true)
        cond (desugar-cond args form)
        condp (desugar-condp args form)
        cond-> (desugar-cond-thread args form false)
        cond->> (desugar-cond-thread args form true)
        dotimes (binding [*abort-lexical-context* :loop] (desugar-dotimes args form))
        doseq (binding [*abort-lexical-context* :loop] (desugar-doseq args form))
        assert! (desugar-dataspace-form op args form)
        retract! (desugar-dataspace-form op args form)
        observe! (desugar-dataspace-form op args form)
        facet-enter! (desugar-dataspace-form op args form)
        facet-leave! (desugar-dataspace-form op args form)
        assert (do
                 (when-not (= 1 (count args))
                   (reject! "assert requires exactly one condition; messages are not supported"
                            form))
                 (list 'if (desugar-bool-expr (first args)) 0 '(quot 1 0)))
        case (desugar-case args form)
        match (desugar-match args form)
        if-let (desugar-binding-if args form false)
        when-let (desugar-binding-if args form true)
        if-some (desugar-binding-some args form false)
        when-some (desugar-binding-some args form true)
        if-not (do (when-not (<= 2 (count args) 3)
                     (reject! "if-not requires then and optional else expressions" form))
                   ;; Negate by swapping the branches, not by `(= test 0)` —
                   ;; the test may now be `:bool`.
                   (let [[test then else] args
                         branch (fn [x] (if (nil? x) '(__kotoba_absent :nil) (desugar-expr x)))]
                     (list 'if (desugar-bool-expr test)
                           (if (= 3 (count args)) (branch else) (absence-marker-form))
                           (branch then))))
        when-not (do (when (empty? args)
                       (reject! "when-not requires a test expression" form))
                     (let [[test & body] args
                           then (cond
                                  (empty? body) 0
                                  (= 1 (count body)) (desugar-expr (first body))
                                  :else (list* 'do (mapv desugar-expr body)))]
                       ;; Negate by swapping the branches (see if-not). No
                       ;; else is absence (`absence-type`).
                       (list 'if (desugar-bool-expr test) (absence-marker-form) then)))
        when (do (when (empty? args)
                   (reject! "when requires a test expression" form))
                 (let [[test & body] args
                       then (if (= 1 (count body))
                              (desugar-expr (first body))
                              (list* 'do (mapv desugar-expr body)))]
                   ;; No else is absence (`absence-type`), not the i64 0.
                   (list 'if (desugar-bool-expr test) then (absence-marker-form))))
        get (do (when-not (<= 2 (count args) 3)
                  (reject! "get requires a value, a key, and an optional default" form))
                ;; Keep the authored head until the type-directed rewrite can
                ;; select map-get, typed-map-get, or record-get. Every selected
                ;; primitive is still closed and validated before lowering.
                (list* 'get (mapv desugar-expr args)))
        assoc (do (when-not (and (>= (count args) 3) (odd? (count args)))
                    (reject! "assoc requires a map followed by one or more key/value pairs" form))
                  (let [[m & kvs] args]
                    (apply list 'map-assoc (desugar-expr m)
                           (mapcat (fn [[k v]] [(desugar-expr k) (desugar-expr v)])
                                   (partition 2 kvs)))))
        ;; Kept on the authored head for the same reason `get` is: which
        ;; primitive answers depends on the receiver's type, which is not
        ;; known until `rewrite-record-projection` runs. Arity is checked
        ;; here, where the authored form is still in hand.
        contains? (do (when-not (= 2 (count args))
                        (reject! "contains? requires a map and one key" form))
                      (list* 'contains? (mapv desugar-expr args)))
        dissoc (do (when-not (>= (count args) 2)
                     (reject! "dissoc requires a map and at least one key" form))
                   (list* 'dissoc (mapv desugar-expr args)))
        ;; ADR 0353 floor :row-operations. Both are row operations on a
        ;; record (`rewrite-record-projection` elaborates them), so they keep
        ;; the authored head until the receiver's type is known. select-keys
        ;; names the fields it keeps, and a record's fields are static: the
        ;; key vector is a literal of keywords, spread into the form.
        select-keys (do (when-not (and (= 2 (count args)) (vector? (second args))
                                       (every? keyword? (second args)))
                          (reject! (str "select-keys requires a record and a literal vector of "
                                        "keyword fields: a record's fields are static, so the "
                                        "fields it keeps are written, not computed")
                                   form :kotoba.error/row-operation-shape))
                        (list* 'select-keys (desugar-expr (first args)) (second args)))
        merge (do (when-not (>= (count args) 2)
                    (reject! "merge requires a record and at least one record or map literal to merge onto it"
                             form :kotoba.error/row-operation-shape))
                  (list* 'merge (mapv desugar-expr args)))
        ;; `some` here is the OPTION CONSTRUCTOR (`(some x)` -> `[:option
        ;; i64]`), not clojure.core/some. The two-argument spelling is
        ;; Clojure's predicate-over-a-collection, and it is a name collision
        ;; -- measured 2026-09-12 (selfhost measurement 16, 8 of the
        ;; compiler's own modules): "requires one i64 operand" read as an
        ;; arity slip on a call the author never meant as a constructor. The
        ;; sentence names the collision; nothing is admitted here.
        some (do (when-not (= 1 (count args))
                   (reject! (if (= 2 (count args))
                              "some with two arguments is clojure.core/some (a predicate over a collection); in this language `some` is the option constructor and takes one i64 operand -- search with filter / first, or write the loop"
                              "some requires one i64 operand")
                            form))
                 (list 'option-some (desugar-expr (first args))))
        ;; The source head rides on the form so the option-some? arm of
        ;; `rewrite-record-projection` can answer these two, and only these
        ;; two, on a :document (its :null kind); an authored option-some?
        ;; stays an option question.
        some? (do (when-not (= 1 (count args)) (reject! "some? requires one option operand" form))
                  (with-meta (list 'option-some? (desugar-expr (first args)))
                    {:kotoba.diag/source-head 'some?}))
        nil? (do (when-not (= 1 (count args)) (reject! "nil? requires one option operand" form))
                 (list 'bool-not (with-meta (list 'option-some? (desugar-expr (first args)))
                                   {:kotoba.diag/source-head 'nil?})))
        vector-i64 (do (when (> (count args) value/vector-literal-item-limit)
                         (reject! "vector-i64 exceeds item limit" form))
                       (apply list 'vector-new (map desugar-expr args)))
        bytes (do (when-not (empty? args)
                    (reject! "bytes currently constructs only the canonical empty value" form))
                  '(bytes-empty))
        vector-f64 (do (when (> (count args) value/vector-literal-item-limit)
                         (reject! "vector-f64 exceeds item limit" form))
                       (apply list 'vector-f64-new
                              (map #(desugar-result-expr :f64 %) args)))
        match-result
        (do
          (when-not (= 4 (count args))
            (reject! "match-result requires value, type, ok branch, and err branch" form))
          (let [[result type ok-branch err-branch] args]
            (when-not (and (seq? ok-branch) (= 3 (count ok-branch))
                           (= 'ok (first ok-branch)) (symbol? (second ok-branch)))
              (reject! "match-result requires exactly one (ok binder body) branch" form))
            (when-not (and (seq? err-branch) (= 3 (count err-branch))
                           (= 'err (first err-branch)) (symbol? (second err-branch)))
              (reject! "match-result requires exactly one (err binder body) branch" form))
            (list 'result-match-of type (desugar-expected-value type result)
                  (second ok-branch) (desugar-expr (nth ok-branch 2))
                  (second err-branch) (desugar-expr (nth err-branch 2)))))
        result-match-of
        (do (when-not (= 6 (count args))
              (reject! "result-match-of requires type, value, and two bound branches" form))
            (let [[type value ok-binder ok-body err-binder err-body] args]
              (when-not (and (symbol? ok-binder) (symbol? err-binder))
                (reject! "result-match-of requires symbol binders" form))
              (list 'result-match-of type (desugar-expected-value type value)
                    ok-binder (desugar-expr ok-body)
                    err-binder (desugar-expr err-body))))
        variant-new
        (do (when-not (= 3 (count args))
              (reject! "variant-new requires type, case tag, and payload" form))
            (let [[type tag payload] args
                  canonical-type (canonical-closure-result-type type)
                  payload-type (when (variant-type? canonical-type)
                                 (first-truthy (fn [[case-tag case-type]]
                                         (when (= case-tag tag) case-type))
                                       (nth canonical-type 2)))]
              (list 'variant-new type tag
                    (if payload-type
                      (desugar-expected-value payload-type payload)
                      (desugar-expr payload)))))
        match-variant
        (do (when (< (count args) 3)
              (reject! "match-variant requires value, type, and exhaustive branches" form))
            (let [[value type & branches] args]
              (when-not (every? #(and (seq? %) (= 3 (count %))
                                      (keyword? (first %)) (symbol? (second %))) branches)
                (reject! "match-variant branches require (:case binder body)" form))
              (list 'variant-match type (desugar-expected-value type value)
                    (mapv (fn [[tag binder body]] [tag binder (desugar-expr body)]) branches))))
        variant-match
        (do (when-not (= 3 (count args))
              (reject! "variant-match requires type, value, and lowered branches" form))
            (let [[type value branches] args]
              (when-not (and (vector? branches)
                             (every? #(and (vector? %) (= 3 (count %))
                                           (keyword? (first %)) (symbol? (second %)))
                                     branches))
                (reject! "variant-match lowered branches are invalid" form))
              (list 'variant-match type (desugar-expected-value type value)
                    (mapv (fn [[tag binder body]] [tag binder (desugar-expr body)]) branches))))
        option-some-of
        (do (when-not (= 2 (count args)) (reject! "option-some-of requires type and payload" form))
            (list 'option-some-of (first args)
                  (desugar-expected-value
                   (when (generic-option-type? (first args)) (second (first args)))
                   (second args))))
        option-none-of
        (do (when-not (= 1 (count args)) (reject! "option-none-of requires one type" form))
            (list 'option-none-of (first args)))
        option-some?-of
        (do (when-not (= 2 (count args)) (reject! "option-some?-of requires type and value" form))
            (list 'option-some?-of (first args)
                  (desugar-expected-value (first args) (second args))))
        option-value-of
        (do (when-not (= 3 (count args)) (reject! "option-value-of requires type, value, and fallback" form))
            (list 'option-value-of (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (generic-option-type? (first args)) (second (first args)))
                   (nth args 2))))
        option-or
        (do (when-not (= 2 (count args))
              (reject! "option-or requires an option value and a fallback" form))
            ;; Keep this surface head until the type-directed rewrite pass.
            ;; The payload descriptor is intentionally absent from authored
            ;; source and cannot be recovered reliably during syntactic
            ;; desugaring for calls to functions returning [:option T].
            (list 'option-or (desugar-expr (first args))
                  (desugar-expr (second args))))
        ;; `match-option` lowers to this internal form. Nested matches cause
        ;; the enclosing match's recursive desugaring to visit that lowered
        ;; form again, so it must preserve the type descriptor and binder.
        ;; Falling through to generic call desugaring turns descriptor vectors
        ;; into runtime `vector-new` values and makes project linking
        ;; non-idempotent.
        option-match
        (do (when-not (= 5 (count args))
              (reject! "option-match requires type, value, none body, binder, and some body" form))
            (let [[type value none-body binder some-body] args]
              (when-not (symbol? binder)
                (reject! "option-match requires a symbol binder" form))
              (list 'option-match type (desugar-expected-value type value)
                    (desugar-expr none-body) binder (desugar-expr some-body))))
        match-option
        (do (when-not (= 4 (count args))
              (reject! "match-option requires value, type, none branch, and some branch" form))
            (let [[value type none-branch some-branch] args]
              (when-not (and (seq? none-branch) (= 2 (count none-branch))
                             (= 'none (first none-branch)))
                (reject! "match-option requires exactly one (none body) branch" form))
              (when-not (and (seq? some-branch) (= 3 (count some-branch))
                             (= 'some (first some-branch)) (symbol? (second some-branch)))
                (reject! "match-option requires exactly one (some binder body) branch" form))
              (list 'option-match type (desugar-expected-value type value)
                    (desugar-expr (second none-branch)) (second some-branch)
                    (desugar-expr (nth some-branch 2)))))
        hetero-vector
        (do (when (empty? args)
              (reject! "hetero-vector requires a type descriptor" form))
            (let [type (first args)
                  item-types (when (heterogeneous-vector-type? type) (second type))]
              (list* 'hetero-vector-new type
                     (if (= (count item-types) (count (rest args)))
                       (mapv (fn [item-type item]
                               (desugar-expected-value item-type item))
                             item-types (rest args))
                       (mapv desugar-expr (rest args))))))
        typed-list-new
        (do (when (empty? args)
              (reject! "typed-list-new requires a type descriptor" form))
            (let [type (first args)
                  item-type (when (canonical-list-type? type) (second type))]
              (list* 'typed-list-new type
                     (mapv #(if item-type
                              (desugar-expected-value item-type %)
                              (desugar-expr %))
                           (rest args)))))
        hetero-vector-new
        (do (when (empty? args)
              (reject! "hetero-vector-new requires a type descriptor" form))
            (let [type (first args)
                  item-types (when (heterogeneous-vector-type? type) (second type))]
              (list* 'hetero-vector-new type
                     (if (= (count item-types) (count (rest args)))
                       (mapv (fn [item-type item]
                               (desugar-expected-value item-type item))
                             item-types (rest args))
                       (mapv desugar-expr (rest args))))))
        hetero-vector-count
        (do (when-not (= 2 (count args))
              (reject! "hetero-vector-count requires type and value" form))
            (list 'hetero-vector-count (first args)
                  (desugar-expected-value (first args) (second args))))
        hetero-vector-at
        (do (when-not (= 3 (count args))
              (reject! "hetero-vector-at requires type, value, and literal index" form))
            (list 'hetero-vector-at (first args)
                  (desugar-expected-value (first args) (second args)) (nth args 2)))
        hetero-vector-assoc
        (do (when-not (= 4 (count args))
              (reject! "hetero-vector-assoc requires type, value, literal index, and item" form))
            (let [[type value index item] args
                  item-type (when (and (heterogeneous-vector-type? type)
                                       (integer? index)
                                       (<= 0 index)
                                       (< index (count (second type))))
                              (nth (second type) index))]
              (list 'hetero-vector-assoc type
                    (desugar-expected-value type value)
                    index
                    (if item-type
                      (desugar-expected-value item-type item)
                      (desugar-expr item)))))
        hetero-vector-equal
        (do (when-not (= 3 (count args))
              (reject! "hetero-vector-equal requires type and two values" form))
            (list 'hetero-vector-equal (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value (first args) (nth args 2))))
        typed-set
        (do (when (empty? args)
              (reject! "typed-set requires a type descriptor" form))
            (let [type (first args)
                  item-type (when (typed-set-type? type) (second type))]
              (list* 'typed-set-new type
                     (mapv #(if item-type
                              (desugar-expected-value item-type %)
                              (desugar-expr %))
                           (rest args)))))
        typed-set-new
        (do (when (empty? args)
              (reject! "typed-set-new requires a type descriptor" form))
            (let [type (first args)
                  item-type (when (typed-set-type? type) (second type))]
              (list* 'typed-set-new type
                     (mapv #(if item-type
                              (desugar-expected-value item-type %)
                              (desugar-expr %))
                           (rest args)))))
        typed-list-nth
        (do (when-not (= 3 (count args))
              (reject! "typed-list-nth requires type, value, and index" form))
            (list 'typed-list-nth (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expr (nth args 2))))
        ;; The run-time-length constructor: `typed-list-new` takes its items as
        ;; literal operands, so a list whose length is only known while the
        ;; program runs (a parsed s-expression's children) could not be built.
        typed-list-conj
        (do (when-not (= 3 (count args))
              (reject! "typed-list-conj requires type, value, and item" form))
            (list 'typed-list-conj (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-list-type? (first args)) (second (first args)))
                   (nth args 2))))
        typed-set-count
        (do (when-not (= 2 (count args))
              (reject! "typed-set-count requires type and value" form))
            (list 'typed-set-count (first args)
                  (desugar-expected-value (first args) (second args))))
        typed-set-contains
        (do (when-not (= 3 (count args))
              (reject! "typed-set-contains requires type, value, and item" form))
            (list 'typed-set-contains (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (typed-set-type? (first args)) (second (first args)))
                   (nth args 2))))
        typed-set-conj
        (do (when-not (= 3 (count args))
              (reject! "typed-set-conj requires type, value, and item" form))
            (list 'typed-set-conj (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (typed-set-type? (first args)) (second (first args)))
                   (nth args 2))))
        typed-set-disj
        (do (when-not (= 3 (count args))
              (reject! "typed-set-disj requires type, value, and item" form))
            (list 'typed-set-disj (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (typed-set-type? (first args)) (second (first args)))
                   (nth args 2))))
        typed-set-equal
        (do (when-not (= 3 (count args))
              (reject! "typed-set-equal requires type and two values" form))
            (list 'typed-set-equal (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value (first args) (nth args 2))))
        typed-set-nth
        (do (when-not (= 3 (count args))
              (reject! "typed-set-nth requires type, value, and index" form))
            (list 'typed-set-nth (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expr (nth args 2))))
        typed-map-new
        (do (when-not (and (seq args) (odd? (count args)))
              (reject! "typed-map-new requires type and key/value pairs" form))
            (let [type (first args)
                  [key-type value-type] (when (canonical-typed-map-type? type)
                                          (rest type))]
              (list* 'typed-map-new type
                     (into []
                           (mapcat (fn [[key item]]
                                     [(if key-type
                                        (desugar-expected-value key-type key)
                                        (desugar-expr key))
                                      (if value-type
                                        (desugar-expected-value value-type item)
                                        (desugar-expr item))]))
                           (partition 2 (rest args))))))
        typed-map-count
        (do (when-not (= 2 (count args))
              (reject! "typed-map-count requires type and value" form))
            (list 'typed-map-count (first args)
                  (desugar-expected-value (first args) (second args))))
        typed-map-contains
        (do (when-not (= 3 (count args))
              (reject! "typed-map-contains requires type, value, and key" form))
            (list 'typed-map-contains (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (second (first args)))
                   (nth args 2))))
        typed-map-get
        (do (when-not (= 3 (count args))
              (reject! "typed-map-get requires type, value, and key" form))
            (list 'typed-map-get (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (second (first args)))
                   (nth args 2))))
        typed-map-entry-at
        (do (when-not (= 3 (count args))
              (reject! "typed-map-entry-at requires type, value, and index" form))
            (list 'typed-map-entry-at (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expr (nth args 2))))
        (typed-map-keys typed-map-vals)
        (do (when-not (= 2 (count args))
              (reject! (str op " requires type and value") form))
            (list op (first args)
                  (desugar-expected-value (first args) (second args))))
        typed-map-assoc
        (do (when-not (= 4 (count args))
              (reject! "typed-map-assoc requires type, value, key, and item" form))
            (list 'typed-map-assoc (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (second (first args)))
                   (nth args 2))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (nth (first args) 2))
                   (nth args 3))))
        typed-map-dissoc
        (do (when-not (= 3 (count args))
              (reject! "typed-map-dissoc requires type, value, and key" form))
            (list 'typed-map-dissoc (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (second (first args)))
                   (nth args 2))))
        typed-map-equal
        (do (when-not (= 3 (count args))
              (reject! "typed-map-equal requires type and two values" form))
            (list 'typed-map-equal (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value (first args) (nth args 2))))
        record
        (do (when (empty? args)
              (reject! "record requires a type descriptor" form))
            (let [type (canonical-closure-result-type (first args))
                  field-types (when (record-type? type) (mapv second (nth type 2)))]
              (list* 'record-new type
                     (map-indexed (fn [index value]
                                    (desugar-expected-value
                                     (nth field-types index nil) value))
                                  (rest args)))))
        record-new
        (do (when (empty? args)
              (reject! "record-new requires a type descriptor" form))
            (let [type (canonical-closure-result-type (first args))
                  field-types (when (record-type? type) (mapv second (nth type 2)))]
              (list* 'record-new type
                     (map-indexed (fn [index value]
                                    (desugar-expected-value
                                     (nth field-types index nil) value))
                                  (rest args)))))
        record-get
        (do (when-not (contains? #{2 3} (count args))
              (reject! "record-get requires (value field) or (type value field)" form))
            ;; 2-arity is the projection sugar: the schema is recovered from the
            ;; value's inferred type by rewrite-record-projections, which runs
            ;; after desugar and before validation. Lowering only ever sees the
            ;; canonical 3-arity form.
            (if (= 2 (count args))
              (list 'record-get (desugar-expr (first args)) (second args))
              (let [type (canonical-closure-result-type (first args))]
                (list 'record-get type
                      (desugar-expected-value type (second args)) (nth args 2)))))
        record-assoc
        (do (when-not (= 4 (count args))
              (reject! "record-assoc requires type, value, literal field, and replacement" form))
            (let [type (canonical-closure-result-type (first args))
                  field-type (when (record-type? type)
                               (first-truthy (fn [[field field-type]]
                                       (when (= field (nth args 2)) field-type))
                                     (nth type 2)))]
