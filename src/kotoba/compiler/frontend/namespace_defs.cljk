(ns kotoba.compiler.frontend.namespace-defs
  "Module `namespace-defs` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (95 forms, 1144 lines). Depends on: base, kernel-region, closure-types, expand."
  (:require [kotoba.lang.coll :as set]
            [kotoba.lang.text :as str]
            [kotoba.compiler.frontend-tables :as tables]
            [kotoba.kir :as kir]
            #?@(:kotoba [[kotoba.form :as form]])
            #?@(:cljs [[kotoba.kir.cljs-i64 :as i64]])
            [kotoba.compiler.frontend.base :refer [first-truthy form-span reject!]]
            [kotoba.compiler.frontend.kernel-region :refer [traceable-base? #?@(:kotoba [] :default [kernel-memory-operations])]]
            [kotoba.compiler.frontend.closure-types :refer [slice-element-type slice-element-widths slice-type? #?@(:kotoba [fe-error])]]
            [kotoba.compiler.frontend.expand :refer [kotoba-integer? max-parameters max-symbol-chars valid-name?]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]})))

;; forward references inside this module (the cut keeps the original form order)
(declare namespace-attr-map->clauses)


#?(:kotoba nil :default
(defn load-catalog-forbidden
  "P0: merge catalog forbidden-heads when guest-grammar.edn is on classpath."
  []
  #?(:clj
     (try
       (let [c (or (clojure.java.io/resource "kotoba/lang/guest-grammar.edn")
                   (clojure.java.io/resource "lang/guest-grammar.edn"))]
         (if c
           (with-open [r (clojure.java.io/reader c)]
             (let [edn (clojure.edn/read (java.io.PushbackReader. r))
                   heads (:forbidden-heads edn #{})]
               (into #{} (map (fn [x] (if (symbol? x) x (symbol (name x))))) heads)))
           #{}))
       (catch Exception _ #{}))
     ;; ClojureScript cannot read the resource, so it answers the embedded copy
     ;; the Kotoba route uses (frontend-tables, compared with the resource by
     ;; test): the same forbidden set on every runtime, `binding` included.
     :cljs tables/forbidden-heads)))

#?(:kotoba nil :default
(defn load-grammar-declared-heads
  "Every head the language grammar names, when `guest-grammar.edn` is on the
  classpath: `:admitted-builtins`, the `:sugar` keys, `:arithmetic`,
  `:comparisons`, `:predicates` and the float `:arithmetic`. A set of symbols.

  Read for one diagnostic only -- telling a head the grammar declares and this
  analyser has not lowered (`(min 1 2)`) apart from a misspelling
  (`(frobnicate 1)`). Nothing is admitted from it. Same runtime shape as
  `load-catalog-forbidden`: ClojureScript cannot read a classpath resource
  synchronously, so it answers the empty set there and such a head is reported
  as unknown, which is what that runtime can honestly say."
  []
  #?(:clj
     (try
       (let [c (or (clojure.java.io/resource "kotoba/lang/guest-grammar.edn")
                   (clojure.java.io/resource "lang/guest-grammar.edn"))]
         (if c
           (with-open [r (clojure.java.io/reader c)]
             (let [edn (clojure.edn/read (java.io.PushbackReader. r))]
               (into #{}
                     (comp cat (map #(symbol (name %))))
                     [(:admitted-builtins edn) (keys (:sugar edn))
                      (:arithmetic edn) (:comparisons edn) (:predicates edn)
                      (get-in edn [:floating-point :arithmetic])])))
           #{}))
       (catch Exception _ #{}))
     :cljs #{})))

;; Kotoba: an exported constant is a function, and the vendored grammar is not
;; on a Kotoba module's classpath, so the value the JVM reads from it is the
;; embedded copy in `frontend-tables` (compared with the resource by a test).
#?(:kotoba
   (defn grammar-declared-heads [] [:ref :form/r]
     (tables/grammar-declared-heads))
   :default
   (def grammar-declared-heads
     "See `load-grammar-declared-heads`. Empty on ClojureScript."
     (load-grammar-declared-heads)))

#?(:kotoba
   (defn forbidden-heads [] [:ref :form/r]
     (tables/forbidden-heads))
   :default
(def forbidden-heads
  ;; `atom` left this set on 2026-09-02: local-state slice 1 (kotoba-lang
  ;; `lang/local-state.edn`) admits a non-escaping, function-local atom by
  ;; ELABORATION -- it becomes ordinary let rebindings, so no cell exists at
  ;; runtime and no ambient state is created. `swap!` / `reset!` were never in
  ;; this literal set; they were forbidden through the vendored guest grammar,
  ;; which drops them for the same reason. `ref` / `dosync` / `volatile!` /
  ;; `set!` / `binding` / `var` / `alter-var-root` stay refused: they have no
  ;; ability model decided and no widening path.
  (into '#{load load-file load-string read-string compile
           require use import ns-resolve resolve alter-var-root
           future pmap agent send send-off new . .. set! defmacro
           locking dosync ref volatile!}
        (load-catalog-forbidden))))

